---
import Navbar from '@components/Navbar.astro'
import Banner from '@components/Banner.astro'
import Sidebar from '@components/Sidebar.astro'
import MusicPlayer from '@components/MusicPlayer.astro'
import { ClientRouter } from 'astro:transitions'
import { getActiveTheme, getMusicTracks, getPublicSettings } from '../lib/api'
import '../styles/global.scss'

interface Props {
  title: string
  subtitle?: string
  showSidebar?: boolean
  showBanner?: boolean
  wide?: boolean
  hideFooter?: boolean
  image?: string
  pageType?: 'website' | 'article'
  publishedTime?: string | null
  sidebarProps?: Record<string, unknown>
}

const {
  title,
  subtitle = '',
  showSidebar = true,
  showBanner = true,
  wide = false,
  hideFooter = false,
  image = '',
  pageType = 'website',
  publishedTime = null,
  sidebarProps = {},
} = Astro.props

const [publicSettings, publicMusicTracks, activeTheme] = await Promise.all([getPublicSettings(), getMusicTracks(), getActiveTheme()])
const themeConfig = activeTheme?.config || {}
const safePrimary = String(themeConfig.primary || '#2f6f4e').replace(/[^#a-zA-Z0-9(),.%\s-]/g, '')
const safePrimaryHover = String(themeConfig.primary_hover || themeConfig.primary || '#245a3e').replace(/[^#a-zA-Z0-9(),.%\s-]/g, '')
const themeCss = `:root{--theme-primary:${safePrimary};--brand:${safePrimary};--theme-primary-hover:${safePrimaryHover};--theme-card-radius:${Number(themeConfig.card_radius || 18)}px;--theme-card-opacity:${Number(themeConfig.card_opacity || 0.86)};--theme-content-width:${Number(themeConfig.content_width || 72)}rem;--theme-body-font:${String(themeConfig.body_font || 'system-ui').replace(/[{};]/g, '')};--theme-title-font:${String(themeConfig.title_font || 'Georgia, serif').replace(/[{};]/g, '')};}`
const apiBase = import.meta.env.PUBLIC_API_BASE || '/api'
const bannerImages = Array.isArray(publicSettings.banner_images)
  ? publicSettings.banner_images
  : typeof publicSettings.banner_images === 'string'
    ? publicSettings.banner_images.split(/\r?\n|,/).map((item) => item.trim()).filter(Boolean)
    : []

const siteTitle = publicSettings.site_title || '个人博客'
const pageDescription = subtitle || publicSettings.site_description || siteTitle
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href
const fallbackImage = bannerImages[0] || publicSettings.profile_avatar || '/home.webp'
const shareImage = new URL(image || fallbackImage, Astro.url.origin).href
const musicPlaylist = publicMusicTracks.length ? publicMusicTracks : publicSettings.music_playlist || []
const mergedSidebarProps = {
  ...sidebarProps,
  profileName: publicSettings.profile_name || siteTitle,
  profileAvatar: publicSettings.profile_avatar || '/profile.webp',
  profileBio: publicSettings.profile_bio || publicSettings.site_description || '记录技术、生活和灵感的个人空间。',
}
---

<!doctype html>
<html lang="zh-CN" data-theme="boke-green" data-theme-type="light" data-personal-season={themeConfig.season || 'custom'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f2ea" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={`${siteTitle} JSON Feed`} href="/feed.json" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />
    <title>{title} - {siteTitle}</title>
    <ClientRouter />
    <style set:html={themeCss}></style>
    <script is:inline define:vars={{ apiBase }}>
      const themeTypes = { 'boke-night': 'dark', 'boke-punk': 'dark', 'boke-green': 'light' };
      const storedTheme = localStorage.getItem('theme') || 'boke-green';
      document.documentElement.setAttribute('data-theme', storedTheme);
      document.documentElement.setAttribute('data-theme-type', themeTypes[storedTheme] || 'light');
      window.__PUBLIC_API_BASE__ = apiBase;
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--banner-wave-bg)]">
    <div class="site-bg-grid"></div>
    <Navbar immersive={showBanner} />
    {showBanner && <Banner title={title} subtitle={subtitle} images={bannerImages} />}

    <div class:list={['page-content-animate mx-auto w-full flex-grow', pageType === 'article' && 'article-page-content', wide ? 'max-w-wide' : 'max-w-blog', showBanner ? 'mt-7' : 'mt-24']}>
      <div class={`grid grid-cols-1 gap-4 px-4 pb-4 ${showSidebar ? 'lg:grid-cols-4' : ''}`}>
        <main class={`order-1 flex flex-col gap-4 ${showSidebar ? 'lg:order-2 lg:col-span-3' : ''}`}>
          <slot />
        </main>
        {showSidebar && (
          <aside class="order-2 hidden lg:order-1 lg:col-span-1 lg:block">
            <Sidebar {...mergedSidebarProps} />
          </aside>
        )}
      </div>
    </div>

    {!hideFooter && (
      <footer class="site-footer mx-auto w-full max-w-blog px-4 pb-10 pt-8">
        <div>
          <a href="/" class="site-footer-brand">{siteTitle}</a>
          <p>记录所想，分享所见。</p>
        </div>
        <div class="site-footer-meta">
          <a href="/rss.xml">RSS</a>
          <a href="/feed.json">JSON Feed</a>
          <span>© 2026</span>
          <span>已运行 <strong id="site-uptime">--</strong></span>
          <span>今日 <strong id="visitor-today">--</strong> · 累计 <strong id="visitor-total">--</strong></span>
        </div>
      </footer>
    )}
    <MusicPlayer tracks={musicPlaylist} />
    <script is:inline>
      const siteStart = new Date('2026-01-01T00:00:00+08:00').getTime();
      const uptimeEl = document.getElementById('site-uptime');
      function updateUptime() {
        if (!uptimeEl) return;
        const seconds = Math.max(0, Math.floor((Date.now() - siteStart) / 1000));
        const days = Math.floor(seconds / 86400);
        const hours = Math.floor((seconds % 86400) / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        uptimeEl.textContent = `${days} 天 ${hours} 时 ${minutes} 分`;
      }
      updateUptime();
      setInterval(updateUptime, 60000);
      fetch(`${window.__PUBLIC_API_BASE__ || '/api'}/visitors/count`, { cache: 'no-store' })
        .then((res) => res.json())
        .then((json) => {
          const todayEl = document.getElementById('visitor-today');
          const totalEl = document.getElementById('visitor-total');
          if (todayEl) todayEl.textContent = json.data?.today ?? '--';
          if (totalEl) totalEl.textContent = json.data?.total ?? '--';
        })
        .catch(() => {});
      if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}), { once: true });
      }
    </script>
  </body>
</html>
