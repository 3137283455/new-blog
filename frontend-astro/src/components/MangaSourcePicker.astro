---
interface Props {
  label?: string
}

const { label = '全部来源' } = Astro.props
---

<div class="manga-source-picker" data-manga-source-picker>
  <input type="hidden" data-manga-selected-source value="all" />
  <button class="manga-source-trigger" type="button" data-manga-source-open aria-haspopup="dialog">
    <span class="source-trigger-mark">◈</span>
    <span><small>漫画来源</small><strong data-manga-selected-source-label>{label}</strong></span>
    <b>⌄</b>
  </button>
  <dialog class="manga-source-dialog" data-manga-source-dialog>
    <div class="manga-source-dialog-panel">
      <header>
        <div><p>CONTENT SOURCES</p><h2>选择漫画来源</h2><span data-manga-source-summary>正在读取已启用来源…</span></div>
        <button class="manga-dialog-close" type="button" data-manga-source-close aria-label="关闭">×</button>
      </header>
      <label class="manga-source-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg><input type="search" data-manga-source-filter placeholder="搜索来源名称" autocomplete="off" /></label>
      <div class="manga-source-list" data-manga-source-list></div>
      <footer><span>来源由 Venera 兼容源仓库提供</span><a href="/admin#search-sources">管理来源 ↗</a></footer>
    </div>
  </dialog>
</div>

<style>
  .manga-source-picker{min-width:0}.manga-source-trigger{display:flex;min-width:9.7rem;align-items:center;gap:.55rem;border:1px solid var(--manga-line,#e5e8df);border-radius:.78rem;background:var(--manga-surface,#fff);padding:.42rem .62rem;color:var(--manga-ink,#172018);text-align:left;cursor:pointer}.manga-source-trigger:hover{border-color:var(--manga-brand,#2f6f4e)}.source-trigger-mark{display:grid;width:1.75rem;height:1.75rem;place-items:center;border-radius:.55rem;background:var(--manga-soft,#f0f3e9);color:var(--manga-brand,#2f6f4e);font-size:.8rem}.manga-source-trigger span:nth-child(2){display:grid;min-width:0;gap:.1rem}.manga-source-trigger small{color:var(--manga-muted,#7a8279);font-size:.49rem}.manga-source-trigger strong{max-width:8.2rem;overflow:hidden;font-size:.64rem;text-overflow:ellipsis;white-space:nowrap}.manga-source-trigger>b{margin-left:auto;color:var(--manga-muted,#7a8279);font-size:.75rem}
  .manga-source-dialog{width:min(34rem,calc(100vw - 2rem));border:0;border-radius:1.15rem;background:transparent;padding:0;color:var(--manga-ink,#172018)}.manga-source-dialog::backdrop{background:#17201888;backdrop-filter:blur(5px)}.manga-source-dialog-panel{overflow:hidden;border:1px solid var(--manga-line,#e5e8df);border-radius:1.15rem;background:var(--manga-surface,#fff);box-shadow:0 28px 90px #17201835}.manga-source-dialog header{display:flex;align-items:start;justify-content:space-between;gap:1rem;padding:1.25rem 1.3rem .95rem;border-bottom:1px solid var(--manga-line,#e5e8df)}.manga-source-dialog header p{margin:0;color:var(--manga-brand,#2f6f4e);font:850 .54rem system-ui;letter-spacing:.16em}.manga-source-dialog h2{margin:.35rem 0 .2rem;font:700 1.45rem var(--theme-title-font,Georgia,serif)}.manga-source-dialog header span{color:var(--manga-muted,#7a8279);font-size:.6rem}.manga-dialog-close{border:0;background:transparent;color:var(--manga-muted,#7a8279);font-size:1.5rem;line-height:1;cursor:pointer}.manga-source-search{display:flex;align-items:center;gap:.55rem;margin:1rem 1.3rem .7rem;border:1px solid var(--manga-line,#e5e8df);border-radius:.7rem;padding:0 .7rem}.manga-source-search svg{width:.9rem;fill:none;stroke:var(--manga-muted,#7a8279);stroke-width:1.8}.manga-source-search input{width:100%;height:2.65rem;border:0;outline:0;background:transparent;color:inherit;font-size:.68rem}.manga-source-list{display:grid;max-height:min(23rem,55vh);gap:.25rem;overflow:auto;padding:0 1.3rem 1rem}.manga-source-item{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.65rem;border:1px solid transparent;border-radius:.7rem;background:transparent;padding:.65rem .55rem;color:inherit;text-align:left;cursor:pointer}.manga-source-item:hover,.manga-source-item.active{border-color:color-mix(in srgb,var(--manga-brand,#2f6f4e) 25%,transparent);background:var(--manga-soft,#f0f3e9)}.manga-source-item>i{display:grid;width:1.8rem;height:1.8rem;place-items:center;border-radius:.55rem;background:var(--manga-soft,#f0f3e9);color:var(--manga-brand,#2f6f4e);font-size:.65rem;font-style:normal;font-weight:900}.manga-source-item strong,.manga-source-item small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manga-source-item strong{font-size:.67rem}.manga-source-item small{margin-top:.12rem;color:var(--manga-muted,#7a8279);font-size:.53rem}.manga-source-item>b{color:var(--manga-brand,#2f6f4e);font-size:.75rem}.manga-source-empty{padding:1.5rem;color:var(--manga-muted,#7a8279);font-size:.65rem;text-align:center}.manga-source-dialog footer{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--manga-line,#e5e8df);padding:.85rem 1.3rem;color:var(--manga-muted,#7a8279);font-size:.55rem}.manga-source-dialog footer a{color:var(--manga-brand,#2f6f4e);font-weight:850;text-decoration:none}@media(max-width:500px){.manga-source-trigger{min-width:0}.manga-source-trigger strong{max-width:6.5rem}.manga-source-dialog{width:calc(100vw - 1rem)}}
</style>
