---
import MangaSiteHeader from './MangaSiteHeader.astro'
import MangaSourcePicker from './MangaSourcePicker.astro'

interface Props {
  mode: 'search' | 'latest'
  query?: string
  source?: string
}

const { mode, query = '', source = 'all' } = Astro.props
const isSearch = mode === 'search'
---

<main class="manga-browse" data-manga-experience data-mode={mode} data-query={query} data-source={source}>
  <MangaSiteHeader active={isSearch ? 'discover' : 'latest'} />

  <section class="manga-browse-head">
    <div>
      <p class="manga-eyebrow">{isSearch ? 'SEARCH THE SOURCES' : 'LATEST FROM THE SOURCES'}</p>
      <h1 data-search-title>{isSearch ? '搜索漫画' : '最新发现'}</h1>
      <p>{isSearch ? '从已启用的 Venera 兼容来源中检索作品，选择一个来源可以获得更准确的结果。' : '选择一个支持发现页的来源，浏览它最近公开的作品。'}</p>
    </div>
    <div class="browse-head-actions"><MangaSourcePicker /><a class="browse-secondary" href={isSearch ? '/manga/latest' : '/manga/search'}>{isSearch ? '去看最新 →' : '搜索作品 →'}</a></div>
  </section>

  {isSearch && <form class="manga-browse-search" data-manga-search-form>
    <label><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg><input data-manga-query type="search" value={query} placeholder="输入漫画名、作者或关键词" autocomplete="off" /><kbd>Enter</kbd></label>
    <button type="submit">搜索 <span>→</span></button>
  </form>}

  <section class="manga-browse-results">
    <header class="browse-results-head"><div><p class="manga-eyebrow">{isSearch ? 'RESULTS' : 'SOURCE FEED'}</p><h2>{isSearch ? '搜索结果' : '源站作品'}</h2></div><span data-manga-state>正在准备漫画源…</span></header>
    <div class="manga-result-grid" data-manga-results data-manga-explore><div class="manga-result-empty"><strong>{isSearch ? '输入关键词开始搜索' : '正在读取漫画源'}</strong><span>{isSearch ? '结果会在这里展示。' : '首次打开会从选中的来源获取内容。'}</span></div></div>
  </section>
</main>

<style>
  .manga-browse{--manga-ink:#172018;--manga-brand:#2f6f4e;--manga-muted:#7a8279;--manga-line:#e4e8df;--manga-soft:#f0f3e9;--manga-surface:#fff;width:min(1240px,100%);margin:0 auto;padding:0 1rem 5rem;color:var(--manga-ink)}.manga-browse [hidden]{display:none!important}.manga-eyebrow{margin:0;color:var(--manga-brand);font:850 .57rem/1.2 system-ui,sans-serif;letter-spacing:.16em}.manga-browse-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin:2rem 0 1.2rem}.manga-browse-head h1{margin:.55rem 0 .65rem;font:650 clamp(2.5rem,5vw,4.8rem)/.96 var(--theme-title-font,Georgia,serif);letter-spacing:-.055em}.manga-browse-head p:not(.manga-eyebrow){max-width:36rem;margin:0;color:var(--manga-muted);font-size:.72rem;line-height:1.8}.browse-head-actions{display:flex;align-items:center;gap:.5rem}.browse-secondary{border:1px solid var(--manga-line);border-radius:999px;padding:.62rem .78rem;color:var(--manga-ink);font-size:.6rem;font-weight:850;text-decoration:none;white-space:nowrap}.manga-browse-search{display:flex;align-items:center;gap:.5rem;margin-bottom:2.15rem;border:1px solid var(--manga-line);border-radius:.85rem;background:var(--manga-surface);padding:.35rem;box-shadow:0 10px 28px #1720180b}.manga-browse-search label{display:flex;min-width:0;flex:1;align-items:center;gap:.55rem;padding:0 .65rem}.manga-browse-search label svg{width:.95rem;fill:none;stroke:var(--manga-muted);stroke-width:1.8}.manga-browse-search input{width:100%;height:2.75rem;border:0;outline:0;background:transparent;color:var(--manga-ink);font-size:.7rem}.manga-browse-search kbd{border:1px solid var(--manga-line);border-radius:.3rem;padding:.18rem .35rem;color:var(--manga-muted);font-size:.5rem}.manga-browse-search>button{height:2.75rem;border:0;border-radius:.63rem;background:var(--manga-ink);padding:0 1rem;color:#f4ffd9;font-size:.64rem;font-weight:900}.manga-browse-search>button span{margin-left:.3rem;color:#d8ff55}.manga-browse-results{margin-top:1rem}.browse-results-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem;border-bottom:1px solid var(--manga-line);padding-bottom:.85rem}.browse-results-head h2{margin:.35rem 0 0;font:650 1.85rem var(--theme-title-font)}.browse-results-head>span{color:var(--manga-muted);font-size:.58rem}.manga-result-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1.35rem .8rem}.manga-result-card{min-width:0}.manga-result-cover{position:relative;display:block;aspect-ratio:2/3;overflow:hidden;border:1px solid var(--manga-line);border-radius:.78rem;background:linear-gradient(145deg,#e8eedf,#fff);color:var(--manga-ink);box-shadow:0 12px 25px #17201812;transition:transform .18s,box-shadow .18s}.manga-result-cover:hover{transform:translateY(-4px);box-shadow:0 18px 34px #17201824}.manga-result-cover img{width:100%;height:100%;object-fit:cover}.manga-result-cover>span{display:grid;width:100%;height:100%;place-items:center;font:650 2.7rem var(--theme-title-font)}.manga-result-cover i{position:absolute;top:.45rem;left:.45rem;max-width:calc(100% - .9rem);overflow:hidden;border-radius:999px;background:#172018d9;color:#fff;padding:.25rem .4rem;font-size:.47rem;font-style:normal;text-overflow:ellipsis;white-space:nowrap}.manga-result-cover b{position:absolute;right:.45rem;bottom:.45rem;border-radius:999px;background:#d8ff55;padding:.25rem .4rem;color:#172018;font-size:.49rem}.manga-result-card>div{padding:.58rem .1rem}.manga-result-card small,.manga-result-card h3,.manga-result-card p{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manga-result-card small{color:var(--manga-brand);font-size:.52rem;font-weight:850}.manga-result-card h3{margin:.25rem 0;font-size:.76rem}.manga-result-card h3 a{color:inherit;text-decoration:none}.manga-result-card p{margin:0;color:var(--manga-muted);font-size:.54rem}.manga-result-empty{grid-column:1/-1;display:grid;min-height:17rem;place-content:center;gap:.35rem;border:1px dashed var(--manga-line);border-radius:1rem;text-align:center}.manga-result-empty strong{font:650 1.15rem var(--theme-title-font)}.manga-result-empty span{color:var(--manga-muted);font-size:.62rem}@media(max-width:1000px){.manga-result-grid{grid-template-columns:repeat(5,minmax(0,1fr))}}@media(max-width:760px){.manga-browse{padding:0 .65rem 3rem}.manga-browse-head{align-items:start;flex-direction:column;gap:1rem;margin:1.3rem 0 1rem}.manga-browse-head h1{font-size:3rem}.browse-head-actions{width:100%}.browse-head-actions .manga-source-picker{flex:1}.browse-secondary{margin-left:auto}.manga-browse-search{margin-bottom:1.5rem}.browse-results-head{align-items:start;flex-direction:column}.manga-result-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem .6rem}}@media(max-width:440px){.manga-result-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<script>
  import '../scripts/manga-experience.js'
</script>
