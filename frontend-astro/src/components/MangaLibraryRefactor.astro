r(--theme-title-font)}.manga-tile-cover>b{position:absolute;z-index:3;top:.5rem;left:.5rem;border:1px solid #fff3;border-radius:999px;background:#172019d9;color:#fff;padding:.28rem .43rem;font-size:.53rem;backdrop-filter:blur(8px)}.cover-glow{position:absolute;z-index:2;inset:auto 0 0;height:45%;background:linear-gradient(transparent,#10171072);pointer-events:none}.manga-tile-copy{padding:.62rem .1rem 0}.manga-tile-copy>small{display:block;overflow:hidden;color:var(--brand);font-size:.57rem;font-weight:850;text-overflow:ellipsis;white-space:nowrap}.manga-tile-copy h3{margin:.24rem 0 .2rem;font-size:.9rem;line-height:1.3}.manga-tile-copy h3 a{color:inherit}.manga-tile-copy>p{display:-webkit-box;overflow:hidden;color:var(--muted-ink);font-size:.6rem;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}.manga-tile-copy footer{display:flex;justify-content:space-between;gap:.4rem;margin-top:.45rem;color:var(--muted-ink);font-size:.56rem}.manga-tile-copy footer span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manga-tile-copy footer a{flex:none;color:var(--ink);font-weight:850}.manga-card-progress{height:1rem;margin-top:.45rem;background:linear-gradient(color-mix(in srgb,var(--ink) 9%,transparent),color-mix(in srgb,var(--ink) 9%,transparent)) top/100% .22rem no-repeat}.manga-card-progress i{display:block;width:0;height:.22rem;border-radius:999px;background:var(--brand)}.manga-card-progress span{display:block;margin-top:.2rem;color:var(--muted-ink);font-size:.53rem}.manga-shelf[data-view=list]{grid-template-columns:1fr;gap:.55rem}.manga-shelf[data-view=list] .manga-tile{display:grid;grid-template-columns:4.25rem minmax(0,1fr);gap:.85rem;border:1px solid var(--line);border-radius:.8rem;background:color-mix(in srgb,var(--surface-solid) 82%,transparent);padding:.55rem}.manga-shelf[data-view=list] .manga-tile-cover{height:6.1rem;border-radius:.45rem}.manga-shelf[data-view=list] .manga-tile-cover>b,.manga-shelf[data-view=list] .cover-index{display:none}.manga-shelf[data-view=list] .manga-tile-copy{display:flex;flex-direction:column;padding:.25rem 0}.manga-shelf[data-view=list] .manga-tile-copy h3{font-size:1rem}.manga-shelf[data-view=list] .manga-tile-copy>p{-webkit-line-clamp:1}.manga-shelf[data-view=list] .manga-tile-copy footer{margin-top:auto}.manga-empty{display:grid;min-height:13rem;place-content:center;gap:.3rem;border:1px dashed var(--line);border-radius:.9rem;color:var(--muted-ink);text-align:center}.manga-empty strong{color:var(--ink);font:650 1.2rem var(--theme-title-font)}.manga-empty span{font-size:.68rem}.manga-empty a{margin-top:.25rem;color:var(--brand);font-size:.68rem;font-weight:850}.manga-rail{display:grid;gap:.8rem}.rail-card{border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*.9);background:color-mix(in srgb,var(--surface-solid) 78%,transparent);padding:1rem}.rail-card header{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:.7rem;border-bottom:1px solid var(--line)}.rail-card header>span{color:var(--muted-ink);font-size:.56rem}.mix-meter{height:.45rem;margin:1.1rem 0 .55rem;overflow:hidden;border-radius:999px;background:color-mix(in srgb,var(--ink) 9%,transparent)}.mix-meter i{display:block;width:var(--mix,0%);height:100%;border-radius:inherit;background:var(--brand)}.mix-labels{display:flex;justify-content:space-between;gap:.3rem;color:var(--muted-ink);font-size:.54rem}.mix-labels b{color:var(--ink);font-size:.7rem}.status-list{display:grid}.status-list button{display:grid;grid-template-columns:.55rem 1fr auto .8rem;align-items:center;gap:.55rem;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);padding:.75rem 0;text-align:left}.status-list button:last-child{border-bottom:0;padding-bottom:.15rem}.status-list button:first-child{padding-top:.85rem}.status-list span{font-size:.65rem}.status-list strong{font-size:.75rem}.status-list b{color:var(--muted-ink);font-size:.7rem}.status-dot{width:.45rem;height:.45rem;border-radius:50%;background:var(--muted-ink)}.status-dot.is-reading{background:#79a67d}.status-dot.is-planned{background:#d5a45b}.status-dot.is-finished{background:#6f9ac2}.rail-link{display:flex;flex-direction:column;gap:.25rem;border-bottom:1px solid var(--line);padding:.55rem .1rem;color:var(--ink)}.rail-link span{font-size:.72rem;font-weight:850}.rail-link small{color:var(--muted-ink);font-size:.59rem}@media(max-width:960px){.manga-library-layout{grid-template-columns:1fr}.manga-rail{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.rail-link{grid-column:1/-1}}@media(max-width:700px){.manga-collection-page{padding:.7rem .65rem 3rem}.manga-intro{align-items:start;flex-direction:column;gap:1rem;padding:.15rem 0 1.1rem}.manga-intro h1{font-size:3.1rem}.intro-description{font-size:.7rem}.manga-stats{width:100%;border:1px solid var(--line);border-radius:.75rem;background:color-mix(in srgb,var(--surface-solid) 75%,transparent)}.manga-stats div{min-width:0;flex:1;padding:.55rem .3rem}.manga-stats strong{font-size:1.05rem}.manga-continue{grid-template-columns:4.2rem minmax(0,1fr);gap:.75rem;padding:.8rem}.manga-continue-cover{width:4.2rem}.manga-continue-copy{padding-right:0}.manga-continue-copy h2{font-size:1.05rem}.manga-continue-copy>span{font-size:.63rem}.continue-mark{top:.8rem;right:.8rem}.continue-mark span{display:none}.continue-link{grid-column:1/-1;justify-content:space-between;margin:0;border-top:1px solid var(--line);padding-top:.65rem}.continue-link span{width:1.8rem;height:1.8rem}.manga-collection-card{padding:.85rem;border-radius:1rem}.collection-head h2{font-size:1.45rem}.toolbar-controls{display:grid;grid-template-columns:minmax(0,1fr) auto}.manga-search{grid-column:1/-1;grid-row:1}.toolbar-controls select:first-of-type{grid-column:1;grid-row:2;min-width:0}.toolbar-controls select:nth-of-type(2){display:none}.random-manga{display:none}.view-switch{grid-column:2;grid-row:2}.collection-meta small{display:none}.manga-shelf{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem .65rem}.manga-tile-copy h3{font-size:.84rem}.manga-tile-copy footer{font-size:.54rem}.manga-rail{grid-template-columns:1fr}.manga-rail .rail-card:first-child{display:none}}@media(max-width:370px){.manga-shelf{gap:.85rem .5rem}.manga-tile-copy footer a{font-size:0}.manga-tile-copy footer a::after{content:'→';font-size:.62rem}}
</style>

<script>
  // @ts-nocheck
  import { ensurePrivateDeviceToken } from '../lib/private-device'

  function initMangaLibraryRefactor() {
    const root = document.querySelector('[data-manga-library-refactor]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    const shelf = root.querySelector('[data-manga-shelf]')
    const cards = [...root.querySelectorAll('[data-manga-card]')]
    const search = root.querySelector('[data-manga-search]')
    const status = root.querySelector('[data-manga-status]')
    const sort = root.querySelector('[data-manga-sort]')
    const count = root.querySelector('[data-manga-count]')
    const empty = root.querySelector('[data-manga-empty]')
    const filterSummary = root.querySelector('[data-manga-filter-summary]')
    let type = 'all'
    const typeLabel = { all: '全部漫画', local: '本地漫画', network: '网络收藏' }
    const apply = () => {
      const query = String(search?.value || '').trim().toLocaleLowerCase()
      const wantedStatus = status?.value || 'all'
      const visible = cards.filter((card) => {
        const matchesType = type === 'all' || card.dataset.type === type
        const matchesStatus = wantedStatus === 'all' || card.dataset.status === wantedStatus
        const matchesQuery = !query || card.dataset.search.includes(query)
        card.hidden = !(matchesType && matchesStatus && matchesQuery)
        return !card.hidden
      })
      const mode = sort?.value || 'updated'
      visible.sort((a, b) => mode === 'title' ? (a.dataset.title || '').localeCompare(b.dataset.title || '', 'zh-CN') : mode === 'chapters' ? Number(b.dataset.chapters) - Number(a.dataset.chapters) : (b.dataset.updated || '').localeCompare(a.dataset.updated || ''))
      visible.forEach((card) => shelf.append(card))
      if (count) count.textContent = `${visible.length} 部`
      if (filterSummary) filterSummary.textContent = wantedStatus === 'all' ? typeLabel[type] : `${typeLabel[type]} · ${status.options[status.selectedIndex].textContent}`
      if (empty) { empty.hidden = visible.length > 0 || cards.length === 0; empty.querySelector('[data-manga-empty-copy]').textContent = query ? '没有匹配当前筛选条件的漫画。' : type === 'local' ? '从后台导入 CBZ、ZIP 或图片型 EPUB。' : type === 'network' ? '从后台添加一个网络漫画阅读源。' : '换一个状态或关键词试试。' }
      root.querySelectorAll('[data-manga-type]').forEach((button) => button.classList.toggle('is-active', button.dataset.mangaType === type))
    }
    root.querySelectorAll('[data-manga-type]').forEach((button) => button.addEventListener('click', () => { type = button.dataset.mangaType; apply() }))
    root.querySelectorAll('[data-manga-status-filter]').forEach((button) => button.addEventListener('click', () => { status.value = button.dataset.mangaStatusFilter; apply() }))
    search?.addEventListener('input', apply); status?.addEventListener('change', apply); sort?.addEventListener('change', apply)
