a-continue-copy>p{margin:0;color:var(--brand);font:850 .6rem system-ui;letter-spacing:.14em}.manga-continue-copy h2{margin:.4rem 0 .15rem;font:650 1.5rem var(--theme-title-font)}.manga-continue-copy>span{display:block;overflow:hidden;color:var(--muted-ink);font-size:.7rem;text-overflow:ellipsis;white-space:nowrap}.manga-progress{height:.28rem;max-width:25rem;margin-top:.8rem;overflow:hidden;border-radius:999px;background:color-mix(in srgb,var(--ink) 10%,transparent)}.manga-progress i{display:block;width:0;height:100%;border-radius:inherit;background:var(--brand)}.manga-continue-copy small{display:block;margin-top:.32rem;color:var(--muted-ink);font-size:.57rem}.continue-link{display:flex;align-items:center;gap:.55rem;margin-top:1.6rem;color:var(--ink);font-size:.7rem;font-weight:850}.continue-link span{display:grid;width:2.25rem;height:2.25rem;place-items:center;border-radius:50%;background:var(--ink);color:var(--surface-solid);font-size:1rem}.manga-library-layout{display:grid;grid-template-columns:minmax(0,1fr) 230px;align-items:start;gap:1rem;margin-top:1.2rem}.manga-collection-card{min-width:0;border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*1.08);background:color-mix(in srgb,var(--surface-solid) 75%,transparent);padding:1.25rem}.collection-head{display:flex;align-items:end;justify-content:space-between;gap:1rem}.collection-head h2{margin:.32rem 0 0;font:650 1.8rem var(--theme-title-font)}.collection-head>span{color:var(--muted-ink);font-size:.62rem}.manga-toolbar{display:flex;flex-direction:column;gap:.75rem;margin-top:1.1rem}.filter-tabs{display:flex;gap:.2rem;overflow:auto;padding-bottom:.1rem}.filter-tabs button{flex:none;border:0;border-radius:999px;background:transparent;color:var(--muted-ink);padding:.5rem .68rem;font-size:.65rem;font-weight:800}.filter-tabs button span{margin-left:.25rem;opacity:.5}.filter-tabs button.is-active{background:var(--ink);color:var(--surface-solid)}.toolbar-controls{display:flex;gap:.45rem}.manga-sea