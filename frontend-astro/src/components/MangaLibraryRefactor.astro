---
import { resolveUploadUrl } from '../lib/media'

interface Props {
  manga: any[]
}

const { manga } = Astro.props
const local = manga.filter((item) => item.library_type === 'local')
const network = manga.filter((item) => item.library_type !== 'local')
const statusLabel = (status?: string) => ({ reading: '在读', finished: '读完', planned: '想读', paused: '暂放' }[status || 'reading'] || '在读')
const statusCounts = {
  all: manga.length,
  reading: manga.filter((item) => (item.status || 'reading') === 'reading').length,
  finished: manga.filter((item) => item.status === 'finished').length,
  planned: manga.filter((item) => item.status === 'planned').length,
  paused: manga.filter((item) => item.status === 'paused').length,
}
---

<section class="manga-collection-page" data-manga-library-refactor>
  <header class="manga-intro">
    <div><p class="eyebrow">COMIC LIBRARY <span>·</span> {manga.length ? 'PERSONAL COLLECTION' : 'READY TO BEGIN'}</p><h1>漫画书架</h1><p class="intro-description">本地作品和网络收藏放在同一个架子上，最近读过的章节永远近在手边。</p></div>
    <div class="manga-stats" aria-label="漫画统计"><div><strong>{manga.length}</strong><span>全部</span></div><div><strong>{local.length}</strong><span>本地库</span></div><div><strong>{network.length}</strong><span>网络收藏</span></div></div>
  </header>

  <section class="manga-continue" data-manga-continue hidden>
    <div class="continue-mark"><span>RECENTLY OPENED</span><i>↗</i></div><div class="manga-continue-cover"><img data-manga-continue-cover alt="" /></div>
    <div class="manga-continue-copy"><p>LAST OPENED</p><h2 data-manga-continue-title>继续阅读</h2><span data-manga-continue-chapter>从上次停下的地方继续</span><div class="manga-progress"><i data-manga-continue-bar></i></div><small data-manga-continue-progress></small></div>
    <a class="continue-link" data-manga-continue-link href="/manga">打开漫画 <span>→</span></a>
  </section>

  <div class="manga-library-layout">
    <section class="manga-collection-card">
      <header class="collection-head"><div><p class="eyebrow">MY COMICS</p><h2>我的漫画</h2></div><span data-manga-count>{manga.length} 部</span></header>
      <div class="manga-toolbar">
        <nav class="filter-tabs" aria-label="漫画库来源"><button class="is-active" type="button" data-manga-type="all">全部 <span>{statusCounts.all}</span></button><button type="button" data-manga-type="local">本地库 <span>{local.length}</span></button><button type="button" data-manga-type="network">网络收藏 <span>{network.length}</span></button></nav>
        <div class="toolbar-controls"><label class="manga-search"><span>⌕</span><input type="search" data-manga-search placeholder="搜索漫画、作者" autocomplete="off" /><kbd>/</kbd></label><select data-manga-status aria-label="漫画状态"><option value="all">全部状态</option><option value="reading">在读</option><option value="planned">想读</option><option value="finished">读完</option><option value="paused">暂放</option></select><select data-manga-sort aria-label="漫画排序"><option value="updated">最近整理</option><option value="title">标题</option><option value="chapters">章节数</option></select><button class="random-manga" type="button" data-manga-random>随机一本</button><div class="view-switch" aria-label="视图切换"><button type="button" data-manga-view="grid" aria-label="封面网格">▦</button><button type="button" data-manga-view="list" aria-label="列表视图">☷</button></div></div>
      </div>
      <div class="collection-meta"><span>本地漫画支持分卷目录，网络收藏保留阅读源</span><small data-manga-filter-summary>全部漫画</small></div>
      <div class="manga-shelf" data-manga-shelf>
        {manga.map((item) => {
          const isLocal = item.library_type === 'local'
          return <article class="manga-tile" data-manga-card data-id={item.id} data-type={isLocal ? 'local' : 'network'} data-status={item.status || 'reading'} data-title={(item.title || '').toLocaleLowerCase()} data-search={(item.title + ' ' + (item.original_title || '') + ' ' + (item.author || '')).toLocaleLowerCase()} data-updated={item.updated_at || ''} data-chapters={item.chapter_count || 0} data-progress="0">
            <a class="manga-tile-cover" href={`/manga/${item.slug}`}><span class="cover-index">{String(item.sort_order || 1).padStart(2, '0')}</span>{item.cover ? <img src={resolveUploadUrl(item.cover)} alt={`${item.title}封面`} loading="lazy" decoding="async" /> : <span class="cover-fallback">{item.title.slice(0, 1)}</span>}<b>{isLocal ? '本地库' : '网络收藏'}</b><i class="cover-glow"></i></a>
            <div class="manga-tile-copy"><small>{item.author || item.publication || (isLocal ? '本地作品' : '网络来源')}</small><h3><a href={`/manga/${item.slug}`}>{item.title}</a></h3><p>{item.description || (isLocal ? `${item.volume_count || 0} 卷 · ${item.chapter_count || 0} 章` : `${(item.read_sources || []).length} 个阅读源`)}</p><div class="manga-card-progress" data-manga-progress hidden><i></i><span></span></div><footer><span>{isLocal ? `${item.volume_count || 0} 卷 · ${item.chapter_count || 0} 章` : statusLabel(item.status)}</span><a data-manga-action href={`/manga/${item.slug}`}>{isLocal ? '查看目录 →' : '选择阅读源 →'}</a></footer></div>
          </article>
        })}
      </div>
      <div class="manga-empty" data-manga-empty hidden><strong>这里暂时没有漫画</strong><span data-manga-empty-copy>换个关键词试试。</span></div>
      {!manga.length && <div class="manga-empty is-empty"><strong>漫画书架还是空的</strong><span>前台搜索负责发现，已维护的本地或网络漫画会显示在这里。</span><a href="/manga/search">去搜索漫画 →</a></div>}
    </section>

    <aside class="manga-rail">
      <section class="rail-card"><header><p class="eyebrow">LIBRARY MIX</p><span>收藏构成</span></header><div class="mix-meter"><i style={`--mix:${manga.length ? Math.round(local.length / manga.length * 100) : 0}%`}></i></div><div class="mix-labels"><span><b>{local.length}</b> 本地漫画</span><span><b>{network.length}</b> 网络收藏</span></div></section>
      <section class="rail-card manga-status-card"><header><p class="eyebrow">READING STATUS</p><span>当前状态</span></header><div class="status-list"><button type="button" data-manga-status-filter="reading"><i class="status-dot is-reading"></i><span>正在阅读</span><strong>{statusCounts.reading}</strong><b>→</b></button><button type="button" data-manga-status-filter="planned"><i class="status-dot is-planned"></i><span>准备阅读</span><strong>{statusCounts.planned}</strong><b>→</b></button><button type="button" data-manga-status-filter="finished"><i class="status-dot is-finished"></i><span>已经读完</span><strong>{statusCounts.finished}</strong><b>→</b></button></div></section>
      <a class="rail-link" href="/reading"><span>阅读中心</span><small>查看小说与漫画记录 ↗</small></a>
    </aside>
  </div>
</section>

<style>
