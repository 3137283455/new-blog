---
import { resolveUploadUrl } from '../lib/media'

interface Props {
  title: string
  subtitle?: string
  images?: string[]
}

const { title, subtitle = '', images = [] } = Astro.props
const normalizedImages = images
  .flatMap((item) => String(item).split(/\r?\n|,/))
  .map((item) => item.trim())
  .filter(Boolean)
const bannerImages = (normalizedImages.length ? normalizedImages : ['/home.webp']).map(resolveUploadUrl)
const payload = JSON.stringify(bannerImages)
const dateLabel = new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', weekday: 'long' }).format(new Date())
---

<section class="editorial-hero" data-banner-images={payload}>
  <div class="banner-slides" aria-hidden="true">
    {bannerImages.map((src, index) => (
      <img
        class:list={['banner-slide', index === 0 && 'is-active']}
        src={index === 0 ? src : undefined}
        data-src={index > 0 ? src : undefined}
        loading={index === 0 ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : 'low'}
        decoding="async"
        alt=""
        data-fallback-src="/home.webp"
      />
    ))}
  </div>
  <div class="editorial-hero-shade"></div>
  <div class="editorial-hero-grain"></div>

  <div class="editorial-hero-content">
    <p class="editorial-eyebrow"><span></span>{dateLabel}</p>
    <h1>{title}</h1>
    {subtitle && <p class="editorial-deck">{subtitle}</p>}
    <div class="editorial-hero-actions">
      <a href="#latest">开始阅读 <span>↓</span></a>
      <a href="/nav" class="is-quiet">打开导航 <span>↗</span></a>
    </div>
  </div>

  <div class="editorial-hero-index" aria-hidden="true">
    <span>VOL.</span>
    <strong>{String(new Date().getMonth() + 1).padStart(2, '0')}</strong>
  </div>
</section>

<script>
  function initBannerCarousel() {
    document.querySelectorAll<HTMLElement>('[data-banner-images]').forEach((banner) => {
      if (banner.dataset.ready === 'true') return
      banner.dataset.ready = 'true'
      const slides = Array.from(banner.querySelectorAll<HTMLImageElement>('.banner-slide'))
      if (slides.length <= 1 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      let index = 0
      window.setInterval(() => {
        slides[index]?.classList.remove('is-active')
        index = (index + 1) % slides.length
        const nextSlide = slides[index]
        if (nextSlide?.dataset.src && !nextSlide.src) {
          nextSlide.src = nextSlide.dataset.src
          delete nextSlide.dataset.src
        }
        nextSlide?.classList.add('is-active')
      }, 6400)
    })
  }

  document.addEventListener('DOMContentLoaded', initBannerCarousel)
  document.addEventListener('astro:page-load', initBannerCarousel)
</script>
