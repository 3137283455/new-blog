---
import { resolveUploadUrl } from '../lib/media'

interface Props {
  item: any
  isLocal: boolean
  volumes: any[]
  first?: any
  sources: any[]
  primary?: any
  labels: Record<string, string>
}

const { item, isLocal, volumes, first, sources, primary, labels } = Astro.props
const chapterCount = Number(item.chapter_count || volumes.reduce((sum, volume) => sum + Number(volume.chapter_count || volume.chapters?.length || 0), 0))
---

<main class="manga-detail-page" data-manga-detail-refactor data-id={item.id}>
  <nav class="detail-breadcrumb" aria-label="当前位置"><a href="/manga">漫画书架</a><span>/</span><b>{item.title}</b></nav>

  <section class="detail-hero">
    <div class="detail-cover-frame">{item.cover ? <img src={resolveUploadUrl(item.cover)} alt={`${item.title}封面`} /> : <span>{item.title.slice(0, 1)}</span>}<i>#{String(item.sort_order || item.id).padStart(2, '0')}</i></div>
    <div class="detail-copy"><p class="eyebrow">{isLocal ? 'LOCAL COMIC' : 'NETWORK COLLECTION'} <span>·</span> {labels[item.status || 'reading'] || '在读'}</p><h1>{item.title}</h1>{item.original_title && item.original_title !== item.title && <p class="detail-original">{item.original_title}</p>}<p class="detail-author">{item.author || item.publication || '作者未填写'}</p><p class="detail-description">{item.description || '这部漫画还没有简介。'}</p><div class="detail-tags"><span>{isLocal ? '本地保存' : '网络收藏'}</span>{item.publication && <span>{item.publication}</span>}{item.rating ? <span>★ {Number(item.rating).toFixed(1)}</span> : <span>私人书架</span>}</div><div class="detail-actions">{isLocal ? (first ? <a class="read-primary" data-continue href={`/manga/${item.slug}/${first.volume_slug}/${first.slug}`}>开始阅读 <span>→</span></a> : <span class="no-source">暂无可读章节</span>) : primary ? <a class="read-primary" href={primary.url} target="_blank" rel="noopener noreferrer">去 {primary.name} 阅读 <span>↗</span></a> : <span class="no-source">暂无阅读源</span>}{isLocal && <a class="action-secondary" href="#contents">查看目录</a>}{!isLocal && item.source_url && <a class="action-secondary" href={item.source_url} target="_blank" rel="noopener noreferrer">资料页 ↗</a>}</div></div>
    <aside class="detail-facts"><p class="eyebrow">AT A GLANCE</p><div><strong>{isLocal ? volumes.length : sources.length}</strong><span>{isLocal ? '分卷' : '阅读源'}</span></div><div><strong>{chapterCount || (isLocal ? 0 : '—')}</strong><span>{isLocal ? '章节' : '收藏信息'}</span></div><div><strong data-detail-status>{labels[item.status || 'reading'] || '在读'}</strong><span>阅读状态</span></div></aside>
  </section>

  <div class="detail-body-grid">
    {isLocal ? <section class="detail-panel catalog-panel" id="contents"><header class="panel-heading"><div><p class="eyebrow">CONTENTS</p><h2>卷与章节</h2></div><span>{volumes.length} 卷 · {chapterCount} 章</span></header><div class="volume-list">{volumes.map((volume: any, index: number) => <details open={index === 0}><summary><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{volume.title}</strong><small>{volume.chapter_count || volume.chapters?.length || 0} 章</small></div><b>⌄</b></summary><ol>{(volume.chapters || []).map((chapter: any, chapterIndex: number) => <li><a data-chapter-id={chapter.id} href={`/manga/${item.slug}/${volume.slug}/${chapter.slug}`}><span>{String(chapterIndex + 1).padStart(2, '0')}</span><strong>{chapter.title}</strong><small data-state>{chapter.page_count || 0} 页</small></a></li>)}</ol></details>)}</div></section> : <section class="detail-panel source-panel"><header class="panel-heading"><div><p class="eyebrow">READING SOURCES</p><h2>选择阅读站点</h2></div><span>外部页面将在新标签页打开</span></header><div class="source-list">{sources.map((source: any, index: number) => <a href={source.url} target="_blank" rel="noopener noreferrer"><b>{String(index + 1).padStart(2, '0')}</b><div><strong>{source.name}</strong><small>{source.remark || new URL(source.url).hostname}</small></div>{source.is_default && <em>默认</em>}<span>↗</span></a>)}{!sources.length && <p class="panel-empty">还没有阅读源，可在后台漫画管理中添加。</p>}</div></section>}
    <aside class="detail-aside"><section class="detail-panel info-panel"><header class="panel-heading"><div><p class="eyebrow">DETAILS</p><h2>作品信息</h2></div></header><dl><div><dt>作品状态</dt><dd>{labels[item.status || 'reading'] || '在读'}</dd></div><div><dt>作者</dt><dd>{item.author || '未填写'}</dd></div><div><dt>类型</dt><dd>{isLocal ? '本地漫画' : '网络收藏'}</dd></div><div><dt>来源</dt><dd>{isLocal ? '本地导入' : item.source || '自定义阅读源'}</dd></div></dl></section><section class="detail-panel detail-note"><p class="eyebrow">A READING NOTE</p><blockquote>先把故事收进书架，再从喜欢的章节开始。</blockquote><span>阅读中心 · 私人收藏</span></section></aside>
  </div>
</main>

<style>
.manga-detail-page{width:min(1180px,100%);margin:0 auto;padding:1.5rem 1rem 5rem;color:var(--ink)}.manga-detail-page [hidden]{display:none!important}.detail-breadcrumb{display:flex;align-items:center;gap:.55rem;margin:.1rem 0 1rem;color:var(--muted-ink);font-size:.66rem}.detail-breadcrumb a{color:inherit}.detail-breadcrumb b{overflow:hidden;color:var(--ink);text-overflow:ellipsis;white-space:nowrap}.eyebrow{margin:0;color:var(--brand);font:850 .61rem/1.2 system-ui,sans-serif;letter-spacing:.16em}.eyebrow span{color:var(--muted-ink)}.detail-hero{display:grid;grid-template-columns:220px minmax(0,1fr) 165px;gap:2rem;align-items:center;position:relative;overflow:hidden;border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*1.15);background:linear-gradient(110deg,color-mix(in srgb,var(--theme-primary) 10%,var(--surface-solid)),var(--surface-solid) 68%);padding:1.6rem 1.8rem;box-shadow:0 20px 55px #1423190d}.detail-hero::after{position:absolute;right:-8rem;bottom:-10rem;width:26rem;height:26rem;border-radius:50%;background:color-mix(in srgb,var(--theme-primary) 12%,transparent);content:'';filter:blur(4px);pointer-events:none}.detail-cover-frame{position:relative;z-index:1;display:grid;aspect-ratio:2/3;overflow:hidden;border:1px solid #fff4;border-radius:calc(var(--theme-card-radius,18px)*.65);background:linear-gradient(145deg,color-mix(in srgb,var(--brand) 18%,var(--surface-solid)),var(--surface-solid));box-shadow:0 20px 35px #14231928}.detail-cover-frame img{width:100%;height:100%;object-fit:cover}.detail-cover-frame>span{display:grid;width:100%;height:100%;place-items:center;font:650 4rem var(--theme-title-font)}.detail-cover-frame>i{position:absolute;right:.6rem;bottom:.6rem;color:#fff9;font:700 .55rem ui-monospace;font-style:normal}.detail-copy{position:relative;z-index:1;min-width:0}.detail-copy h1{margin:.45rem 0 .1rem;font:650 clamp(2.6rem,6vw,5.4rem)/.95 var(--theme-title-font);letter-spacing:-.055em}.detail-original{color:var(--muted-ink);font-size:.72rem}.detail-author{margin-top:.65rem;font-weight:850}.detail-description{max-width:42rem;margin-top:1rem;color:var(--muted-ink);font-size:.72rem;line-height:1.8;white-space:pre-line}.detail-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:1rem}.detail-tags span{border:1px solid var(--line);border-radius:999px;background:color-mix(in srgb,var(--surface-solid) 60%,transparent);padding:.3rem .5rem;color:var(--muted-ink);font-size:.55rem}.detail-actions{display:flex;align-items:center;gap:.5rem;margin-top:1.25rem}.detail-actions a,.no-source{display:inline-flex;min-height:2.6rem;align-items:center;border:1px solid var(--line);border-radius:.7rem;padding:.65rem .85rem;color:inherit;font-size:.66rem;font-weight:850;text-decoration:none}.detail-actions .read-primary{gap:.65rem;border-color:transparent;background:var(--ink);color:var(--surface-solid)}.read-primary span{color:#cfff4f;font-size:.9rem}.no-source{color:var(--muted-ink)}.detail-facts{position:relative;z-index:1;align-self:stretch;display:grid;align-content:center;gap:.85rem;border-left:1px solid var(--line);padding-left:1.3rem}.detail-facts>div{display:grid;gap:.12rem}.detail-facts strong{font:650 1.15rem var(--theme-title-font)}.detail-facts span{color:var(--muted-ink);font-size:.57rem}.detail-body-grid{display:grid;grid-template-columns:minmax(0,1fr) 260px;align-items:start;gap:1rem;margin-top:1rem}.detail-panel{border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*.9);background:color-mix(in srgb,var(--surface-solid) 78%,transparent);padding:1.15rem}.panel-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:.9rem;border-bottom:1px solid var(--line)}.panel-heading h2{margin:.3rem 0 0;font:650 1.6rem var(--theme-title-font)}.panel-heading>span{color:var(--muted-ink);font-size:.58rem}.volume-list{display:grid;gap:.55rem;margin-top:.7rem}.volume-list details{border-bottom:1px solid var(--line);padding-bottom:.5rem}.volume-list details:last-child{border-bottom:0}.volume-list summary{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.7rem;padding:.68rem .4rem;cursor:pointer;list-style:none}.volume-list summary>span{color:var(--muted-ink);font:700 .62rem ui-monospace}.volume-list summary div{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}.volume-list summary strong{font-size:.77rem}.volume-list summary small{color:var(--muted-ink);font-size:.58rem}.volume-list summary>b{color:var(--muted-ink);transition:transform .2s}.volume-list details[open] summary>b{transform:rotate(180deg)}.volume-list ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.18rem;padding:0;list-style:none}.volume-list li a{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.5rem;border-radius:.55rem;padding:.62rem .4rem;color:inherit;text-decoration:none}.volume-list li a:hover,.volume-list li a.is-last-read{background:color-mix(in srgb,var(--brand) 9%,transparent)}.volume-list li a>span{color:var(--muted-ink);font:.6rem ui-monospace}.volume-list li strong{overflow:hidden;font-size:.67rem;text-overflow:ellipsis;white-space:nowrap}.volume-list li small{color:var(--muted-ink);font-size:.55rem}.source-list{display:grid;gap:.4rem;margin-top:.7rem}.source-list>a{display:grid;grid-template-columns:2rem minmax(0,1fr) auto auto;align-items:center;gap:.6rem;border-radius:.65rem;padding:.75rem .45rem;color:inherit;text-decoration:none}.source-list>a:hover{background:color-mix(in srgb,var(--brand) 7%,transparent)}.source-list>a>b{color:var(--muted-ink);font:700 .6rem ui-monospace}.source-list strong,.source-list small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-list small{margin-top:.12rem;color:var(--muted-ink);font-size:.56rem}.source-list em{border-radius:999px;background:color-mix(in srgb,var(--brand) 13%,transparent);padding:.24rem .38rem;color:var(--brand);font-size:.53rem;font-style:normal;font-weight:850}.source-list>a>span{color:var(--muted-ink)}.panel-empty{padding:1.5rem 0;color:var(--muted-ink);font-size:.68rem}.detail-aside{display:grid;gap:.8rem}.info-panel dl{display:grid;gap:.75rem;margin:1rem 0 0}.info-panel dl div{display:flex;justify-content:space-between;gap:.7rem;border-bottom:1px solid var(--line);padding-bottom:.7rem}.info-panel dl div:last-child{border-bottom:0;padding-bottom:0}.info-panel dt{color:var(--muted-ink);font-size:.6rem}.info-panel dd{margin:0;font-size:.62rem;font-weight:800;text-align:right}.detail-note{background:linear-gradient(145deg,color-mix(in srgb,var(--theme-primary) 11%,var(--surface-solid)),var(--surface-solid))}.detail-note blockquote{margin:1rem 0 .6rem;font:600 1.05rem/1.5 var(--theme-title-font)}.detail-note>span{color:var(--muted-ink);font-size:.58rem}@media(max-width:900px){.detail-hero{grid-template-columns:180px minmax(0,1fr)}.detail-facts{grid-column:1/-1;display:flex;border-top:1px solid var(--line);border-left:0;padding:1rem 0 0}.detail-facts>div{flex:1;border-left:1px solid var(--line);padding-left:1rem}.detail-facts>div:first-of-type{border-left:0;padding-left:0}.detail-body-grid{grid-template-columns:minmax(0,1fr) 220px}}@media(max-width:700px){.manga-detail-page{padding:.7rem .65rem 3rem}.detail-hero{grid-template-columns:92px minmax(0,1fr);gap:.9rem;padding:1rem;border-radius:1rem}.detail-copy h1{font-size:1.95rem}.detail-original{display:none}.detail-author{font-size:.7rem}.detail-description{grid-column:1/-1;margin-top:.5rem;font-size:.67rem}.detail-tags{margin-top:.7rem}.detail-tags span{font-size:.52rem}.detail-actions{grid-column:1/-1;align-items:stretch;flex-direction:column;margin-top:.8rem}.detail-actions a,.no-source{justify-content:center;width:100%}.detail-facts{grid-column:1/-1;gap:.55rem;padding-top:.75rem}.detail-facts strong{font-size:.9rem}.detail-body-grid{grid-template-columns:1fr}.detail-aside{grid-template-columns:1fr}.detail-note{display:none}.detail-panel{padding:.85rem}.panel-heading h2{font-size:1.4rem}.panel-heading>span{display:none}.volume-list ol{grid-template-columns:1fr}.volume-list li a{grid-template-columns:1.5rem minmax(0,1fr) auto}}
</style>

{isLocal && <script>
  // @ts-nocheck
  import { ensurePrivateDeviceToken } from '../lib/private-device'
  async function initMangaDetailRefactor() {
    const root = document.querySelector('[data-manga-detail-refactor]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    const token = await ensurePrivateDeviceToken(window.__PUBLIC_API_BASE__ || '/api')
    if (!token) return
    try {
      const response = await fetch(`${window.__PUBLIC_API_BASE__ || '/api'}/private/manga/${root.dataset.id}/progress`, { headers: { 'X-Device-Token': token } })
      const json = await response.json(); const state = json.data
      if (!response.ok || !state) return
      const link = root.querySelector(`[data-chapter-id="${state.chapter_id}"]`)
      if (!link) return
      link.classList.add('is-last-read'); link.closest('details').open = true; link.querySelector('[data-state]').textContent = `上次第 ${Number(state.page_index) + 1} 页`
      const action = root.querySelector('[data-continue]')
      if (action) { action.href = link.href + `?page=${Number(state.page_index) + 1}`; action.innerHTML = '继续阅读 <span>→</span>' }
    } catch {}
  }
  document.addEventListener('astro:page-load', initMangaDetailRefactor)
  initMangaDetailRefactor()
</script>}
