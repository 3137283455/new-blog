---
import { resolveUploadUrl } from '../lib/media'

interface Props {
  books: any[]
}

const { books } = Astro.props
const totalVolumes = books.reduce((sum, book) => sum + Number(book.volume_count || 0), 0)
const totalChapters = books.reduce((sum, book) => sum + Number(book.chapter_count || 0), 0)
const statusLabel = (status?: string) => ({ reading: '在读', finished: '读完', planned: '想读', paused: '暂放' }[status || 'reading'] || '在读')
const statusCounts = {
  all: books.length,
  reading: books.filter((book) => (book.reading_status || 'reading') === 'reading').length,
  finished: books.filter((book) => book.reading_status === 'finished').length,
  planned: books.filter((book) => book.reading_status === 'planned').length,
  paused: books.filter((book) => book.reading_status === 'paused').length,
}
const cardHref = (book: any) => book.reading_mode === 'chapters' || !book.reading_mode ? `/books/${book.slug}` : (book.reading_url || `/books/${book.slug}`)
const isExternal = (book: any) => book.reading_mode === 'external' || book.reading_mode === 'document'
---

<section class="library-page" data-library-refactor>
  <header class="library-intro">
    <div class="intro-copy">
      <p class="eyebrow">YOUR READING ROOM <span>·</span> {books.length ? 'ACTIVE COLLECTION' : 'READY TO BEGIN'}</p>
      <h1>书库</h1>
      <p class="intro-description">把正在读的、想读的和读过的故事，放在一个安静而有秩序的地方。</p>
    </div>
    <div class="library-stats" aria-label="书库统计">
      <div><strong>{books.length}</strong><span>藏书</span></div>
      <div><strong>{totalVolumes}</strong><span>分卷</span></div>
      <div><strong>{totalChapters}</strong><span>章节</span></div>
    </div>
  </header>

  <section class="continue-card" data-library-continue hidden>
    <div class="continue-mark"><span>CONTINUE</span><i>↗</i></div>
    <div class="continue-cover" data-continue-cover-wrap><img data-continue-cover alt="" /></div>
    <div class="continue-copy"><p>LAST OPENED</p><h2 data-continue-title>继续阅读</h2><span data-continue-chapter>从上次停下的地方继续</span><div class="continue-progress"><i data-continue-bar></i></div><small data-continue-progress></small></div>
    <a class="continue-link" data-continue-link href="/books">打开阅读 <span>→</span></a>
  </section>

  <div class="library-layout">
    <section class="collection-card">
      <header class="collection-head"><div><p class="eyebrow">MY COLLECTION</p><h2>我的藏书</h2></div><span data-library-count>{books.length} 本书</span></header>
      <div class="library-toolbar">
        <nav class="filter-tabs" aria-label="书库状态">
          <button class="is-active" type="button" data-library-filter="all">全部 <span>{statusCounts.all}</span></button>
          <button type="button" data-library-filter="reading">在读 <span>{statusCounts.reading}</span></button>
          <button type="button" data-library-filter="planned">想读 <span>{statusCounts.planned}</span></button>
          <button type="button" data-library-filter="finished">读完 <span>{statusCounts.finished}</span></button>
          <button type="button" data-library-filter="paused">暂放 <span>{statusCounts.paused}</span></button>
        </nav>
        <div class="toolbar-controls">
          <label class="library-search"><span>⌕</span><input type="search" data-library-search placeholder="搜索书名、作者" autocomplete="off" /><kbd>/</kbd></label>
          <select data-library-sort aria-label="书籍排序"><option value="updated">最近整理</option><option value="title">书名</option><option value="author">作者</option><option value="length">章节数</option><option value="progress">阅读进度</option></select>
          <button class="random-book" type="button" data-random-book title="随机打开一本">随机一本</button>
          <div class="view-switch" aria-label="视图切换"><button type="button" data-library-view="grid" aria-label="封面网格">▦</button><button type="button" data-library-view="list" aria-label="列表视图">☷</button></div>
        </div>
      </div>
      <div class="collection-meta"><span>选择一本书开始阅读</span><small>进度会在你的私人设备之间同步</small></div>
      <div class="book-shelf" data-book-shelf>
        {books.map((book) => {
          const modeLabel = book.reading_mode === 'external' ? '站外阅读' : book.reading_mode === 'document' ? (book.source_format || '文档').toUpperCase() : statusLabel(book.reading_status)
          const href = cardHref(book)
          return <article class="book-tile" data-book-card data-id={book.id} data-title={(book.title || '').toLocaleLowerCase()} data-author={(book.author || '').toLocaleLowerCase()} data-description={(book.description || '').toLocaleLowerCase()} data-status={book.reading_status || 'reading'} data-updated={book.updated_at || ''} data-chapters={book.chapter_count || 0} data-progress="0">
            <a class="book-tile-cover" href={href} target={isExternal(book) ? '_blank' : undefined} rel={isExternal(book) ? 'noopener noreferrer' : undefined}>
              {book.cover ? <img src={resolveUploadUrl(book.cover)} alt={`${book.title}封面`} loading="lazy" decoding="async" /> : <span class="cover-fallback">{book.title.slice(0, 1)}</span>}
              <b>{modeLabel}</b><i class="cover-glow"></i>
            </a>
            <div class="book-tile-copy"><small>{book.author || '作者未填写'}</small><h3><a href={href} target={isExternal(book) ? '_blank' : undefined} rel={isExternal(book) ? 'noopener noreferrer' : undefined}>{book.title}</a></h3><p>{book.description || `${book.volume_count || 0} 卷 · ${book.chapter_count || 0} 章`}</p><div class="book-progress" data-book-progress hidden><i></i><span></span></div><footer><span>{book.reading_mode === 'external' ? '外部链接' : book.reading_mode === 'document' ? `${(book.source_format || '文档').toUpperCase()} 文档` : `${book.volume_count || 0} 卷 · ${book.chapter_count || 0} 章`}</span><a data-book-action href={href} target={isExternal(book) ? '_blank' : undefined} rel={isExternal(book) ? 'noopener noreferrer' : undefined}>{book.reading_mode === 'external' ? '前往 ↗' : book.reading_mode === 'document' ? '打开 ↗' : '详情 →'}</a></footer></div>
          </article>
        })}
      </div>
      <div class="library-empty" data-library-empty hidden><strong>没有匹配的书籍</strong><span>试试更短的关键词，或者换一个阅读状态。</span></div>
      {!books.length && <div class="library-empty is-empty"><strong>书架还是空的</strong><span>从后台导入 EPUB、TXT、Markdown、PDF，或添加外部阅读链接。</span><a href="/admin">前往内容中心 →</a></div>}
    </section>

    <aside class="library-rail">
      <section class="rail-card status-card"><header><p class="eyebrow">READING STATUS</p><span>本次整理</span></header><div class="status-list">
        <button type="button" data-library-filter="reading"><i class="status-dot is-reading"></i><span>正在阅读</span><strong>{statusCounts.reading}</strong><b>→</b></button>
        <button type="button" data-library-filter="planned"><i class="status-dot is-planned"></i><span>准备阅读</span><strong>{statusCounts.planned}</strong><b>→</b></button>
        <button type="button" data-library-filter="finished"><i class="status-dot is-finished"></i><span>已经读完</span><strong>{statusCounts.finished}</strong><b>→</b></button>
        <button type="button" data-library-filter="paused"><i class="status-dot is-paused"></i><span>暂时搁置</span><strong>{statusCounts.paused}</strong><b>→</b></button>
      </div></section>
      <section class="rail-card library-note"><p class="eyebrow">A SMALL NOTE</p><blockquote>“读书不是为了抵达某处，而是为了在每个当下，拥有自己的房间。”</blockquote><span>— 阅读空间</span></section>
      <a class="rail-link" href="/reading"><span>阅读中心</span><small>查看所有阅读记录 ↗</small></a>
    </aside>
  </div>
</section>

<style>
