amp:1}.book-shelf[data-view=list] .book-tile-copy footer{margin-top:auto}.library-empty{display:grid;min-height:13rem;place-content:center;gap:.3rem;border:1px dashed var(--line);border-radius:.9rem;color:var(--muted-ink);text-align:center}.library-empty strong{color:var(--ink);font:650 1.2rem var(--theme-title-font)}.library-empty span{font-size:.68rem}.library-empty a{margin-top:.25rem;color:var(--brand);font-size:.68rem;font-weight:850}.library-rail{display:grid;gap:.8rem}.rail-card{border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*.9);background:color-mix(in srgb,var(--surface-solid) 78%,transparent);padding:1rem}.status-card header{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:.7rem;border-bottom:1px solid var(--line)}.status-card header>span{color:var(--muted-ink);font-size:.56rem}.status-list{display:grid}.status-list button{display:grid;grid-template-columns:.55rem 1fr auto .8rem;align-items:center;gap:.55rem;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);padding:.75rem 0;text-align:left}.status-list button:last-child{border-bottom:0;padding-bottom:.15rem}.status-list button:first-child{padding-top:.85rem}.status-list span{font-size:.65rem}.status-list strong{font-size:.75rem}.status-list b{color:var(--muted-ink);font-size:.7rem}.status-dot{width:.45rem;height:.45rem;border-radius:50%;background:var(--muted-ink)}.status-dot.is-reading{background:#79a67d}.status-dot.is-planned{background:#d5a45b}.status-dot.is-finished{background:#6f9ac2}.status-dot.is-paused{background:#a39aa8}.library-note{background:linear-gradient(145deg,color-mix(in srgb,var(--theme-primary) 11%,var(--surface-solid)),var(--surface-solid))}.library-note blockquote{margin:1rem 0 .65rem;font:600 1.05rem/1.5 var(--theme-title-font)}.library-note>span{color:var(--muted-ink);font-size:.6rem}.rail-link{display:flex;flex-direction:column;gap:.25rem;border-bottom:1px solid var(--line);padding:.55rem .1rem;color:var(--ink)}.rail-link span{font-size:.72rem;font-weight:850}.rail-link small{color:var(--muted-ink);font-size:.59rem}@media(max-width:900px){.library-layout{grid-template-columns:1fr}.library-rail{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.rail-link{grid-column:1/-1}}@media(max-width:650px){.library-page{padding:.7rem .65rem 3rem}.library-intro{align-items:start;flex-direction:column;gap:1rem;padding:.15rem 0 1.1rem}.intro-copy h1{font-size:3.1rem}.intro-description{font-size:.7rem}.library-stats{width:100%;border:1px solid var(--line);border-radius:.75rem;background:color-mix(in srgb,var(--surface-solid) 75%,transparent)}.library-stats div{min-width:0;flex:1;padding:.55rem .3rem}.library-stats strong{font-size:1.05rem}.continue-card{grid-template-columns:4.2rem minmax(0,1fr);gap:.75rem;padding:.8rem}.continue-cover{width:4.2rem}.continue-copy{padding-right:0}.continue-copy h2{font-size:1.05rem}.continue-copy>span{font-size:.63rem}.continue-mark{top:.8rem;right:.8rem}.continue-mark span{display:none}.continue-link{grid-column:1/-1;justify-content:space-between;margin:0;border-top:1px solid var(--line);padding-top:.65rem}.continue-link span{width:1.8rem;height:1.8rem}.collection-card{padding:.85rem;border-radius:1rem}.collection-head h2{font-size:1.45rem}.toolbar-controls{display:grid;grid-template-columns:minmax(0,1fr) auto}.library-search{grid-column:1/-1;grid-row:1}.toolbar-controls select{grid-column:1;grid-row:2;min-width:0}.random-book{display:none}.view-switch{grid-column:2;grid-row:2}.collection-meta small{display:none}.book-shelf{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem .65rem}.book-tile-copy h3{font-size:.84rem}.book-tile-copy footer{font-size:.54rem}.library-rail{grid-template-columns:1fr}.library-note{display:none}}@media(max-width:370px){.book-shelf{gap:.85rem .5rem}.book-tile-copy footer a{font-size:0}.book-tile-copy footer a::after{content:'→';font-size:.62rem}}
</style>

<script>
  // @ts-nocheck
  import { ensurePrivateDeviceToken } from '../lib/private-device'

  function initBookLibraryRefactor() {
    const root = document.querySelector('[data-library-refactor]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    const shelf = root.querySelector('[data-book-shelf]')
    const cards = [...root.querySelectorAll('[data-book-card]')]
    const search = root.querySelector('[data-library-search]')
    const sort = root.querySelector('[data-library-sort]')
    const count = root.querySelector('[data-library-count]')
    const empty = root.querySelector('[data-library-empty]')
    let filter = 'all'
    const normalize = (value) => String(value || '').trim().toLocaleLowerCase()
    const apply = () => {
      const term = normalize(search?.value)
      const visible = cards.filter((card) => {
        const matchesStatus = filter === 'all' || card.dataset.status === filter
        const matchesTerm = !term || [card.dataset.title, card.dataset.author, card.dataset.description].some((value) => normalize(value).includes(term))
        card.hidden = !(matchesStatus && matchesTerm)
        return !card.hidden
      })
      const mode = sort?.value || 'updated'
      visible.sort((a, b) => mode === 'title' ? (a.dataset.title || '').localeCompare(b.dataset.title || '', 'zh-CN') : mode === 'author' ? (a.dataset.author || '').localeCompare(b.dataset.author || '', 'zh-CN') : mode === 'length' ? Number(b.dataset.chapters) - Number(a.dataset.chapters) : mode === 'progress' ? Number(b.dataset.progress) - Number(a.dataset.progress) : (b.dataset.updated || '').localeCompare(a.dataset.updated || ''))
      visible.forEach((card) => shelf.append(card))
      if (count) count.textContent = `${visible.length} 本书`
      if (empty) empty.hidden = visible.length > 0 || cards.length === 0
    }
    const setFilter = (next) => { filter = next; root.querySelectorAll('[data-library-filter]').forEach((button) => button.classList.toggle('is-active', button.dataset.libraryFilter === next)); apply() }
    const setView = (view) => { shelf.dataset.view = view; root.querySelectorAll('[data-library-view]').forEach((button) => button.classList.toggle('is-active', button.dataset.libraryView === view)); localStorage.setItem('boke_library_view', view) }
    root.querySelectorAll('[data-library-filter]').forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.libraryFilter)))
    root.querySelectorAll('[data-library-view]').forEach((button) => button.addEventListener('click', () => setView(button.dataset.libraryView)))
    search?.addEventListener('input', apply)
    sort?.addEventListener('change', apply)
    root.querySelector('[data-random-book]')?.addEventListener('click', () => { const visible = cards.filter((card) => !card.hidden); const card = visible[Math.floor(Math.random() * visible.length)]; const link = card?.querySelector('[data-book-action]') || card?.querySelector('.book-tile-cover'); if (link) location.href = link.href })
    addEventListener('keydown', (event) => { if (event.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) { event.preventDefault(); search?.focus() } })
    setView(localStorage.getItem('boke_library_view') === 'list' ? 'list' : 'grid')
    apply()
    ;(async () => {
      const token = await ensurePrivateDeviceToken(window.__PUBLIC_API_BASE__ || '/api')
      if (!token) return
      try {
        const response = await fetch((window.__PUBLIC_API_BASE__ || '/api') + '/private/library', { headers: { 'X-Device-Token': token } })
        const json = await response.json()
        if (!response.ok || !Array.isArray(json.data)) return
        const states = new Map(json.data.map((item) => [String(item.id), item]))
        cards.forEach((card) => {
          const state = states.get(String(card.dataset.id)); if (!state) return
          const progress = Math.max(0, Math.min(1, Number(state.overall_progress) || 0)); card.dataset.progress = String(progress)
          const bar = card.querySelector('[data-book-progress]'); const action = card.querySelector('[data-book-action]')
          if (bar) { bar.hidden = false; bar.querySelector('i').style.width = `${Math.max(1, Math.round(progress * 100))}%`; bar.querySelector('span').textContent = `全书 ${Math.round(progress * 100)}%` }
          if (action && state.volume_slug && state.chapter_slug) { action.href = `/books/${encodeURIComponent(state.slug)}/${encodeURIComponent(state.volume_slug)}/${encodeURIComponent(state.chapter_slug)}?at=${Math.max(0, Math.min(1, Number(state.chapter_progress) || 0))}`; action.textContent = '继续 →' }
        })
        const latest = json.data.find((item) => item.volume_slug && item.chapter_slug); const panel = root.querySelector('[data-library-continue]')
        if (latest && panel) {
          const source = cards.find((card) => card.dataset.id === String(latest.id)); const image = source?.querySelector('.book-tile-cover img'); const progress = Math.max(0, Math.min(1, Number(latest.overall_progress) || 0)); const percent = Math.round(progress * 100)
          panel.hidden = false; const cover = panel.querySelector('[data-continue-cover]')
          if (image && cover) { cover.src = image.src; cover.alt = image.alt } else panel.querySelector('[data-continue-cover-wrap]')?.setAttribute('hidden', '')
          panel.querySelector('[data-continue-title]').textContent = latest.title; panel.querySelector('[data-continue-chapter]').textContent = `${latest.volume_title ? latest.volume_title + ' · ' : ''}${latest.chapter_title || '继续上次阅读'}`; panel.querySelector('[data-continue-bar]').style.width = `${Math.max(1, percent)}%`; panel.querySelector('[data-continue-progress]').textContent = `第 ${latest.chapter_number || 1} / ${latest.chapter_count || 1} 章 · 全书 ${percent}%`; panel.querySelector('[data-continue-link]').href = `/books/${encodeURIComponent(latest.slug)}/${encodeURIComponent(latest.volume_slug)}/${encodeURIComponent(latest.chapter_slug)}?at=${Math.max(0, Math.min(1, Number(latest.chapter_progress) || 0))}`
        }
        apply()
      } catch {}
    })()
  }
  document.addEventListener('astro:page-load', initBookLibraryRefactor)
  initBookLibraryRefactor()
</script>
