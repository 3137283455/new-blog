---
import BaseCard from './BaseCard.astro'
import MusicPlayer from './MusicPlayer.astro'
import type { MusicTrack } from '../lib/api'

interface CategoryItem {
  name?: string
  slug?: string
}

interface StatItem {
  label: string
  value: number | string
}

interface SidebarSectionItem {
  label: string
  href?: string
  value?: number | string
}

interface SidebarSection {
  title: string
  marker?: string
  tone?: 'primary' | 'secondary' | 'accent'
  items: SidebarSectionItem[]
}

interface Props {
  totalPosts?: number
  totalViews?: number
  totalComments?: number
  statItems?: StatItem[]
  sidebarSections?: SidebarSection[]
  categories?: Array<string | CategoryItem>
  tags?: string[]
  musicPlaylist?: MusicTrack[]
  profileName?: string
  profileAvatar?: string
  profileBio?: string
}

const {
  totalPosts = 0,
  totalViews = 0,
  totalComments = 0,
  statItems,
  sidebarSections,
  categories = [],
  musicPlaylist = [],
  profileName = '个人博客',
  profileAvatar = '/profile.webp',
  profileBio = '记录技术、生活和长期主义的小站。',
} = Astro.props

const categoryList = categories.length ? categories : ['技术', '生活', '随笔']
const profileStats = statItems?.length
  ? statItems.slice(0, 3)
  : [
      { label: '文章', value: totalPosts },
      { label: '阅读', value: totalViews },
      { label: '评论', value: totalComments },
    ]
const contextualSections: SidebarSection[] = sidebarSections ?? [
  {
    title: '分类',
    marker: '#',
    tone: 'primary',
    items: categoryList.map((category) => {
      const name = typeof category === 'string' ? category : category.name || ''
      const slug = typeof category === 'string' ? category : category.slug || name
      return { label: name, href: `/archive?category=${encodeURIComponent(slug)}` }
    }),
  },
  {
    title: '标签',
    marker: '✦',
    tone: 'secondary',
    items: [],
  },
]

const toneClass = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  accent: 'text-accent',
}
---

<div class="public-sidebar">
  <BaseCard class="sidebar-profile-card">
    <div class="sidebar-profile-head">
      <img src={profileAvatar} alt="个人头像" width="56" height="56" loading="lazy" decoding="async" data-fallback-src="/profile.webp" />
      <div>
        <h2>{profileName}</h2>
        <p>{profileBio}</p>
      </div>
    </div>

    <div class="sidebar-profile-stats">
      {profileStats.map((item) => (
        <div>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </div>

    <div class="sidebar-context-sections">
      {contextualSections.map((section) => (
        section.items.length > 0 && (
          <section class="sidebar-context-section">
            <h3>
              <span class={toneClass[section.tone || 'primary']}>{section.marker || '#'}</span>
              {section.title}
            </h3>
            <div>
              {section.items.map((item) => (
                item.href ? (
                  <a href={item.href}>
                    <span>{item.label}</span>
                    {item.value !== undefined && <small>{item.value}</small>}
                  </a>
                ) : (
                  <span class="sidebar-context-label">
                    <span>{item.label}</span>
                    {item.value !== undefined && <small>{item.value}</small>}
                  </span>
                )
              ))}
            </div>
          </section>
        )
      ))}
    </div>
  </BaseCard>

  <BaseCard class="music-widget sidebar-music-card">
    <MusicPlayer tracks={musicPlaylist} />
  </BaseCard>
</div>
