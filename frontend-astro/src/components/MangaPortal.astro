---
import { resolveUploadUrl } from '../lib/media'
import MangaSiteHeader from './MangaSiteHeader.astro'
import MangaSourcePicker from './MangaSourcePicker.astro'

interface Props { manga: any[] }
const { manga } = Astro.props
const local = manga.filter((item) => item.library_type === 'local')
const network = manga.filter((item) => item.library_type !== 'local')
---

<main class="manga-home" data-manga-experience data-mode="home">
  <MangaSiteHeader active="discover" />

  <section class="manga-home-hero">
    <div class="manga-home-hero-copy">
      <p class="manga-eyebrow">DISCOVER · SEARCH · READ</p>
      <h1>在前台找到<br /><em>下一部漫画。</em></h1>
      <p>从已导入的 Venera 兼容源中搜索作品，打开详情、章节和阅读。这里负责发现，后台只负责维护来源。</p>
      <form class="manga-search-bar" data-manga-search-form>
        <label><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg><input data-manga-query type="search" placeholder="搜索漫画、作者或关键词" autocomplete="off" /></label>
        <MangaSourcePicker />
        <button type="submit">开始搜索 <span>→</span></button>
      </form>
      <p class="manga-inline-state" data-manga-state data-source-status>正在读取漫画源…</p>
    </div>
    <div class="manga-hero-art" aria-hidden="true"><div class="hero-orbit hero-orbit-one"></div><div class="hero-orbit hero-orbit-two"></div><div class="hero-orbit hero-orbit-three"></div><span>漫</span></div>
  </section>

  <section class="manga-shortcuts" aria-label="漫画站快捷入口">
    <a href="/manga/latest"><span class="shortcut-icon">↗</span><span><small>KEEP EXPLORING</small><strong>最新发现</strong></span><b>打开 →</b></a>
    <a href="/manga/library"><span class="shortcut-icon">▦</span><span><small>YOUR COLLECTION</small><strong>我的书架</strong></span><b>{manga.length} 部 →</b></a>
    <a href="/admin#search-sources"><span class="shortcut-icon">◈</span><span><small>SOURCE CONTROL</small><strong>管理漫画源</strong></span><b>后台 →</b></a>
  </section>

  <div class="manga-home-grid">
    <section class="manga-home-main">
      <header class="manga-section-head">
        <div><p class="manga-eyebrow">SOURCE DISCOVERY</p><h2>源站发现</h2></div>
        <span data-explore-source>正在选择来源…</span>
      </header>
      <div class="manga-result-grid" data-manga-explore><div class="manga-result-empty"><strong>正在读取漫画源</strong><span>首次打开会从支持发现页的来源加载作品。</span></div></div>
    </section>

    <aside class="manga-home-rail">
      <section class="manga-rail-card manga-library-preview">
        <header><div><p class="manga-eyebrow">MY SHELF</p><h3>我的书架</h3></div><a href="/manga/library">查看全部 ↗</a></header>
        <div class="manga-shelf-stats"><div><strong>{manga.length}</strong><span>全部</span></div><div><strong>{local.length}</strong><span>本地</span></div><div><strong>{network.length}</strong><span>网络</span></div></div>
        <div class="manga-preview-list">
          {manga.slice(0, 4).map((item) => <a href={`/manga/${item.slug}`}><span class="preview-cover">{item.cover ? <img src={resolveUploadUrl(item.cover)} alt="" loading="lazy" /> : item.title.slice(0, 1)}</span><span><strong>{item.title}</strong><small>{item.author || (item.library_type === 'local' ? '本地漫画' : '网络收藏')}</small></span><b>→</b></a>)}
          {!manga.length && <p>书架还是空的。搜索到喜欢的作品后再收藏。</p>}
        </div>
      </section>
      <section class="manga-rail-note"><span>TIP</span><p>源选择藏在搜索框里，需要时打开即可，不会占据首页空间。</p></section>
    </aside>
  </div>
</main>

<style>
  .manga-home{--manga-ink:#172018;--manga-brand:#2f6f4e;--manga-muted:#7a8279;--manga-line:#e4e8df;--manga-soft:#f0f3e9;--manga-surface:#fff;width:min(1240px,100%);margin:0 auto;padding:0 1rem 5rem;color:var(--manga-ink)}.manga-home [hidden]{display:none!important}.manga-eyebrow{margin:0;color:var(--manga-brand);font:850 .57rem/1.2 system-ui,sans-serif;letter-spacing:.16em}.manga-home-hero{display:grid;grid-template-columns:minmax(0,1fr) 22rem;align-items:center;gap:2rem;margin-top:1rem;overflow:hidden;border:1px solid var(--manga-line);border-radius:1.35rem;background:linear-gradient(120deg,#f7f9f1,#eef3e5);padding:clamp(2rem,5vw,4.5rem);position:relative}.manga-home-hero-copy{position:relative;z-index:1;max-width:43rem}.manga-home-hero h1{margin:.65rem 0 .9rem;font:650 clamp(2.8rem,6vw,5.5rem)/.94 var(--theme-title-font,Georgia,serif);letter-spacing:-.06em}.manga-home-hero h1 em{color:var(--manga-brand);font-style:normal}.manga-home-hero-copy>p:not(.manga-eyebrow):not(.manga-inline-state){max-width:32rem;margin:0;color:var(--manga-muted);font-size:.72rem;line-height:1.8}.manga-search-bar{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:.42rem;max-width:47rem;margin-top:1.55rem;border:1px solid #dfe5d7;border-radius:.88rem;background:#fff;padding:.35rem;box-shadow:0 14px 34px #273b2512}.manga-search-bar label{display:flex;min-width:0;align-items:center;gap:.55rem;padding-left:.65rem}.manga-search-bar label svg{width:.95rem;fill:none;stroke:var(--manga-muted);stroke-width:1.8}.manga-search-bar input{width:100%;height:2.8rem;border:0;outline:0;background:transparent;color:var(--manga-ink);font-size:.7rem}.manga-search-bar>button{height:2.8rem;border:0;border-radius:.63rem;background:var(--manga-ink);padding:0 .9rem;color:#f4ffd9;font-size:.64rem;font-weight:900;white-space:nowrap}.manga-search-bar>button span{margin-left:.35rem;color:#d8ff55;font-size:.9rem}.manga-inline-state{margin-top:.65rem!important;color:var(--manga-muted)!important;font-size:.57rem!important}.manga-inline-state.is-error{color:#a33f35!important}.manga-hero-art{position:relative;display:grid;width:22rem;height:22rem;place-items:center;border-radius:50%;background:radial-gradient(circle at center,#ffffffcc 0 15%,transparent 16%),radial-gradient(circle,#d8ff5540,#d8ff5510 38%,transparent 64%);transform:rotate(-13deg)}.manga-hero-art>span{display:grid;width:7.5rem;height:7.5rem;place-items:center;border:1px solid #2f6f4e2f;border-radius:2rem;background:var(--manga-ink);color:#d8ff55;font:900 3.8rem var(--theme-title-font);box-shadow:0 25px 45px #1720182b}.hero-orbit{position:absolute;border:1px solid #2f6f4e38;border-radius:50%}.hero-orbit-one{inset:1.5rem 3rem;transform:rotate(35deg)}.hero-orbit-two{inset:3rem 1.5rem;transform:rotate(-35deg)}.hero-orbit-three{inset:4.5rem 0;transform:rotate(80deg);border-style:dashed}.manga-shortcuts{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin-top:.8rem}.manga-shortcuts>a{display:grid;grid-template-columns:2.4rem minmax(0,1fr) auto;align-items:center;gap:.65rem;border:1px solid var(--manga-line);border-radius:.95rem;background:#ffffffb8;padding:.8rem;color:inherit;text-decoration:none;transition:transform .18s,border-color .18s}.manga-shortcuts>a:hover{transform:translateY(-2px);border-color:#adc29c}.shortcut-icon{display:grid;width:2.35rem;height:2.35rem;place-items:center;border-radius:.75rem;background:var(--manga-soft);color:var(--manga-brand);font-size:1rem;font-weight:900}.manga-shortcuts small,.manga-shortcuts strong{display:block}.manga-shortcuts small{color:var(--manga-muted);font-size:.48rem;letter-spacing:.1em}.manga-shortcuts strong{margin-top:.2rem;font-size:.7rem}.manga-shortcuts>b{color:var(--manga-muted);font-size:.56rem;white-space:nowrap}.manga-home-grid{display:grid;grid-template-columns:minmax(0,1fr) 20rem;align-items:start;gap:1.4rem;margin-top:2.5rem}.manga-section-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.95rem}.manga-section-head h2{margin:.35rem 0 0;font:650 2rem var(--theme-title-font)}.manga-section-head>span{color:var(--manga-muted);font-size:.57rem}.manga-result-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.1rem .7rem}.manga-result-card{min-width:0}.manga-result-cover{position:relative;display:block;aspect-ratio:2/3;overflow:hidden;border:1px solid var(--manga-line);border-radius:.78rem;background:linear-gradient(145deg,#e8eedf,#fff);color:var(--manga-ink);box-shadow:0 12px 25px #17201812;transition:transform .18s,box-shadow .18s}.manga-result-cover:hover{transform:translateY(-4px);box-shadow:0 18px 34px #17201824}.manga-result-cover img{width:100%;height:100%;object-fit:cover}.manga-result-cover>span{display:grid;width:100%;height:100%;place-items:center;font:650 2.7rem var(--theme-title-font)}.manga-result-cover i{position:absolute;top:.45rem;left:.45rem;max-width:calc(100% - .9rem);overflow:hidden;border-radius:999px;background:#172018d9;color:#fff;padding:.25rem .4rem;font-size:.47rem;font-style:normal;text-overflow:ellipsis;white-space:nowrap}.manga-result-cover b{position:absolute;right:.45rem;bottom:.45rem;border-radius:999px;background:#d8ff55;padding:.25rem .4rem;color:#172018;font-size:.49rem}.manga-result-card>div{padding:.58rem .1rem}.manga-result-card small,.manga-result-card h3,.manga-result-card p{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manga-result-card small{color:var(--manga-brand);font-size:.52rem;font-weight:850}.manga-result-card h3{margin:.25rem 0;font-size:.76rem}.manga-result-card h3 a{color:inherit;text-decoration:none}.manga-result-card p{margin:0;color:var(--manga-muted);font-size:.54rem}.manga-result-empty{grid-column:1/-1;display:grid;min-height:13rem;place-content:center;gap:.35rem;border:1px dashed var(--manga-line);border-radius:1rem;text-align:center}.manga-result-empty strong{font:650 1.15rem var(--theme-title-font)}.manga-result-empty span{color:var(--manga-muted);font-size:.62rem}.manga-home-rail{display:grid;gap:.8rem}.manga-rail-card{border:1px solid var(--manga-line);border-radius:1rem;background:#ffffffb8;padding:1rem}.manga-rail-card header{display:flex;align-items:end;justify-content:space-between;gap:.5rem;border-bottom:1px solid var(--manga-line);padding-bottom:.7rem}.manga-rail-card h3{margin:.32rem 0 0;font:650 1.45rem var(--theme-title-font)}.manga-rail-card header>a{color:var(--manga-brand);font-size:.56rem;font-weight:850;text-decoration:none}.manga-shelf-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.35rem;margin:.85rem 0}.manga-shelf-stats div{display:grid;gap:.2rem;border-right:1px solid var(--manga-line);text-align:center}.manga-shelf-stats div:last-child{border:0}.manga-shelf-stats strong{font:650 1.25rem var(--theme-title-font)}.manga-shelf-stats span{color:var(--manga-muted);font-size:.53rem}.manga-preview-list{display:grid;gap:.18rem}.manga-preview-list>a{display:grid;grid-template-columns:2.3rem minmax(0,1fr) auto;align-items:center;gap:.55rem;border-radius:.6rem;padding:.42rem .25rem;color:inherit;text-decoration:none}.manga-preview-list>a:hover{background:var(--manga-soft)}.preview-cover{display:grid;width:2.3rem;height:3.1rem;place-items:center;overflow:hidden;border-radius:.4rem;background:var(--manga-soft);font:700 1rem var(--theme-title-font)}.preview-cover img{width:100%;height:100%;object-fit:cover}.manga-preview-list strong,.manga-preview-list small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manga-preview-list strong{font-size:.64rem}.manga-preview-list small{margin-top:.16rem;color:var(--manga-muted);font-size:.52rem}.manga-preview-list>a>b{color:var(--manga-muted);font-size:.68rem}.manga-preview-list>p{margin:.8rem 0 .2rem;color:var(--manga-muted);font-size:.62rem;line-height:1.6}.manga-rail-note{border-left:3px solid #d8ff55;background:var(--manga-soft);padding:.8rem 1rem}.manga-rail-note>span{color:var(--manga-brand);font:850 .52rem system-ui;letter-spacing:.14em}.manga-rail-note p{margin:.35rem 0 0;color:var(--manga-muted);font-size:.62rem;line-height:1.65}@media(max-width:900px){.manga-home-hero{grid-template-columns:1fr}.manga-hero-art{position:absolute;right:-8rem;bottom:-5rem;width:24rem;height:24rem;opacity:.48}.manga-home-grid{grid-template-columns:1fr}.manga-home-rail{grid-template-columns:1fr 1fr}.manga-result-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:700px){.manga-home{padding:0 .65rem 3rem}.manga-home-hero{margin-top:.7rem;padding:1.55rem 1rem;border-radius:1rem}.manga-home-hero h1{font-size:3rem}.manga-search-bar{grid-template-columns:minmax(0,1fr) auto}.manga-search-bar .manga-source-picker{grid-column:1}.manga-search-bar>button{grid-column:2;grid-row:1}.manga-shortcuts{grid-template-columns:1fr}.manga-shortcuts>a{padding:.65rem}.manga-home-grid{margin-top:1.8rem}.manga-section-head{align-items:start;flex-direction:column}.manga-result-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem .6rem}.manga-home-rail{grid-template-columns:1fr}.manga-rail-note{display:none}}
</style>

<script>
  import '../scripts/manga-experience.js'
</script>
