---
import { resolveUploadUrl } from '../lib/media'

interface Props { manga: any[] }
const { manga } = Astro.props
const local = manga.filter((item) => item.library_type === 'local')
const network = manga.filter((item) => item.library_type !== 'local')
const statusLabel = (status?: string) => ({ reading: '在追', finished: '已读', planned: '想看', paused: '搁置' }[status || 'reading'] || '在追')
---

<main class="manga-portal" data-manga-portal>
  <header class="portal-nav">
    <a class="portal-brand" href="/manga"><span>漫</span><b>漫画站</b></a>
    <nav aria-label="漫画导航"><button class="is-active" data-portal-jump="discover">发现</button><button data-portal-jump="library">书架</button><button data-portal-filter="local">本地漫画</button><button data-portal-filter="network">网络收藏</button></nav>
    <a class="portal-reading" href="/reading">阅读记录 <span>→</span></a>
  </header>

  <section class="portal-hero" id="discover">
    <div class="hero-copy"><p>DISCOVER · SEARCH · READ</p><h1>想看的漫画，<br /><em>从这里开始。</em></h1><span>搜索已导入的漫画源，直接进入作品详情和章节阅读。后台只负责维护源与基础资料。</span></div>
    <form class="hero-search" data-portal-search>
      <label><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4.2-4.2"></path></svg><input type="search" data-portal-query placeholder="搜索漫画、作者或关键词" autocomplete="off" /></label>
      <select data-portal-source aria-label="选择漫画源"><option value="all">全部漫画源</option></select>
      <button type="submit">搜索</button>
    </form>
    <div class="hero-meta"><span data-portal-source-status>正在读取漫画源…</span><i></i><span>{manga.length} 部书架收藏</span><i></i><span>{local.length} 部本地漫画</span></div>
  </section>

  <section class="source-dock" aria-label="漫画源"><div><span>漫画源</span><b data-portal-source-count>读取中</b></div><div class="source-buttons" data-portal-source-buttons></div><a href="/admin#search-sources">管理源 →</a></section>

  <section class="remote-section search-section" data-portal-search-panel hidden>
    <header class="section-heading"><div><p>SEARCH RESULTS</p><h2 data-portal-search-title>搜索结果</h2></div><span data-portal-search-summary></span></header>
    <div class="remote-grid" data-portal-search-results></div>
  </section>

  <section class="remote-section" data-portal-explore-panel>
    <header class="section-heading"><div><p>EXPLORE</p><h2>源站发现</h2></div><span data-portal-explore-summary>选择支持探索页的漫画源</span></header>
    <div class="remote-grid" data-portal-explore-results><div class="portal-empty"><b>搜索漫画源</b><span>输入作品名即可从网络源发现并直接阅读漫画。</span></div></div>
  </section>

  <section class="library-section" id="library" data-portal-library>
    <header class="section-heading library-heading"><div><p>MY LIBRARY</p><h2>我的漫画书架</h2></div><div class="library-filters"><button class="is-active" data-library-type="all">全部 <span>{manga.length}</span></button><button data-library-type="local">本地 <span>{local.length}</span></button><button data-library-type="network">网络 <span>{network.length}</span></button></div></header>
    <div class="library-grid" data-library-grid>
      {manga.map((item) => {
        const isLocal = item.library_type === 'local'
        return <article class="library-card" data-library-card data-type={isLocal ? 'local' : 'network'}>
          <a class="library-cover" href={`/manga/${item.slug}`}>{item.cover ? <img src={resolveUploadUrl(item.cover)} alt={`${item.title}封面`} loading="lazy" /> : <span>{item.title.slice(0, 1)}</span>}<i>{isLocal ? '本地' : '收藏'}</i>{item.rating ? <b>★ {Number(item.rating).toFixed(1)}</b> : null}</a>
          <div><small>{item.author || item.publication || (isLocal ? '本地漫画' : '网络漫画')}</small><h3><a href={`/manga/${item.slug}`}>{item.title}</a></h3><p>{isLocal ? `${item.volume_count || 0} 卷 · ${item.chapter_count || 0} 章` : `${statusLabel(item.status)}${item.progress ? ` · ${item.progress}` : ''}`}</p></div>
        </article>
      })}
      {!manga.length && <div class="portal-empty"><b>书架还是空的</b><span>这不会影响源搜索和在线阅读。</span></div>}
    </div>
  </section>
</main>

<style>
  .manga-portal{--portal-accent:#d7ff45;width:min(1240px,100%);margin:0 auto;padding:0 1rem 5rem;color:var(--ink)}.manga-portal [hidden]{display:none!important}.portal-nav{display:flex;align-items:center;gap:2rem;min-height:4.4rem;border-bottom:1px solid var(--line)}.portal-brand{display:flex;align-items:center;gap:.6rem;color:inherit;text-decoration:none}.portal-brand>span{display:grid;width:2rem;height:2rem;place-items:center;border-radius:.55rem;background:var(--ink);color:var(--portal-accent);font-weight:900}.portal-brand b{font:700 1.1rem var(--theme-title-font)}.portal-nav nav{display:flex;gap:.1rem}.portal-nav button{border:0;background:transparent;padding:.8rem;color:var(--muted-ink);font-size:.67rem;font-weight:850}.portal-nav button:hover,.portal-nav button.is-active{color:var(--ink)}.portal-reading{margin-left:auto;border:1px solid var(--line);border-radius:999px;padding:.55rem .75rem;color:inherit;font-size:.62rem;font-weight:850;text-decoration:none}.portal-reading span{color:var(--brand)}
  .portal-hero{position:relative;overflow:hidden;margin-top:1rem;border-radius:1.4rem;background:var(--ink);padding:clamp(2.2rem,6vw,5.2rem);color:var(--surface-solid);box-shadow:0 28px 70px #1118}.portal-hero:before,.portal-hero:after{position:absolute;border-radius:50%;content:'';pointer-events:none}.portal-hero:before{right:-12rem;top:-17rem;width:38rem;height:38rem;border:1px solid #fff2;box-shadow:0 0 0 5rem #fff1,0 0 0 10rem #fff1}.portal-hero:after{right:8%;bottom:-7rem;width:15rem;height:15rem;background:var(--portal-accent);opacity:.16;filter:blur(30px)}.hero-copy{position:relative;z-index:1;max-width:48rem}.hero-copy>p,.section-heading p{margin:0;color:var(--portal-accent);font:850 .59rem system-ui;letter-spacing:.18em}.hero-copy h1{margin:.7rem 0 1rem;font:650 clamp(3rem,7vw,6.5rem)/.92 var(--theme-title-font);letter-spacing:-.055em}.hero-copy h1 em{color:var(--portal-accent);font-style:normal}.hero-copy>span{display:block;max-width:37rem;color:#fff9;font-size:.72rem;line-height:1.8}.hero-search{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) 11rem auto;max-width:55rem;margin-top:2rem;border:1px solid #fff3;border-radius:.9rem;background:#fff;padding:.35rem;color:#172018;box-shadow:0 20px 45px #0005}.hero-search label{display:flex;align-items:center;gap:.55rem;padding:0 .7rem}.hero-search svg{width:1.05rem;fill:none;stroke:currentColor;stroke-width:1.8;opacity:.55}.hero-search input{width:100%;height:3rem;border:0;outline:0;background:transparent;color:inherit;font-size:.74rem}.hero-search select{border:0;border-left:1px solid #1720181c;outline:0;background:#fff;padding:0 .7rem;color:inherit;font-size:.65rem;font-weight:750}.hero-search button{border:0;border-radius:.65rem;background:var(--portal-accent);padding:0 1.2rem;color:#172018;font-size:.68rem;font-weight:900}.hero-meta{position:relative;z-index:1;display:flex;align-items:center;gap:.65rem;margin-top:1rem;color:#fff7;font-size:.57rem}.hero-meta i{width:3px;height:3px;border-radius:50%;background:#fff5}
  .source-dock{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:1rem;margin:1rem 0;padding:.75rem 1rem;border:1px solid var(--line);border-radius:1rem;background:color-mix(in srgb,var(--surface-solid) 85%,transparent)}.source-dock>div:first-child{display:grid}.source-dock span{font-size:.55rem;color:var(--muted-ink)}.source-dock b{font-size:.72rem}.source-dock>a{color:var(--muted-ink);font-size:.59rem;font-weight:800}.source-buttons{display:flex;gap:.35rem;overflow:auto}.source-buttons button{flex:none;border:1px solid var(--line);border-radius:999px;background:transparent;padding:.45rem .65rem;color:var(--muted-ink);font-size:.57rem;font-weight:800}.source-buttons button.is-active{border-color:var(--ink);background:var(--ink);color:var(--surface-solid)}
  .remote-section,.library-section{margin-top:2.1rem}.search-section{scroll-margin-top:1rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.section-heading p{color:var(--brand)}.section-heading h2{margin:.3rem 0 0;font:650 clamp(1.8rem,4vw,2.8rem) var(--theme-title-font)}.section-heading>span{color:var(--muted-ink);font-size:.61rem}.remote-grid,.library-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(9.2rem,1fr));gap:1.25rem .85rem}.remote-card,.library-card{min-width:0}.remote-cover,.library-cover{position:relative;display:block;overflow:hidden;aspect-ratio:2/3;border:1px solid var(--line);border-radius:.85rem;background:linear-gradient(145deg,color-mix(in srgb,var(--brand) 14%,var(--surface-solid)),var(--surface-solid));color:inherit;box-shadow:0 12px 28px #14231914;transition:transform .2s,box-shadow .2s}.remote-cover:hover,.library-cover:hover{transform:translateY(-4px);box-shadow:0 20px 38px #14231924}.remote-cover img,.library-cover img{width:100%;height:100%;object-fit:cover}.remote-cover>span,.library-cover>span{display:grid;width:100%;height:100%;place-items:center;font:650 3rem var(--theme-title-font)}.remote-cover i,.library-cover i{position:absolute;top:.5rem;left:.5rem;border-radius:999px;background:#111c;color:#fff;padding:.28rem .42rem;font-size:.51rem;font-style:normal;backdrop-filter:blur(8px)}.remote-cover b,.library-cover b{position:absolute;right:.5rem;bottom:.5rem;border-radius:999px;background:var(--portal-accent);padding:.28rem .42rem;color:#172018;font-size:.5rem}.remote-card>div,.library-card>div{padding:.65rem .1rem 0}.remote-card small,.library-card small{display:block;overflow:hidden;color:var(--brand);font-size:.55rem;font-weight:850;text-overflow:ellipsis;white-space:nowrap}.remote-card h3,.library-card h3{overflow:hidden;margin:.25rem 0;font-size:.85rem;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.remote-card h3 a,.library-card h3 a{color:inherit;text-decoration:none}.remote-card p,.library-card p{overflow:hidden;margin:0;color:var(--muted-ink);font-size:.55rem;line-height:1.5;text-overflow:ellipsis;white-space:nowrap}.portal-empty{grid-column:1/-1;display:grid;min-height:10rem;place-content:center;gap:.35rem;border:1px dashed var(--line);border-radius:1rem;text-align:center}.portal-empty b{font:650 1.2rem var(--theme-title-font)}.portal-empty span{color:var(--muted-ink);font-size:.63rem}.library-heading{border-top:1px solid var(--line);padding-top:2rem}.library-filters{display:flex;gap:.25rem}.library-filters button{border:1px solid var(--line);border-radius:999px;background:transparent;padding:.5rem .65rem;color:var(--muted-ink);font-size:.57rem;font-weight:850}.library-filters button.is-active{background:var(--ink);color:var(--surface-solid)}.library-filters span{margin-left:.18rem;opacity:.6}
  @media(max-width:720px){.manga-portal{padding:0 .65rem 3rem}.portal-nav{gap:.7rem}.portal-brand b,.portal-nav nav button:nth-child(n+3){display:none}.portal-nav nav{margin-left:auto}.portal-reading{display:none}.portal-hero{padding:2rem 1.1rem}.hero-copy h1{font-size:3rem}.hero-search{grid-template-columns:1fr auto}.hero-search select{grid-row:2;grid-column:1/-1;height:2.5rem;border-top:1px solid #1720181c;border-left:0}.hero-search button{grid-column:2;grid-row:1}.hero-meta{flex-wrap:wrap}.source-dock{grid-template-columns:auto 1fr}.source-dock>a{display:none}.remote-grid,.library-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem .6rem}.section-heading{align-items:start;flex-direction:column}.library-heading{align-items:stretch}.library-filters{overflow:auto}}@media(max-width:440px){.remote-grid,.library-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<script>
  // @ts-nocheck
  function initMangaPortal() {
    const root = document.querySelector('[data-manga-portal]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    const api = window.__PUBLIC_API_BASE__ || '/api'
    const query = root.querySelector('[data-portal-query]'), sourceSelect = root.querySelector('[data-portal-source]'), form = root.querySelector('[data-portal-search]')
    const sourceButtons = root.querySelector('[data-portal-source-buttons]'), sourceStatus = root.querySelector('[data-portal-source-status]'), sourceCount = root.querySelector('[data-portal-source-count]')
    const searchPanel = root.querySelector('[data-portal-search-panel]'), searchResults = root.querySelector('[data-portal-search-results]'), searchTitle = root.querySelector('[data-portal-search-title]'), searchSummary = root.querySelector('[data-portal-search-summary]')
    const exploreResults = root.querySelector('[data-portal-explore-results]'), exploreSummary = root.querySelector('[data-portal-explore-summary]')
    let sources = [], defaultSource = ''
    const escape = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]))
    const sourceById = (id) => sources.find((source) => source.id === id)
    const coverUrl = (item) => item.cover ? `${api}/content-sources/media?kind=manga&source=${encodeURIComponent(item.source)}&url=${encodeURIComponent(item.cover)}` : ''
    function cards(items) {
      return items.map((item) => { const href = `/source/manga/${encodeURIComponent(item.source)}/${encodeURIComponent(item.external_id)}`; const cover = coverUrl(item); return `<article class="remote-card"><a class="remote-cover" href="${href}">${cover ? `<img src="${escape(cover)}" alt="${escape(item.title)}封面" loading="lazy">` : `<span>${escape(item.title.slice(0, 1))}</span>`}<i>${escape(item.source_label || sourceById(item.source)?.label || '漫画源')}</i>${Number(item.rating) ? `<b>★ ${Number(item.rating).toFixed(1)}</b>` : ''}</a><div><small>${escape(item.author || item.publication || item.source_label || '网络漫画')}</small><h3><a href="${href}">${escape(item.title)}</a></h3><p>${escape(item.total ? `${item.total} 章` : item.description || '打开作品详情')}</p></div></article>` }).join('')
    }
    const empty = (title, copy) => `<div class="portal-empty"><b>${escape(title)}</b><span>${escape(copy)}</span></div>`
    function activateSource(id) {
      sourceSelect.value = id
      sourceButtons.querySelectorAll('button').forEach((button) => button.classList.toggle('is-active', button.dataset.source === id))
    }
    async function loadExplore(source) {
      const meta = sourceById(source)
      if (!meta?.has_explore) { exploreSummary.textContent = meta ? `${meta.label} 未配置探索页，可直接搜索` : '聚合搜索覆盖全部已启用源'; exploreResults.innerHTML = empty('从搜索开始', '输入作品名、作者或关键词，从漫画源找到想看的内容。'); return }
      exploreSummary.textContent = `正在加载 ${meta.label}…`
      exploreResults.innerHTML = empty('正在加载', '从漫画源读取推荐内容…')
      try { const response = await fetch(`${api}/content-sources/explore?kind=manga&source=${encodeURIComponent(source)}&limit=24`), json = await response.json(); if (!response.ok || json.success === false) throw new Error(json.message || '探索页读取失败'); const items = json.data?.items || []; exploreResults.innerHTML = cards(items) || empty('暂无推荐', '这个源的探索页暂时没有返回内容。'); exploreSummary.textContent = `${meta.label} · ${items.length} 部漫画` } catch (error) { exploreResults.innerHTML = empty('探索页暂不可用', error.message || '请稍后再试'); exploreSummary.textContent = error.message || '探索页读取失败' }
    }
    async function search() {
      const value = query.value.trim(), source = sourceSelect.value || defaultSource || 'all'
      if (!value) { query.focus(); sourceStatus.textContent = '请输入漫画名称或关键词'; return }
      searchPanel.hidden = false; searchPanel.scrollIntoView({ behavior: 'smooth', block: 'start' }); searchTitle.textContent = `“${value}”的搜索结果`; searchSummary.textContent = '正在检索漫画源…'; searchResults.innerHTML = empty('正在搜索', '正在请求已启用的漫画源…')
      const url = new URL(location.href); url.searchParams.set('q', value); url.searchParams.set('source', source); history.replaceState({}, '', url)
      try { const response = await fetch(`${api}/content-sources/search?kind=manga&source=${encodeURIComponent(source)}&q=${encodeURIComponent(value)}&limit=20`), json = await response.json(); if (!response.ok || json.success === false) throw new Error(json.message || '漫画源搜索失败'); const items = json.data?.items || []; searchResults.innerHTML = cards(items) || empty('没有找到漫画', '换一个关键词或漫画源试试。'); const okSources = json.data?.aggregate ? (json.data.sources || []).filter((item) => item.ok).length : 1; searchSummary.textContent = `${items.length} 个结果 · ${json.data?.aggregate ? `${okSources} 个源响应` : json.data?.source?.label || '漫画源'}`; sourceStatus.textContent = `已找到 ${items.length} 个结果` } catch (error) { searchResults.innerHTML = empty('搜索失败', error.message || '请检查漫画源配置'); searchSummary.textContent = error.message || '搜索失败'; sourceStatus.textContent = '漫画源搜索失败' }
    }
    async function loadSources() {
      try {
        const response = await fetch(`${api}/content-sources?kind=manga`), json = await response.json()
        if (!response.ok || json.success === false) throw new Error(json.message || '漫画源读取失败')
        sources = json.data?.sources || []; defaultSource = json.data?.default_source || sources[0]?.id || ''
        sourceSelect.innerHTML = `<option value="all">聚合搜索 · 全部源</option>` + sources.map((source) => `<option value="${escape(source.id)}">${escape(source.label)}${source.has_reader ? ' · 可阅读' : ''}</option>`).join('')
        sourceButtons.innerHTML = `<button type="button" data-source="all">全部源</button>` + sources.map((source) => `<button type="button" data-source="${escape(source.id)}">${escape(source.label)}${source.has_explore ? ' · 发现' : ''}</button>`).join('')
        sourceCount.textContent = `${sources.length} 个已启用`; sourceStatus.textContent = sources.length ? `${sources.length} 个漫画源可用` : '暂无漫画源，请先在后台导入'
        const params = new URLSearchParams(location.search), selected = params.get('source') || 'all'; activateSource(selected === 'all' || sourceById(selected) ? selected : 'all')
        sourceButtons.querySelectorAll('button').forEach((button) => button.addEventListener('click', () => { activateSource(button.dataset.source); loadExplore(button.dataset.source) }))
        sourceSelect.addEventListener('change', () => { activateSource(sourceSelect.value); loadExplore(sourceSelect.value) })
        const exploreSource = sourceById(selected)?.has_explore ? selected : sources.find((source) => source.has_explore)?.id || 'all'; if (!params.get('source') && exploreSource !== 'all') activateSource(exploreSource); loadExplore(exploreSource)
        if (params.get('q')) { query.value = params.get('q'); search() }
      } catch (error) { sourceStatus.textContent = error.message || '漫画源读取失败'; sourceCount.textContent = '不可用'; sourceButtons.innerHTML = '' }
    }
    form.addEventListener('submit', (event) => { event.preventDefault(); search() })
    root.querySelectorAll('[data-portal-jump]').forEach((button) => button.addEventListener('click', () => document.querySelector(`#${button.dataset.portalJump}`)?.scrollIntoView({ behavior: 'smooth' })))
    function filterLibrary(type) { root.querySelectorAll('[data-library-card]').forEach((card) => { card.hidden = type !== 'all' && card.dataset.type !== type }); root.querySelectorAll('[data-library-type]').forEach((button) => button.classList.toggle('is-active', button.dataset.libraryType === type)); document.querySelector('#library')?.scrollIntoView({ behavior: 'smooth' }) }
    root.querySelectorAll('[data-library-type]').forEach((button) => button.addEventListener('click', () => filterLibrary(button.dataset.libraryType)))
    root.querySelectorAll('[data-portal-filter]').forEach((button) => button.addEventListener('click', () => filterLibrary(button.dataset.portalFilter)))
    loadSources()
  }
  document.addEventListener('astro:page-load', initMangaPortal)
  initMangaPortal()
</script>
