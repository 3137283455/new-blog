---
import BaseLayout from '../layouts/BaseLayout.astro'
const apiBase=import.meta.env.PUBLIC_API_BASE||'/api'
---
<BaseLayout title="阅读中心" subtitle="小说与漫画的统一阅读记录" showSidebar={false} showBanner={false} wide>
<section class="reading-hub" data-reading-hub data-api-base={apiBase}>
  <header><div><p>PRIVATE READING</p><h1>继续阅读</h1><span>小说和漫画共用一条跨设备时间线，也可以保存当前章节离线阅读。</span></div><nav><a href="/books">书库</a><a href="/manga">漫画</a></nav></header>
  <div class="reading-hub-filter"><button class="active" data-kind="">全部</button><button data-kind="book">小说</button><button data-kind="manga">漫画</button><span data-summary>正在读取私人记录…</span></div>
  <div class="reading-hub-list" data-list></div>
</section>
<style>
.reading-hub{display:grid;gap:1.2rem}.reading-hub>header{display:flex;align-items:end;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line);padding:1.5rem .2rem 1.2rem}.reading-hub>header p{color:var(--brand);font-size:.62rem;font-weight:900;letter-spacing:.16em}.reading-hub h1{margin:.15rem 0;font:650 clamp(2.2rem,6vw,4.5rem)/1 var(--editorial-serif)}.reading-hub>header span{color:var(--muted-ink);font-size:.76rem}.reading-hub>header nav{display:flex;gap:.45rem}.reading-hub>header a,.reading-hub-filter button,.reading-item button{border:1px solid var(--line);border-radius:999px;background:var(--surface-solid);color:var(--ink);padding:.55rem .8rem;font-size:.68rem;font-weight:780}.reading-hub-filter{display:flex;align-items:center;gap:.4rem}.reading-hub-filter button.active{border-color:var(--ink);background:var(--ink);color:var(--paper)}.reading-hub-filter span{margin-left:auto;color:var(--muted-ink);font-size:.66rem}.reading-hub-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:.8rem}.reading-item{display:grid;grid-template-columns:76px minmax(0,1fr);gap:1rem;border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:.8rem}.reading-item img,.reading-item .cover{width:76px;height:106px;border-radius:11px;background:var(--surface-muted);object-fit:cover}.reading-item .cover{display:grid;place-items:center;font:700 1.5rem var(--editorial-serif)}.reading-item h2{overflow:hidden;margin:.2rem 0;font:650 1.25rem var(--editorial-serif);text-overflow:ellipsis;white-space:nowrap}.reading-item p,.reading-item small{display:block;overflow:hidden;color:var(--muted-ink);font-size:.66rem;text-overflow:ellipsis;white-space:nowrap}.reading-progress{height:4px;margin:.8rem 0;border-radius:999px;background:var(--line)}.reading-progress i{display:block;height:100%;border-radius:inherit;background:var(--brand)}.reading-item footer{display:flex;align-items:center;gap:.45rem}.reading-item footer a{margin-right:auto;color:var(--brand);font-size:.7rem;font-weight:800}.reading-empty{grid-column:1/-1;padding:4rem 1rem;border:1px dashed var(--line);border-radius:18px;color:var(--muted-ink);text-align:center}@media(max-width:600px){.reading-hub>header{align-items:start;flex-direction:column}.reading-hub h1{font-size:2.7rem}.reading-hub-list{grid-template-columns:1fr}.reading-hub-filter span{display:none}}
</style>
<script>
// @ts-nocheck
import { ensurePrivateDeviceToken } from '../lib/private-device'
const root=document.querySelector('[data-reading-hub]')
if(root){
 const api=root.dataset.apiBase||'/api',list=root.querySelector('[data-list]'),summary=root.querySelector('[data-summary]');let items=[],kind=''
 const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))
 const render=()=>{const rows=items.filter((x)=>!kind||x.kind===kind);summary.textContent=rows.length+' 条阅读记录';list.innerHTML=rows.map((x)=>'<article class="reading-item">'+(x.cover?'<img src="'+esc(x.cover)+'" alt="">':'<span class="cover">'+(x.kind==='manga'?'漫':'书')+'</span>')+'<div class="min-w-0"><small>'+(x.kind==='manga'?'漫画':'小说')+' · '+esc(x.section_title||'')+'</small><h2>'+esc(x.title)+'</h2><p>'+esc(x.chapter_title||'尚未定位章节')+'</p><div class="reading-progress"><i style="width:'+Math.round(Number(x.progress||0)*100)+'%"></i></div><footer><a href="'+esc(x.href||'#')+'">继续阅读 →</a><button data-offline="'+esc(x.href||'')+'">离线</button></footer></div></article>').join('')||'<p class="reading-empty">还没有阅读记录，打开一本书或漫画后会自动出现在这里。</p>'}
 const saveOffline=async(url,button)=>{if(!('serviceWorker'in navigator))return;button.disabled=true;button.textContent='准备中';try{const html=await fetch(url).then((r)=>r.text()),doc=new DOMParser().parseFromString(html,'text/html'),urls=[url,...Array.from(doc.querySelectorAll('img[src]')).map((img)=>(()=>{const u=new URL(img.getAttribute('src'),location.origin);return u.origin===location.origin?u.pathname+u.search:null})())];const registration=await navigator.serviceWorker.ready;registration.active?.postMessage({type:'CACHE_READING',urls:[...new Set(urls.filter(Boolean))]});button.textContent='已保存'}catch{button.textContent='失败'}finally{button.disabled=false}}
 root.addEventListener('click',(e)=>{const filter=e.target.closest('[data-kind]'),offline=e.target.closest('[data-offline]');if(filter){kind=filter.dataset.kind;root.querySelectorAll('[data-kind]').forEach((b)=>b.classList.toggle('active',b===filter));render()}if(offline)saveOffline(offline.dataset.offline,offline)})
 ;(async()=>{const token=await ensurePrivateDeviceToken(api);if(!token){summary.textContent='需要私人设备授权';list.innerHTML='<p class="reading-empty">请先登录后台，将当前设备登记为私人设备。</p>';return}try{const response=await fetch(api+'/private/reading-center',{headers:{'X-Device-Token':token}}),json=await response.json();items=json.data||[];render()}catch{summary.textContent='读取失败';render()}})()
}
</script>