        <div class="mb-4 flex items-center justify-between gap-3">
          <h3 id="album-dialog-title" class="text-xl font-black">新建相册</h3>
          <button id="album-dialog-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
        </div>
        <div id="album-form-host"></div>
      </div>
    </dialog>

    <dialog id="album-photos-dialog" class="admin-media-picker admin-album-photos-dialog">
      <div class="admin-media-picker-panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 id="album-photos-title" class="text-xl font-black">相册照片</h3>
            <p id="album-photos-meta" class="text-sm text-base-content/50"></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <label class="ryu-btn-primary btn-sm cursor-pointer">
              上传图片
              <input id="album-photo-bulk-upload" class="hidden" type="file" accept="image/*" />
            </label>
            <button id="album-photo-create" class="ryu-btn btn-sm" type="button">从媒体库导入</button>
            <button id="album-photos-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
          </div>
        </div>
        <div id="album-photos-grid" class="admin-photo-grid mt-5"></div>
      </div>
    </dialog>

    <dialog id="album-photo-dialog" class="admin-media-picker">
      <div class="admin-media-picker-panel">
        <div class="mb-4 flex items-center justify-between gap-3">
          <h3 id="album-photo-dialog-title" class="text-xl font-black">照片信息</h3>
          <button id="album-photo-dialog-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
        </div>
        <div id="album-photo-form-host"></div>
      </div>
    </dialog>

    <dialog id="music-playlist-dialog" class="admin-media-picker admin-music-form-dialog">
      <div class="admin-media-picker-panel">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h3 id="music-playlist-dialog-title" class="text-xl font-black">新建歌单</h3>
            <p class="text-sm text-base-content/50">设置歌单名称、封面与前台状态。</p>
          </div>
          <button id="music-playlist-dialog-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
        </div>
        <form id="music-playlist-form" class="grid gap-3">
          <input type="hidden" name="id" />
          <label class="form-control">
            <span class="label-text">歌单名称</span>
            <input class="input input-bordered rounded-xl" name="name" placeholder="歌单名称" required />
          </label>
          <label class="form-control">
            <span class="label-text">歌单描述</span>
            <input class="input input-bordered rounded-xl" name="description" placeholder="简要介绍这个歌单" />
          </label>
          <label class="form-control">
            <span class="label-text">歌单封面</span>
            <div class="join w-full">
              <input class="input join-item input-bordered w-full rounded-l-xl" name="cover" placeholder="/uploads/..." />
              <button class="btn join-item" type="button" data-pick-media data-target-form="music-playlist-form" data-target-field="cover" data-media-type="image">选择</button>
              <label class="btn join-item rounded-r-xl">上传<input id="music-playlist-cover-upload" class="hidden" type="file" accept="image/*" /></label>
            </div>
          </label>
          <div class="grid gap-3 md:grid-cols-[1fr_auto]">
            <label class="form-control">
              <span class="label-text">排序</span>
              <input class="input input-bordered rounded-xl" name="sort_order" type="number" placeholder="0" />
            </label>
            <label class="label mt-6 cursor-pointer justify-start gap-2 rounded-xl bg-base-100/60 px-3">
              <input class="checkbox checkbox-sm" name="is_active" type="checkbox" checked />
              前台启用
            </label>
          </div>
          <div class="mt-2 flex justify-end gap-2">
            <button class="ryu-btn" id="cancel-music-playlist" type="button">取消</button>
            <button class="ryu-btn-primary" type="submit">保存歌单</button>
          </div>
          <p id="music-playlist-message" class="min-h-6 text-sm"></p>
        </form>
      </div>
    </dialog>

    <dialog id="music-tracks-dialog" class="admin-media-picker admin-music-tracks-dialog">
      <div class="admin-media-picker-panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs font-black uppercase text-primary">Playlist Tracks</p>
            <h3 id="music-tracks-dialog-title" class="text-xl font-black">歌单歌曲</h3>
          </div>
          <div class="flex items-center gap-2">
            <button id="create-music-track" class="ryu-btn-primary btn-sm" type="button">新增歌曲</button>
            <button id="music-tracks-dialog-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <span id="music-summary" class="text-sm text-base-content/55">0 首歌</span>
          <button id="save-music" class="ryu-btn btn-sm" type="button">保存排序</button>
        </div>
        <select id="music-playlist-filter" class="hidden" aria-hidden="true">
          <option value="">全部歌单</option>
        </select>
        <div id="music-list" class="admin-track-list mt-4"></div>
        <p id="music-message" class="mt-3 min-h-6 text-sm"></p>
      </div>
    </dialog>

    <dialog id="music-track-dialog" class="admin-media-picker admin-music-form-dialog">
      <div class="admin-media-picker-panel">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h3 id="music-track-dialog-title" class="text-xl font-black">新增歌曲</h3>
            <p class="text-sm text-base-content/50">支持上传音频、封面并填写 LRC 歌词。</p>
          </div>
          <button id="music-track-dialog-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
        </div>
        <form id="music-form" class="grid gap-4">
          <label class="form-control">
            <span class="label-text">歌曲名</span>
            <input class="input input-bordered rounded-xl" name="title" required />
          </label>
          <div class="grid gap-3 md:grid-cols-2">
            <label class="form-control">
              <span class="label-text">歌手</span>
              <input class="input input-bordered rounded-xl" name="artist" placeholder="未知歌手" />
            </label>
            <label class="form-control">
              <span class="label-text">所属歌单</span>
              <select class="select select-bordered rounded-xl" name="playlist" required></select>
            </label>
          </div>
          <label class="form-control">
            <span class="label-text">音乐地址</span>
            <div class="join w-full">
              <input class="input join-item input-bordered w-full rounded-l-xl" name="url" placeholder="/uploads/..." required />
              <button class="btn join-item" type="button" data-pick-media data-target-form="music-form" data-target-field="url" data-media-type="audio">选择</button>
              <label class="btn join-item rounded-r-xl">上传<input id="music-audio-upload" class="hidden" type="file" accept="audio/*" /></label>
            </div>
          </label>
          <label class="form-control">
            <span class="label-text">封面地址</span>
            <div class="join w-full">
              <input class="input join-item input-bordered w-full rounded-l-xl" name="cover" placeholder="/uploads/..." />
              <button class="btn join-item" type="button" data-pick-media data-target-form="music-form" data-target-field="cover" data-media-type="image">选择</button>
              <label class="btn join-item rounded-r-xl">上传<input id="music-cover-upload" class="hidden" type="file" accept="image/*" /></label>
            </div>
          </label>
          <label class="form-control">
            <span class="label-text">歌词</span>
            <textarea class="textarea textarea-bordered min-h-36 rounded-xl" name="lyrics" placeholder="支持逐行歌词，也可以粘贴 LRC 文本"></textarea>
          </label>
          <div class="grid gap-3 md:grid-cols-2"><label class="form-control"><span class="label-text">关联文章 ID</span><input class="input input-bordered rounded-xl" name="article_id" type="number" min="1" placeholder="可选" /></label><label class="form-control"><span class="label-text">关联照片 ID</span><input class="input input-bordered rounded-xl" name="photo_id" type="number" min="1" placeholder="可选" /></label></div>
          <div class="flex justify-end gap-2">
            <button id="cancel-music-track" class="ryu-btn" type="button">取消</button>
            <button class="ryu-btn-primary" type="submit">保存歌曲</button>
          </div>
        </form>
      </div>
    </dialog>

    <dialog id="media-picker-dialog" class="admin-media-picker">
      <div class="admin-media-picker-panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="text-xl font-black">选择媒体资源</h3>
            <p id="media-picker-hint" class="text-sm text-base-content/50">从媒体库选择已上传文件。</p>
          </div>
          <button id="close-media-picker" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
        </div>
        <div class="mt-4 grid gap-3 md:grid-cols-[1fr_10rem]">
          <input id="media-picker-search" class="input input-bordered rounded-xl" type="search" placeholder="搜索文件名、路径、类型..." />
          <select id="media-picker-type" class="select select-bordered rounded-xl">
            <option value="">全部类型</option>
            <option value="image">图片</option>
            <option value="audio">音频</option>
            <option value="video">视频</option>
          </select>
        </div>
        <div id="media-picker-grid" class="admin-media-picker-grid mt-4"></div>
      </div>
    </dialog>

    <script>
      import '../scripts/admin-core.js';
      import '../scripts/admin-extra.js';
      import '../scripts/admin-personal.js';
      import '../scripts/admin-books.js';
      import '../scripts/admin-content-center.js';
      import '../scripts/admin-manga.js';
      import '../scripts/admin-search-sources.js';
    </script>
  </body>
</html>
