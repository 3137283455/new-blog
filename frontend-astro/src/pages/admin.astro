---
import '../styles/global.scss'

const apiBase = import.meta.env.PUBLIC_API_BASE || '/api'
---

<!doctype html>
<html lang="zh-CN" data-theme="boke-green" data-theme-type="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="博客后台管理系统" />
    <title>后台管理 - 个人博客</title>
    <script is:inline>
      const themeTypes = { 'boke-night': 'dark', 'boke-punk': 'dark', 'boke-green': 'light' };
      const storedTheme = localStorage.getItem('theme') || 'boke-green';
      document.documentElement.setAttribute('data-theme', storedTheme);
      document.documentElement.setAttribute('data-theme-type', themeTypes[storedTheme] || 'light');
    </script>
  </head>
  <body class="admin-body min-h-screen text-base-content">
    <div class="site-bg-grid"></div>
    <section class="admin-shell" data-api-base={apiBase}>
    <aside class="admin-sidebar">
      <a class="admin-sidebar-brand" href="/" aria-label="返回博客首页">
        <img src="/profile.webp" alt="" />
        <span><strong>My Blog</strong><small>管理后台</small></span>
      </a>
      <nav class="mt-8 grid gap-2">
        <button class="admin-nav is-active" data-panel="dashboard">概览</button>
        <button class="admin-nav" data-panel="articles">内容中心</button>
        <button class="admin-nav" data-panel="media">媒体库</button>
        <button class="admin-nav" data-panel="settings">设置</button>
      </nav>
    </aside>

    <main class="admin-main">
      <div class="admin-topbar">
        <div class="admin-topbar-context">
          <button id="admin-sidebar-toggle" class="admin-icon-button" type="button" aria-label="收起侧栏" aria-expanded="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
          <span class="admin-topbar-divider" aria-hidden="true">›</span>
          <strong id="admin-page-title">概览</strong>
        </div>
        <div class="admin-topbar-actions">
          <label class="admin-global-search" aria-label="搜索设置">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
            <input id="admin-global-settings-search" type="search" placeholder="搜索设置" autocomplete="off" />
            <kbd>Ctrl K</kbd>
          </label>
          <button id="admin-search-toggle" class="admin-icon-button" type="button" aria-label="搜索设置" title="搜索设置（Ctrl+K）">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
          </button>
          <button id="admin-notification-toggle" class="admin-icon-button" type="button" aria-label="通知" title="通知">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 8h18c0-1-3-1-3-8M10 21h4" /></svg>
            <span id="admin-notification-dot" class="admin-notification-dot hidden"></span>
          </button>
          <a class="admin-icon-button" href="/" target="_blank" aria-label="访问前台" title="访问前台">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" /></svg>
          </a>
          <details class="admin-account-menu">
            <summary>
              <img id="admin-account-avatar" src="/profile.webp" alt="" />
              <span id="admin-account-name">管理员</span>
            </summary>
            <div>
              <button id="refresh-admin" type="button">刷新数据</button>
              <button id="logout-admin" class="hidden" type="button">退出登录</button>
            </div>
          </details>
        </div>
      </div>
      <p id="admin-notice" class="admin-notice" role="status" aria-live="polite"></p>

      <section id="login-panel" class="admin-panel">
        <div class="mx-auto max-w-md">
          <div class="ryu-card p-6">
            <h2 class="text-2xl font-black">登录后台</h2>
            
            <form id="login-form" class="mt-6 grid gap-4">
              <label class="form-control">
                <span class="label-text">用户名</span>
                <input class="input input-bordered rounded-xl" name="username" autocomplete="username" placeholder="admin" required />
              </label>
              <label class="form-control">
                <span class="label-text">密码</span>
                <input class="input input-bordered rounded-xl" name="password" type="password" autocomplete="current-password" placeholder="请输入密码" required />
              </label>
              <button class="ryu-btn-primary" type="submit">登录并连接 API</button>
              <p id="login-message" class="min-h-6 text-sm text-error"></p>
            </form>
          </div>
        </div>
      </section>

      <section id="dashboard-panel" class="admin-panel hidden">
        <div class="admin-stats-grid">
          {[
            ['已发布', 'totalPosts'],
            ['草稿', 'draftPosts'],
            ['评论', 'totalComments'],
            ['阅读', 'totalViews'],
            ['分类', 'totalCategories'],
            ['媒体', 'totalMedia'],
            ['媒体回收站', 'trashedMedia'],
          ].map(([label, key]) => (
            <article class="ryu-card p-5">
              <p class="text-sm text-base-content/50">{label}</p>
              <strong class="mt-2 block text-3xl" data-stat={key}>-</strong>
            </article>
          ))}
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class="ryu-card p-5">
            <h3 class="font-black">最近发布</h3>
            <div id="recent-posts" class="mt-4 grid gap-3 text-sm"></div>
          </div>
          <div class="ryu-card p-5">
            <h3 class="font-black">系统提示</h3>
            <div id="admin-alerts" class="mt-4 grid gap-3 text-sm"></div>
          </div>
        </div>
        <div class="admin-dashboard-grid mt-4">
          <div class="ryu-card p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-black">访问趋势</h3>
              <span class="text-xs text-base-content/45">近 30 天</span>
            </div>
            <div id="visit-chart" class="admin-bar-chart mt-4"></div>
          </div>
          <div class="ryu-card p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-black">发布趋势</h3>
              <span class="text-xs text-base-content/45">近 30 天</span>
            </div>
            <div id="publish-chart" class="admin-bar-chart mt-4"></div>
          </div>
          <div class="ryu-card p-5">
            <h3 class="font-black">分类分布</h3>
            <div id="category-chart" class="admin-rank-chart mt-4"></div>
          </div>
          <div class="ryu-card p-5">
            <h3 class="font-black">热门文章</h3>
            <div id="popular-posts" class="mt-4 grid gap-3 text-sm"></div>
          </div>
        </div>
      </section>

      <section id="content-center-panel" class="admin-panel hidden">
        <div class="grid gap-5">
          <header class="flex flex-wrap items-end justify-between gap-3 px-1">
            <div><p class="text-xs font-black tracking-[.18em] text-primary">PERSONAL CONTENT HUB</p><h2 class="mt-1 text-2xl font-black">导入与内容关联</h2><p class="text-sm text-base-content/50">从一个入口识别文件、记录任务，并管理订阅和跨内容关系。</p></div>
            <a class="ryu-btn btn-sm" href="/reading">继续阅读 ↗</a>
          </header>
          <section class="ryu-card p-5">
            <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
              <div><h3 class="text-xl font-black">统一导入</h3><p class="mt-1 text-sm text-base-content/50">支持 EPUB、TXT、Markdown、PDF、CBZ、ZIP 和普通媒体；先识别，再进入对应确认流程。</p>
                <label id="content-import-drop" class="mt-4 grid min-h-40 cursor-pointer place-items-center rounded-2xl border border-dashed border-base-content/20 bg-base-200/35 p-6 text-center"><span><b class="block text-lg">拖入文件或点击选择</b><small class="mt-2 block text-base-content/45">可多选；EPUB 可选择导入为图书或漫画</small></span><input id="content-import-files" class="hidden" type="file" multiple accept=".epub,.txt,.md,.markdown,.pdf,.cbz,.zip,.jpg,.jpeg,.png,.webp,.gif,.avif,.bmp,image/*,audio/*,video/*" /></label>
                <div id="content-import-queue" class="mt-3 grid gap-2"></div>
                <div class="mt-3 flex flex-wrap justify-end gap-2"><button id="content-import-clear" class="ryu-btn" type="button">清空</button><button id="content-import-start" class="ryu-btn-primary" type="button">开始处理</button></div>
              </div>
              <aside><h4 class="font-black">最近任务</h4><div id="content-import-jobs" class="mt-3 grid gap-2 text-sm"></div></aside>
            </div>
          </section>
          <div class="grid gap-5 xl:grid-cols-2">
            <section class="ryu-card p-5">
              <div><h3 class="text-xl font-black">更新订阅</h3><p class="text-sm text-base-content/50">收集小说、漫画、番剧或网页的更新入口。</p></div>
              <form id="content-subscription-form" class="mt-4 grid gap-2 sm:grid-cols-[7rem_1fr]"><select class="select select-bordered rounded-xl" name="kind"><option value="book">小说</option><option value="manga">漫画</option><option value="bangumi">番剧</option><option value="web">网页</option></select><input class="input input-bordered rounded-xl" name="title" placeholder="订阅名称" required /><input class="input input-bordered rounded-xl sm:col-span-2" name="url" type="url" placeholder="https://..." required /><button class="ryu-btn-primary sm:col-span-2" type="submit">添加订阅</button></form>
              <div id="content-subscriptions" class="mt-4 grid gap-2"></div>
            </section>
            <section class="ryu-card p-5">
              <div><h3 class="text-xl font-black">内容关系</h3><p class="text-sm text-base-content/50">例如番剧关联观后感、漫画关联文章、相册关联专题。</p></div>
              <form id="content-relation-form" class="mt-4 grid grid-cols-[7rem_1fr] gap-2"><select class="select select-bordered rounded-xl" name="source_type"><option value="article">文章</option><option value="book">书籍</option><option value="manga">漫画</option><option value="bangumi">番剧</option><option value="album">相册</option></select><select class="select select-bordered rounded-xl" name="source_id" required><option value="">选择来源内容</option></select><select class="select select-bordered rounded-xl" name="target_type"><option value="article">文章</option><option value="book">书籍</option><option value="manga">漫画</option><option value="bangumi">番剧</option><option value="album">相册</option></select><select class="select select-bordered rounded-xl" name="target_id" required><option value="">选择目标内容</option></select><select class="select select-bordered rounded-xl" name="relation_type"><option value="related">相关内容</option><option value="review">观后感</option><option value="adaptation">改编作品</option><option value="soundtrack">背景音乐</option></select><input class="input input-bordered rounded-xl" name="note" placeholder="备注（可选）" /><button class="ryu-btn-primary col-span-2" type="submit">建立关系</button></form>
              <div id="content-relations" class="mt-4 grid gap-2"></div>
            </section>
          </div>
        </div>
      </section>
      <section id="articles-panel" class="admin-panel hidden">
        <div class="ryu-card p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-2xl font-black">文章管理</h2>
              <p class="text-sm text-base-content/50">读取与写入后端 SQLite 文章表。</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <select id="status-filter" class="select select-bordered select-sm rounded-xl">
                <option value="">全部状态</option>
                <option value="published">已发布</option>
                <option value="draft">草稿</option>
              </select>
              <label class="label cursor-pointer justify-start gap-2 rounded-xl bg-base-100/60 px-3 py-1">
                <input id="trash-filter" class="checkbox checkbox-sm" type="checkbox" />
                回收站
              </label>
              <button id="batch-delete" class="ryu-btn btn-sm">批量删除</button>
              <a id="new-article" class="ryu-btn-primary btn-sm" href="/admin/write">新建文章</a>
            </div>
          </div>
          <div class="mt-5 overflow-x-auto">
            <table class="table">
              <thead>
                <tr>
                  <th><input id="select-all-articles" class="checkbox checkbox-sm" type="checkbox" /></th>
                  <th>标题</th>
                  <th>状态</th>
                  <th>分类</th>
                  <th>阅读</th>
                  <th>更新时间</th>
                  <th class="text-right">操作</th>
                </tr>
              </thead>
              <tbody id="articles-table"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="books-panel" class="admin-panel hidden">
        <section class="grid gap-4">
          <header class="flex flex-wrap items-end justify-between gap-3 px-1">
            <div><p class="text-xs font-black tracking-[0.18em] text-primary">PERSONAL LIBRARY</p><h2 class="mt-1 text-2xl font-black">书库与 EPUB</h2><p class="text-sm text-base-content/50">小说与普通文章分开管理。先预览结构，确认分卷和章节后再写入。</p></div>
            <a class="ryu-btn btn-sm" href="/books" target="_blank">查看前台书库 ↗</a>
          </header>
          <div class="grid gap-4 xl:grid-cols-[1.05fr_.95fr]">
            <section class="ryu-card p-5">
              <div class="flex flex-wrap items-center justify-between gap-3"><div><h3 class="text-xl font-black">导入本地图书</h3><p class="text-sm text-base-content/50">EPUB、TXT、Markdown 会解析为章节；PDF 保留原版式并作为文档阅读。</p></div><div class="flex flex-wrap gap-2"><label class="ryu-btn-primary btn-sm">EPUB<input id="book-epub-files" class="hidden" type="file" accept=".epub,application/epub+zip" multiple /></label><label class="ryu-btn btn-sm">TXT / Markdown<input id="book-text-files" class="hidden" type="file" accept=".txt,.md,.markdown,text/plain,text/markdown" multiple /></label><label class="ryu-btn btn-sm">PDF<input id="book-pdf-file" class="hidden" type="file" accept=".pdf,application/pdf" /></label></div></div>
              <div id="book-import-preview" class="mt-4"><p class="text-sm text-base-content/45">选择文件后会先解析，不会立即写入书库。</p></div>
            </section>
            <section class="ryu-card p-5">
              <div class="flex items-center justify-between"><div><h3 class="text-xl font-black">书籍列表</h3><p class="text-sm text-base-content/50">书籍删除后进入回收站。</p></div><button id="book-new" class="ryu-btn btn-sm" type="button">新建空书</button></div>
              <div id="admin-book-list" class="admin-personal-list mt-4"></div>
            </section>
          </div>
          <section id="book-editor-card" class="ryu-card hidden p-5">
            <form id="book-form" class="grid gap-3">
              <div class="flex items-center justify-between"><h3 class="text-xl font-black">书籍信息</h3><button id="book-editor-close" type="button">×</button></div>
              <input name="id" type="hidden" />
              <div class="grid gap-3 md:grid-cols-2"><input class="input input-bordered rounded-xl" name="title" placeholder="书名" required /><input class="input input-bordered rounded-xl" name="author" placeholder="作者" /></div>
              <div class="grid gap-3 md:grid-cols-2"><input class="input input-bordered rounded-xl" name="slug" placeholder="URL 标识" /><input class="input input-bordered rounded-xl" name="cover" placeholder="封面地址" /></div><div class="grid gap-3 md:grid-cols-3"><select class="select select-bordered rounded-xl" name="reading_mode"><option value="chapters">站内章节阅读</option><option value="document">本地文档阅读</option><option value="external">外部网站阅读</option></select><input class="input input-bordered rounded-xl md:col-span-2" name="reading_url" placeholder="阅读地址：https://... 或 /uploads/..." /></div><input class="input input-bordered rounded-xl" name="source_format" placeholder="来源格式，如 epub / txt / pdf / web" />
              <textarea class="textarea textarea-bordered rounded-xl" name="description" placeholder="简介"></textarea>
              <div class="flex justify-end gap-2"><button class="ryu-btn-primary" type="submit">保存书籍</button></div>
            </form>
            <div id="book-volume-editor" class="mt-5"></div>
          </section>
        </section>
      </section>
      <section id="series-panel" class="admin-panel hidden">
        <section class="mt-5 grid gap-4">
          <header class="flex flex-wrap items-end justify-between gap-3 px-1">
            <div>
              <p class="text-xs font-black tracking-[0.18em] text-primary">CONTENT COLLECTIONS</p>
              <h2 class="mt-1 text-2xl font-black">专题与系列</h2>
              <p class="text-sm text-base-content/50">把多篇文章组织成一本专题，并设置阅读顺序。</p>
            </div>
            <a class="ryu-btn btn-sm" href="/series" target="_blank">查看前台专题 ↗</a>
          </header>
          <div class="admin-personal-columns">
            <form id="personal-series-form" class="ryu-card grid gap-3 p-5">
              <div><h3 class="text-xl font-black">专题信息</h3><p class="text-sm text-base-content/50">先创建专题，再从文章库中编排内容。</p></div>
              <input name="id" type="hidden" />
              <input class="input input-bordered rounded-xl" name="title" maxlength="100" placeholder="专题标题" required />
              <input class="input input-bordered rounded-xl" name="slug" maxlength="120" placeholder="URL 标识（可留空）" />
              <input class="input input-bordered rounded-xl" name="cover" maxlength="500" placeholder="专题封面地址" />
              <div class="grid grid-cols-2 gap-3"><select class="select select-bordered rounded-xl" name="series_type"><option value="article">文章专题</option><option value="book">小说书籍</option><option value="project">项目时间线</option></select><input class="input input-bordered rounded-xl" name="book_id" type="number" min="1" placeholder="关联书籍 ID（小说可选）" /></div>
              <textarea class="textarea textarea-bordered min-h-28 rounded-xl" name="description" maxlength="1000" placeholder="专题介绍"></textarea>
              <div class="grid grid-cols-2 gap-3"><input class="input input-bordered rounded-xl" name="sort_order" type="number" placeholder="排序" /><select class="select select-bordered rounded-xl" name="status"><option value="published">公开</option><option value="draft">草稿</option></select></div>
              <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-sm" name="is_featured" type="checkbox" />首页展示这个专题</label>
              <div class="flex gap-2"><button class="ryu-btn-primary" type="submit">保存专题</button><button id="personal-series-reset" class="ryu-btn" type="button">新建</button></div>
            </form>
            <section class="ryu-card p-5"><div class="flex items-center justify-between"><div><h3 class="text-xl font-black">专题列表</h3><p class="text-sm text-base-content/50">选择“编辑”后即可添加文章。</p></div></div><div id="personal-series-list" class="admin-personal-list mt-4"></div></section>
          </div>
          <section class="ryu-card p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 class="text-xl font-black">文章编排</h3>
                <p id="personal-series-articles-hint" class="text-sm text-base-content/50">请先新建或选择一个专题。</p>
              </div>
              <button id="personal-series-articles-save" class="ryu-btn-primary btn-sm" type="button" disabled>保存文章顺序</button>
            </div>
            <div class="mt-4 grid gap-4 xl:grid-cols-2">
              <div class="rounded-2xl border border-base-content/10 p-4">
                <div class="flex flex-wrap items-center justify-between gap-2"><h4 class="font-black">文章库</h4><input id="personal-series-article-search" class="input input-bordered input-sm w-full rounded-xl sm:w-64" type="search" placeholder="搜索文章标题" /></div>
                <div id="personal-series-article-options" class="admin-series-article-list mt-3"></div>
              </div>
              <div class="rounded-2xl border border-base-content/10 p-4">
                <div class="flex items-center justify-between gap-2"><h4 class="font-black">已选文章</h4><span id="personal-series-article-count" class="badge badge-outline">0 篇</span></div>
                <p class="mt-1 text-xs text-base-content/45">从上到下即前台阅读顺序，可上下调整或移除。</p>
                <div id="personal-series-article-selected" class="admin-series-article-list mt-3"></div>
              </div>
            </div>
          </section>
        </section>
      </section>

      <section id="editor-panel" class="admin-panel hidden">
        <form id="article-form" class="ryu-card grid gap-5 p-5">
          <input type="hidden" name="id" />
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 id="editor-title" class="text-2xl font-black">新建文章</h2>
              <p class="text-sm text-base-content/50">Markdown 内容会由后端渲染为 HTML 并写入数据库。</p>
            </div>
            <div class="flex gap-2">
              <button class="ryu-btn btn-sm" type="button" id="reset-editor">清空</button>
              <button class="ryu-btn-primary btn-sm" type="submit">保存文章</button>
            </div>
          </div>
          <label class="form-control">
            <span class="label-text">标题</span>
            <input class="input input-bordered rounded-xl" name="title" required />
          </label>
          <div class="grid gap-4 lg:grid-cols-3">
            <label class="form-control">
              <span class="label-text">状态</span>
              <select class="select select-bordered rounded-xl" name="status">
                <option value="draft">草稿</option>
                <option value="published">发布</option>
              </select>
            </label>
            <label class="form-control">
              <span class="label-text">可见性</span>
              <select class="select select-bordered rounded-xl" name="visibility">
                <option value="public">公开</option>
                <option value="private">私密</option>
              </select>
            </label>
            <label class="form-control">
              <span class="label-text">分类</span>
              <select id="category-select" class="select select-bordered rounded-xl" name="category_id">
                <option value="">无分类</option>
              </select>
            </label>
          </div>
          <label class="form-control">
            <span class="label-text">标签</span>
            <select id="tag-select" class="select select-bordered min-h-28 rounded-xl" name="tag_ids" multiple></select>
          </label>
          <div class="ryu-card grid gap-4 p-4">
            <div>
