        <aside class="writer-right">
          <div class="writer-panel">
            <section class="writer-card">
              <h2>文章属性</h2>
              <label class="writer-field">状态
                <select id="status">
                  <option value="draft">草稿</option>
                  <option value="published">发布</option>
                </select>
              </label>
              <label class="writer-field">可见性
                <select id="visibility">
                  <option value="public">公开</option>
                  <option value="private">私密</option>
                </select>
              </label>
              <label class="writer-check"><input id="is-pinned" type="checkbox" /> 置顶</label>
              <label class="writer-check"><input id="is-recommended" type="checkbox" /> 推荐</label>
