        color: var(--muted);
        font-size: 0.76rem;
        visibility: visible;
        opacity: 1;
      }

      #article-list .writer-post-time {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      #article-list .writer-pill {
        flex: 0 0 auto;
        border-radius: 999px;
        background: #eef2ff;
        color: #3158d4;
        padding: 0.18rem 0.5rem;
        font-size: 0.68rem;
        font-weight: 900;
        line-height: 1.25;
      }

      #article-list .writer-pill.published { background: #dcfce7; color: #15803d; }
      #article-list .writer-pill.draft { background: #fef3c7; color: #b45309; }
      #article-list .writer-pill.trash { background: #fee2e2; color: #b91c1c; }

      #article-list .writer-post-menu {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem;
        visibility: visible;
        opacity: 1;
      }

      #article-list .writer-mini {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 1.95rem;
        border: 1px solid #dce4ef;
        border-radius: 0.62rem;
        background: #fff;
        color: #24324a;
        padding: 0 0.55rem;
        font-size: 0.76rem;
        font-weight: 900;
        text-decoration: none;
        transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
      }

      #article-list .writer-mini:hover {
        border-color: color-mix(in srgb, var(--primary) 32%, #dce4ef);
        background: #f3f8ff;
        color: var(--primary);
      }

      #article-list .writer-mini.danger {
        border-color: #fee2e2;
        color: var(--danger);
      }

      #article-list .writer-mini.danger:hover {
        border-color: #fecaca;
        background: #fff1f2;
        color: #dc2626;
      }

      #article-list .writer-post[data-status="trash"] .writer-mini {
        border-color: #fecaca;
        background: #fff;
      }

      #article-list .writer-post[data-status="trash"] .writer-mini:not(.danger) {
        color: #2563eb;
      }
    </style>
  </head>
  <body data-api-base={apiBase}>
    <main class="writer-shell">
      <header class="writer-topbar">
        <div class="writer-brand">
          <a class="writer-logo" href="/admin" title="返回后台">写</a>
