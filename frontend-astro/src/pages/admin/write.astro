            <input id="article-image-input" class="hidden" type="file" accept="image/*" />
            <input id="cover-file-input" class="hidden" type="file" accept="image/*" />
            <div class="writer-tool-group writer-format-tools">
              <button class="writer-tool" type="button" data-md-insert="bold" title="加粗">B</button>
              <button class="writer-tool" type="button" data-md-insert="italic" title="斜体"><em>I</em></button>
              <button class="writer-tool" type="button" data-md-insert="heading" title="标题">H</button>
              <select id="heading-level" class="writer-heading-select" title="标题等级">
                <option value="1">H1</option>
                <option value="2" selected>H2</option>
                <option value="3">H3</option>
                <option value="4">H4</option>
                <option value="5">H5</option>
                <option value="6">H6</option>
              </select>
              <span class="writer-divider"></span>
              <button class="writer-tool" type="button" data-md-insert="strike" title="删除线">S</button>
              <button class="writer-tool" type="button" data-md-insert="hr" title="分隔线">−</button>
              <span class="writer-divider"></span>
              <button class="writer-tool" type="button" data-md-insert="task" title="任务列表">☑</button>
              <button class="writer-tool" type="button" data-md-insert="ordered" title="编号列表">⑴</button>
              <button class="writer-tool" type="button" data-md-insert="unordered" title="无序列表">☷</button>
              <span class="writer-divider"></span>
              <button class="writer-tool" type="button" data-md-insert="code" title="代码块">{}</button>
              <button class="writer-tool" type="button" data-md-insert="inlineCode" title="行内代码">&lt;/&gt;</button>
              <button class="writer-tool" type="button" data-md-insert="link" title="链接">↗</button>
              <button id="insert-image-button" class="writer-tool writer-import" type="button" title="上传插图">▧</button>
              <button class="writer-tool" type="button" data-md-insert="table" title="表格">▦</button>
              <button class="writer-tool" type="button" data-md-insert="quote" title="引用">❝</button>
              <button class="writer-tool" type="button" data-md-insert="math" title="公式">Σₓ</button>
              <button class="writer-tool is-text" type="button" data-md-insert="footnote" title="脚注">脚注</button>
            </div>
            <div class="writer-tool-group writer-action-tools">
              <button id="toggle-preview" class="writer-tool is-text" type="button" title="开启/关闭预览">预览</button>
              <button id="swap-preview" class="writer-tool is-text" type="button" title="预览换边">换边</button>
              <button id="immersive-mode" class="writer-tool is-text" type="button" title="沉浸模式，Esc 退出">沉浸</button>
              <button id="import-text-button" class="writer-tool is-text writer-import" type="button" title="导入 txt/md">导入</button>
              <select id="inline-font-select" class="writer-font-select" title="选中文字后应用或移除局部字体">
                <option value="">字体</option>
              </select>
