          <div class="writer-paper-wrap">
            <article class="writer-paper">
              <input id="title" class="writer-title" placeholder="请输入文章标题" />
              <textarea id="content" class="writer-content" placeholder="从这里开始写。支持 Markdown、代码块、表格、图片、公式和脚注。"></textarea>
            </article>
            <div id="preview-resizer" class="writer-resizer" title="拖动调整预览宽度"></div>
            <article id="preview-panel" class="writer-preview"></article>
