---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getMangaChapter } from '../../../../../lib/api'
import { resolveUploadUrl } from '../../../../../lib/media'
const data=await getMangaChapter(Astro.params.slug||'',Astro.params.volume||'',Astro.params.chapter||'')
if(!data)return Astro.redirect('/404')
const {manga,chapter,navigation}=data,pages=chapter.pages||[],at=navigation.findIndex((x:any)=>x.id===chapter.id),prev=navigation[at-1],next=navigation[at+1]
const link=(x:any)=>x?`/manga/${manga.slug}/${x.volume_slug}/${x.slug}`:''
---
<BaseLayout title={chapter.title} subtitle={manga.title} showSidebar={false} showBanner={false} hideFooter hideNav fullBleed wide>
<div class="comic" data-comic data-mid={manga.id} data-vid={chapter.volume_id} data-cid={chapter.id}>
<header class="top"><a href={`/manga/${manga.slug}`}>‹</a><div><small>{chapter.volume_title}</small><b>{chapter.title}</b></div><span><i data-page-label>1</i> / {pages.length}</span></header>
<main data-stage>{pages.map((p:any,i:number)=><figure data-page data-index={i}><img src={resolveUploadUrl(p.image_url)} alt={`${chapter.title} 第 ${i+1} 页`} loading={i<2?'eager':'lazy'}/><figcaption>{i+1} / {pages.length}</figcaption></figure>)}<nav class="chapter-nav">{prev?<a href={link(prev)}>← {prev.title}</a>:<span>第一章</span>}{next?<a href={link(next)}>{next.title} →</a>:<a href={`/manga/${manga.slug}`}>返回目录 →</a>}</nav></main>
<aside class="tools"><button data-action="catalog">☷<small>目录</small></button><button data-action="mode">▣<small>翻页</small></button><button data-action="theme">◐<small>夜间</small></button><button data-action="settings"><b>Aa</b><small>设置</small></button><button data-action="fullscreen">⛶<small>全屏</small></button><button data-action="top">↑<small>顶部</small></button></aside>
<button class="trigger" data-controls>•••</button><section class="mobile" data-mobile><button data-action="catalog">☷<small>目录</small></button><button data-action="previous">←<small>上一页</small></button><button class="primary" data-action="next">→<small>下一页</small></button><button data-action="settings"><b>Aa</b><small>设置</small></button></section>
<button class="scrim" data-scrim hidden></button><aside class="catalog" data-catalog><header><div><small>{manga.title}</small><h2>全部目录</h2></div><button data-close>×</button></header><nav>{navigation.map((x:any,i:number)=><a class={x.id===chapter.id?'current':''} href={link(x)}><span>{String(i+1).padStart(2,'0')}</span><div><b>{x.title}</b><small>{x.volume_title} · {x.page_count||0} 页</small></div>{x.id===chapter.id&&<em>当前</em>}</a>)}</nav></aside>
<dialog class="settings" data-settings><form method="dialog"><header><h2>漫画阅读设置</h2><button value="cancel">×</button></header><label>阅读方式<select data-setting="mode"><option value="scroll">连续滚动</option><option value="paged">单页翻阅</option></select></label><label>页面宽度 <output data-width></output><input data-setting="width" type="range" min="560" max="1400" step="40"/></label><label>图片间距 <output data-gap></output><input data-setting="gap" type="range" min="0" max="40" step="4"/></label><label>背景<div class="themes"><button type="button" data-theme="light">浅色</button><button type="button" data-theme="paper">纸张</button><button type="button" data-theme="night">深色</button></div></label><label class="toggle">显示页码<input data-setting="numbers" type="checkbox"/></label></form></dialog><div class="toast" data-toast hidden></div>
</div></BaseLayout>
<style>
:global(html.comic-page),:global(html.comic-page body){background:#171917}.comic{--bg:#171917;--panel:#242724;--text:#edf0eb;--width:980px;--gap:12px;min-height:100vh;background:var(--bg);color:var(--text);padding:4.2rem 1rem 6rem}.comic[data-theme=light]{--bg:#eceeea;--panel:#fff;--text:#202620}.comic[data-theme=paper]{--bg:#d9d0bd;--panel:#eee5d1;--text:#332d24}.top{position:fixed;z-index:30;inset:0 0 auto;display:grid;grid-template-columns:2.5rem 1fr auto;align-items:center;gap:.7rem;height:3.7rem;border-bottom:1px solid color-mix(in srgb,var(--text) 10%,transparent);background:color-mix(in srgb,var(--bg) 88%,transparent);padding:0 max(1rem,calc((100vw - 1180px)/2));backdrop-filter:blur(18px)}.top>a{color:inherit;font-size:2rem}.top div{min-width:0}.top small,.top b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.top small{opacity:.5;font-size:.55rem}.top b{font-size:.72rem}.top span{font:.65rem ui-monospace}.top i{font-style:normal}.comic main{width:min(var(--width),100%);margin:auto}.comic figure{margin:0 0 var(--gap);background:#0e0f0e;box-shadow:0 4px 18px #0003}.comic figure img{display:block;width:100%;height:auto}.comic figcaption{padding:.3rem;background:#111;color:#fff9;text-align:center;font-size:.55rem}.comic:not(.numbers) figcaption{display:none}.comic[data-mode=paged]{display:grid;min-height:100vh;place-items:center;padding:4.2rem 4.5rem 4.5rem}.comic[data-mode=paged] figure{display:none;margin:0;background:transparent;box-shadow:none}.comic[data-mode=paged] figure.current{display:grid;place-items:center}.comic[data-mode=paged] figure img{width:auto;max-width:100%;max-height:calc(100vh - 8.7rem);object-fit:contain}.comic[data-mode=paged] .chapter-nav{display:none}.chapter-nav{display:flex;justify-content:space-between;gap:1rem;padding:2.5rem 0}.chapter-nav a{max-width:48%;color:inherit;font-size:.72rem}.chapter-nav span{opacity:.45}.tools{position:fixed;z-index:32;right:max(.7rem,calc((100vw - min(var(--width),100vw))/2 - 4.3rem));top:50%;display:grid;overflow:hidden;border:1px solid color-mix(in srgb,var(--text) 12%,transparent);border-radius:1rem;background:color-mix(in srgb,var(--panel) 92%,transparent);box-shadow:0 16px 45px #0005;transform:translateY(-50%)}.tools button{display:grid;width:3.1rem;height:3.05rem;place-items:center;border:0;border-bottom:1px solid color-mix(in srgb,var(--text) 9%,transparent);background:transparent;color:inherit}.tools small,.mobile small{display:block;font-size:.48rem;opacity:.6}.tools button.active{background:color-mix(in srgb,var(--text) 12%,transparent)}.trigger,.mobile{display:none}.scrim{position:fixed;z-index:40;inset:0;border:0;background:#05070599;backdrop-filter:blur(3px)}.catalog{position:fixed;z-index:41;inset:0 auto 0 0;width:min(390px,calc(100vw - 1.5rem));background:var(--panel);padding:1.2rem;box-shadow:22px 0 60px #0006;transform:translateX(-105%);transition:.22s}.catalog.open{transform:none}.catalog header{display:flex;justify-content:space-between;border-bottom:1px solid color-mix(in srgb,var(--text) 12%,transparent);padding:.3rem .2rem 1rem}.catalog header small{opacity:.5;font-size:.55rem}.catalog h2{margin:.2rem 0;font:650 1.65rem var(--theme-title-font)}.catalog header button{border:0;background:transparent;color:inherit;font-size:1.4rem}.catalog nav{height:calc(100vh - 5.8rem);overflow:auto;padding:.6rem 0}.catalog a{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.5rem;border-radius:.7rem;padding:.72rem;color:inherit}.catalog a:hover,.catalog a.current{background:color-mix(in srgb,var(--text) 10%,transparent)}.catalog a>span{opacity:.4;font:.6rem ui-monospace}.catalog a b,.catalog a small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.catalog a b{font-size:.72rem}.catalog a small{opacity:.48;font-size:.54rem}.catalog em{color:#75a7ff;font-size:.52rem;font-style:normal}.settings{width:min(430px,calc(100vw - 1rem));border:0;border-radius:1.2rem;background:var(--panel);color:var(--text);padding:0}.settings::backdrop{background:#05070599;backdrop-filter:blur(4px)}.settings form{padding:1.3rem}.settings header{display:flex;justify-content:space-between}.settings h2{margin:0;font:650 1.55rem var(--theme-title-font)}.settings header button{border:0;background:transparent;color:inherit;font-size:1.4rem}.settings label{display:grid;gap:.5rem;margin-top:1.15rem;font-size:.7rem}.settings select{height:2.4rem;border:1px solid color-mix(in srgb,var(--text) 15%,transparent);border-radius:.6rem;background:transparent;color:inherit}.settings input{accent-color:#75a7ff}.themes{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem}.themes button{border:1px solid color-mix(in srgb,var(--text) 15%,transparent);border-radius:.6rem;background:transparent;color:inherit;padding:.6rem}.themes button.active{border-color:#75a7ff}.settings .toggle{display:flex;justify-content:space-between}.toast{position:fixed;z-index:60;top:4.7rem;left:50%;border-radius:999px;background:#111;color:#fff;padding:.65rem 1rem;font-size:.65rem;transform:translateX(-50%)}
@media(max-width:760px){.comic{padding:3.55rem 0 4.8rem}.top{height:3.5rem;padding:0 .7rem}.comic main{width:100%}.comic figure{box-shadow:none}.tools{display:none}.trigger{position:fixed;z-index:35;right:.7rem;bottom:.8rem;display:block;width:2.8rem;height:2.8rem;border:1px solid #fff3;border-radius:50%;background:#171a18ee;color:#fff}.mobile{position:fixed;z-index:34;right:.6rem;bottom:.6rem;left:.6rem;display:grid;grid-template-columns:repeat(4,1fr);border-radius:1rem;background:#171a18f2;padding:.35rem;opacity:0;pointer-events:none;transform:translateY(130%);transition:.2s}.comic.controls .mobile{opacity:1;pointer-events:auto;transform:none}.comic.controls .trigger{display:none}.mobile button{display:grid;height:3rem;place-items:center;border:0;border-radius:.7rem;background:transparent;color:#fff}.mobile .primary{background:#fff;color:#171a18}.comic[data-mode=paged]{padding:3.7rem .25rem 4.7rem}.comic[data-mode=paged] figure img{max-height:calc(100vh - 8.4rem)}.chapter-nav{padding:1.8rem .7rem}:global([data-music-player]){z-index:36!important}}
</style>
<script>
// @ts-nocheck
import { ensurePrivateDeviceToken } from '../../../../../lib/private-device'
function init(){const r=document.querySelector('[data-comic]');if(!r||r.dataset.ready)return;r.dataset.ready='1';document.documentElement.classList.add('comic-page');const pages=[...r.querySelectorAll('[data-page]')],cat=r.querySelector('[data-catalog]'),scrim=r.querySelector('[data-scrim]'),dialog=r.querySelector('[data-settings]'),label=r.querySelector('[data-page-label]'),toast=r.querySelector('[data-toast]'),api=window.__PUBLIC_API_BASE__||'/api',mid=+r.dataset.mid,vid=+r.dataset.vid,cid=+r.dataset.cid;let current=Math.max(0,+new URLSearchParams(location.search).get('page')-1||0),revision=0,token='',timer,ct;let s={mode:'scroll',theme:'night',width:980,gap:12,numbers:false,...JSON.parse(localStorage.getItem('comic_settings')||'{}')};const headers=()=>({'Content-Type':'application/json','X-Device-Token':token}),say=x=>{toast.textContent=x;toast.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>toast.hidden=true,1500)},render=()=>{r.dataset.mode=s.mode;r.dataset.theme=s.theme;r.style.setProperty('--width',s.width+'px');r.style.setProperty('--gap',s.gap+'px');r.classList.toggle('numbers',s.numbers);pages.forEach((p,i)=>p.classList.toggle('current',i===current));label.textContent=current+1;dialog.querySelectorAll('[data-setting]').forEach(x=>x.type==='checkbox'?x.checked=!!s[x.dataset.setting]:x.value=s[x.dataset.setting]);dialog.querySelector('[data-width]').textContent=s.width+'px';dialog.querySelector('[data-gap]').textContent=s.gap+'px';dialog.querySelectorAll('[data-theme]').forEach(x=>x.classList.toggle('active',x.dataset.theme===s.theme));r.querySelectorAll('[data-action="mode"]').forEach(x=>x.classList.toggle('active',s.mode==='paged'));localStorage.setItem('comic_settings',JSON.stringify(s))},go=(n,smooth=true)=>{current=Math.max(0,Math.min(pages.length-1,n));render();if(s.mode==='scroll')pages[current]?.scrollIntoView({behavior:smooth?'smooth':'auto'});schedule()},save=async(force=false)=>{if(!token)return;try{const q=await fetch(api+'/private/manga/'+mid+'/progress',{method:'PUT',headers:headers(),body:JSON.stringify({volume_id:vid,chapter_id:cid,page_index:current,mode:s.mode,settings:s,revision,force})}),j=await q.json();if(q.status===409){if(confirm('另一台设备有更新，是否覆盖？'))save(true)}else if(q.ok)revision=j.data.revision}catch{}},schedule=()=>{clearTimeout(timer);timer=setTimeout(save,800)},drawer=x=>{cat.classList.toggle('open',x);scrim.hidden=!x},controls=x=>{r.classList.toggle('controls',x);clearTimeout(ct);if(x)ct=setTimeout(()=>controls(false),5500)};r.querySelectorAll('[data-action]').forEach(b=>b.onclick=()=>{const a=b.dataset.action;if(a==='catalog')drawer(true);if(a==='settings')dialog.showModal();if(a==='previous')go(current-1);if(a==='next')go(current+1);if(a==='mode'){s.mode=s.mode==='scroll'?'paged':'scroll';render();go(current,false);say(s.mode==='paged'?'单页翻阅':'连续滚动')}if(a==='theme'){s.theme=s.theme==='night'?'paper':'night';render()}if(a==='fullscreen'){document.fullscreenElement?document.exitFullscreen?.():document.documentElement.requestFullscreen?.()}if(a==='top')go(0);controls(false)});r.querySelector('[data-controls]').onclick=()=>controls(true);r.querySelector('[data-close]').onclick=()=>drawer(false);scrim.onclick=()=>drawer(false);dialog.querySelectorAll('[data-setting]').forEach(x=>x.oninput=()=>{s[x.dataset.setting]=x.type==='checkbox'?x.checked:x.type==='range'?+x.value:x.value;render();schedule()});dialog.querySelectorAll('[data-theme]').forEach(x=>x.onclick=()=>{s.theme=x.dataset.theme;render();schedule()});r.querySelector('[data-stage]').onclick=e=>{if(innerWidth>760||e.target.closest('a,button'))return;const x=e.clientX/innerWidth;if(s.mode==='paged'&&x<.28)go(current-1);else if(s.mode==='paged'&&x>.72)go(current+1);else controls(!r.classList.contains('controls'))};addEventListener('keydown',e=>{if(['ArrowLeft','PageUp'].includes(e.key))go(current-1);if(['ArrowRight','PageDown'].includes(e.key))go(current+1)});if('IntersectionObserver'in window){const o=new IntersectionObserver(es=>{if(s.mode!=='scroll')return;const x=es.filter(e=>e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];if(x){current=+x.target.dataset.index;render();schedule()}},{threshold:[.35,.65]});pages.forEach(p=>o.observe(p))}addEventListener('pagehide',save);(async()=>{token=await ensurePrivateDeviceToken(api);if(token)try{const q=await fetch(api+'/private/manga/'+mid+'/progress',{headers:headers()}),j=await q.json(),x=j.data;if(q.ok&&x){revision=x.revision||0;s={...s,...(x.settings||{}),mode:x.mode||s.mode};if(!location.search&&+x.chapter_id===cid)current=+x.page_index||0}}catch{}render();requestAnimationFrame(()=>go(current,false));if(innerWidth<=760)setTimeout(()=>controls(true),300)})()}
document.addEventListener('astro:page-load',init);document.addEventListener('astro:before-swap',()=>document.documentElement.classList.remove('comic-page'));init()
</script>