---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getManga } from '../../lib/api'
import { resolveUploadUrl } from '../../lib/media'
const item=await getManga(Astro.params.slug||'')
if(!item) return Astro.redirect('/404')
const isLocal=item.library_type==='local'
const volumes=item.volumes||[]
const first=volumes.flatMap((volume:any)=>(volume.chapters||[]).map((chapter:any)=>({...chapter,volume_slug:volume.slug,volume_title:volume.title}))).find((chapter:any)=>chapter.page_count>0)
const sources=[...(item.read_sources||[])].sort((a:any,b:any)=>Number(b.is_default)-Number(a.is_default)||(a.sort_order||0)-(b.sort_order||0))
const primary=sources[0]
const labels:Record<string,string>={reading:'在读',finished:'读完',planned:'想读',paused:'暂放'}
---
<BaseLayout title={item.title} subtitle={item.author||'漫画收藏'} showSidebar={false} showBanner={false} wide>
  <main class="manga-detail" data-manga-detail data-id={item.id} data-slug={item.slug}>
    <a class="manga-back" href="/manga">← 返回漫画书架</a>
    <article class="manga-hero">
      <div class="detail-cover">{item.cover?<img src={resolveUploadUrl(item.cover)} alt={item.title+'封面'} />:<span>{item.title.slice(0,1)}</span>}</div>
      <div class="detail-copy"><small>{isLocal?'LOCAL MANGA':'NETWORK MANGA'} · {labels[item.status||'reading']||'在读'}</small><h1>{item.title}</h1>{item.original_title&&item.original_title!==item.title&&<p class="original">{item.original_title}</p>}<p class="author">{item.author||'作者未填写'}{item.publication&&` · ${item.publication}`}</p><p class="description">{item.description||'这部漫画还没有简介。'}</p><dl><div><dt>{isLocal?volumes.length:(item.progress||'未记录')}</dt><dd>{isLocal?'分卷':'阅读进度'}</dd></div><div><dt>{isLocal?(item.chapter_count||0):(item.rating?Number(item.rating).toFixed(1):'—')}</dt><dd>{isLocal?'章节':'个人评分'}</dd></div><div><dt>{isLocal?'本地':sources.length}</dt><dd>{isLocal?'保存方式':'阅读源'}</dd></div></dl><div class="detail-actions">{isLocal?(first?<a class="read-primary" data-continue href={`/manga/${item.slug}/${first.volume_slug}/${first.slug}`}>开始阅读 <span>→</span></a>:<span class="no-source">暂时没有可读章节</span>):primary?<a class="read-primary" href={primary.url} target="_blank" rel="noopener noreferrer">去 {primary.name} 阅读 <span>↗</span></a>:<span class="no-source">暂未添加阅读链接</span>}{!isLocal&&item.source_url&&<a href={item.source_url} target="_blank" rel="noopener noreferrer">查看资料页</a>}</div></div>
    </article>
    {isLocal?<section class="catalog-panel" id="contents"><header><div><small>CONTENTS</small><h2>卷与章节</h2></div><span>{item.volume_count||0} 卷 · {item.chapter_count||0} 章</span></header><div class="volume-list">{volumes.map((volume:any,index:number)=><details open={index===0}><summary><span>{String(index+1).padStart(2,'0')}</span><div><strong>{volume.title}</strong><small>{volume.chapter_count||0} 章</small></div><b>⌄</b></summary><ol>{(volume.chapters||[]).map((chapter:any,chapterIndex:number)=><li><a data-chapter-id={chapter.id} href={`/manga/${item.slug}/${volume.slug}/${chapter.slug}`}><span>{String(chapterIndex+1).padStart(2,'0')}</span><strong>{chapter.title}</strong><small data-state>{chapter.page_count||0} 页</small></a></li>)}</ol></details>)}</div></section>:<section class="source-panel"><header><div><small>READING SOURCES</small><h2>选择阅读站点</h2></div><span>外部页面将在新标签页打开</span></header><div class="source-list">{sources.map((source:any,index:number)=><a href={source.url} target="_blank" rel="noopener noreferrer"><b>{String(index+1).padStart(2,'0')}</b><div><strong>{source.name}</strong><small>{source.remark||new URL(source.url).hostname}</small></div>{source.is_default&&<em>默认</em>}<span>↗</span></a>)}{!sources.length&&<p>还没有阅读源，可在后台漫画管理中添加。</p>}</div></section>}
  </main>
</BaseLayout>
<style>
.manga-detail{width:min(1080px,100%);margin:auto;padding:1rem 1rem 5rem;color:var(--ink)}.manga-back{display:inline-block;margin-bottom:1rem;color:var(--muted-ink);font-size:.7rem;font-weight:750}.manga-hero{display:grid;grid-template-columns:220px minmax(0,1fr);gap:2.6rem;align-items:center;border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*1.25);background:color-mix(in srgb,var(--surface-solid) 86%,transparent);padding:2rem 2.2rem;box-shadow:0 22px 55px rgb(20 35 25/.08)}.detail-cover{overflow:hidden;aspect-ratio:2/3;border-radius:calc(var(--theme-card-radius,18px)*.7);background:color-mix(in srgb,var(--brand) 12%,var(--surface-solid));box-shadow:0 18px 35px rgb(20 30 22/.17)}.detail-cover img{width:100%;height:100%;object-fit:cover}.detail-cover span{display:grid;width:100%;height:100%;place-items:center;font:700 4rem var(--theme-title-font)}.detail-copy>small,.catalog-panel header small,.source-panel header small{color:var(--brand);font:850 .62rem system-ui;letter-spacing:.15em}.detail-copy h1{margin:.45rem 0 .2rem;font:650 clamp(2.8rem,6vw,5rem)/1 var(--theme-title-font)}.original{color:var(--muted-ink);font-size:.73rem}.author{margin-top:.6rem;font-weight:800}.description{max-width:46rem;margin-top:1.1rem;color:var(--muted-ink);line-height:1.8;white-space:pre-line}.detail-copy dl{display:flex;gap:2.2rem;margin:1.4rem 0}.detail-copy dl div{display:grid;gap:.15rem}.detail-copy dt{font-weight:850}.detail-copy dd{color:var(--muted-ink);font-size:.6rem}.detail-actions{display:flex;align-items:center;gap:.65rem}.detail-actions a,.no-source{display:inline-flex;min-height:2.8rem;align-items:center;border:1px solid var(--line);border-radius:.75rem;padding:.7rem .9rem;color:inherit;font-size:.72rem;font-weight:800}.detail-actions .read-primary{gap:.7rem;border-color:transparent;background:var(--ink);color:var(--surface-solid)}.read-primary span{color:#cfff4f}.no-source{color:var(--muted-ink)}.catalog-panel,.source-panel{margin-top:1rem;border:1px solid var(--line);border-radius:var(--theme-card-radius,18px);background:color-mix(in srgb,var(--surface-solid) 84%,transparent);padding:1.5rem}.catalog-panel>header,.source-panel>header{display:flex;align-items:end;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid var(--line)}.catalog-panel h2,.source-panel h2{margin:.25rem 0 0;font:650 1.8rem var(--theme-title-font)}.catalog-panel>header>span,.source-panel>header>span{color:var(--muted-ink);font-size:.62rem}.volume-list{display:grid;gap:.7rem;margin-top:.8rem}.volume-list details{border-bottom:1px solid var(--line);padding-bottom:.65rem}.volume-list summary{display:grid;grid-template-columns:2rem 1fr auto;align-items:center;gap:.7rem;padding:.7rem;cursor:pointer;list-style:none}.volume-list summary>span{color:var(--muted-ink);font:700 .62rem ui-monospace}.volume-list summary div{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}.volume-list summary small{color:var(--muted-ink);font-size:.6rem}.volume-list summary>b{transition:transform .2s}.volume-list details[open] summary>b{transform:rotate(180deg)}.volume-list ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem;padding:0;list-style:none}.volume-list li a{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.55rem;border-radius:.65rem;padding:.65rem;color:inherit}.volume-list li a:hover,.volume-list li a.is-last-read{background:color-mix(in srgb,var(--brand) 9%,transparent)}.volume-list li a>span{color:var(--muted-ink);font:.62rem ui-monospace}.volume-list li strong{overflow:hidden;font-size:.72rem;text-overflow:ellipsis;white-space:nowrap}.volume-list li small{color:var(--muted-ink);font-size:.58rem}.source-list{display:grid;gap:.55rem;margin-top:.9rem}.source-list>a{display:grid;grid-template-columns:2rem minmax(0,1fr) auto auto;align-items:center;gap:.7rem;border-radius:.8rem;padding:.8rem;color:inherit}.source-list>a:hover{background:color-mix(in srgb,var(--brand) 7%,transparent)}.source-list>a>b{color:var(--muted-ink);font:700 .62rem ui-monospace}.source-list strong,.source-list small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-list small{margin-top:.15rem;color:var(--muted-ink);font-size:.6rem}.source-list em{border-radius:999px;background:color-mix(in srgb,var(--brand) 13%,transparent);padding:.25rem .4rem;color:var(--brand);font-size:.55rem;font-style:normal;font-weight:800}.source-list>p{color:var(--muted-ink);font-size:.72rem}
@media(max-width:700px){.manga-detail{padding:.5rem .65rem 3rem}.manga-hero{grid-template-columns:105px minmax(0,1fr);gap:1rem;align-items:start;padding:1rem;border-radius:18px}.detail-copy h1{font-size:1.8rem}.original{display:none}.author{font-size:.7rem}.description{grid-column:1/-1;margin-top:.6rem;font-size:.74rem}.detail-copy dl{grid-column:1/-1;gap:1rem;margin:.8rem 0}.detail-copy dt{font-size:.76rem}.detail-actions{grid-column:1/-1;align-items:stretch;flex-direction:column}.detail-actions a,.no-source{justify-content:center}.catalog-panel,.source-panel{padding:1rem}.catalog-panel>header>span,.source-panel>header>span{display:none}.volume-list ol{grid-template-columns:1fr}.volume-list li a{grid-template-columns:1.5rem minmax(0,1fr) auto}}
</style>
{isLocal&&<script>
// @ts-nocheck
import { ensurePrivateDeviceToken } from '../../lib/private-device'
async function init(){const root=document.querySelector('[data-manga-detail]');if(!root||root.dataset.ready)return;root.dataset.ready='1';const token=await ensurePrivateDeviceToken(window.__PUBLIC_API_BASE__||'/api');if(!token)return;try{const response=await fetch((window.__PUBLIC_API_BASE__||'/api')+'/private/manga/'+root.dataset.id+'/progress',{headers:{'X-Device-Token':token}}),json=await response.json(),state=json.data;if(!response.ok||!state)return;const link=root.querySelector('[data-chapter-id="'+state.chapter_id+'"]');if(!link)return;link.classList.add('is-last-read');link.closest('details').open=true;link.querySelector('[data-state]').textContent='上次第 '+(Number(state.page_index)+1)+' 页';const action=root.querySelector('[data-continue]');action.href=link.href+'?page='+(Number(state.page_index)+1);action.innerHTML='继续阅读 <span>→</span>'}catch{}}
document.addEventListener('astro:page-load',init);init()
</script>}