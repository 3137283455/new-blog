---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getMangaItems } from '../../lib/api'
import { resolveUploadUrl } from '../../lib/media'
const manga=await getMangaItems()
const local=manga.filter((item:any)=>item.library_type==='local')
const network=manga.filter((item:any)=>item.library_type!=='local')
const initial=local.length?'local':'network'
const labels:Record<string,string>={reading:'在读',finished:'读完',planned:'想读',paused:'暂放'}
---
<BaseLayout title="漫画" subtitle="本地漫画与网络收藏" showSidebar={false} showBanner={false} wide>
  <main class="manga-library" data-manga-library data-initial={initial}>
    <header class="manga-heading"><div><small>PERSONAL MANGA LIBRARY</small><h1>漫画书架</h1><p>本地漫画保存在自己的书架，网络漫画保留常用阅读入口。</p></div><dl><div><dt>{local.length}</dt><dd>本地</dd></div><div><dt>{network.length}</dt><dd>网络</dd></div></dl></header>
    <section class="library-bar"><nav aria-label="漫画类型"><button data-type="local" class={initial==='local'?'is-active':''}>本地漫画 <span>{local.length}</span></button><button data-type="network" class={initial==='network'?'is-active':''}>网络漫画 <span>{network.length}</span></button></nav><label><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" placeholder="搜索漫画或作者" data-search /></label></section>
    <section class="manga-shelf" data-grid>
      {manga.map((item:any)=>{
        const isLocal=item.library_type==='local';return <article class="manga-book" data-card data-type={isLocal?'local':'network'} data-status={item.status||'reading'} data-id={item.id} data-search={(item.title+' '+(item.original_title||'')+' '+(item.author||'')).toLowerCase()} hidden={(isLocal?'local':'network')!==initial}>
          <a class="book-cover" href={`/manga/${item.slug}`}>{item.cover?<img src={resolveUploadUrl(item.cover)} alt={item.title+'封面'} loading="lazy" />:<span>{item.title.slice(0,1)}</span>}<b>{isLocal?'本地':labels[item.status]||'网络'}</b>{isLocal&&<i data-progress-ring></i>}</a>
          <div class="book-copy"><small>{item.author||item.publication||'作者未填写'}</small><h2><a href={`/manga/${item.slug}`}>{item.title}</a></h2><p>{isLocal?`${item.volume_count||0} 卷 · ${item.chapter_count||0} 章`:(item.progress||`${(item.read_sources||[]).length} 个阅读站点`)}</p><div class="book-progress" data-progress hidden><i></i><span></span></div><a class="book-action" data-action href={`/manga/${item.slug}`}>{isLocal?'查看目录 →':'选择阅读源 ↗'}</a></div>
        </article>
      })}
    </section>
    <div class="manga-empty" data-empty hidden><strong>这里暂时没有漫画</strong><span data-empty-copy>换个关键词试试。</span></div>
  </main>
</BaseLayout>
<style>
.manga-library{width:min(1180px,100%);min-height:70vh;margin:auto;padding:1rem 1rem 5rem;color:var(--ink)}.manga-heading{display:flex;align-items:end;justify-content:space-between;padding:1.3rem 0 1.5rem;border-bottom:1px solid var(--line)}.manga-heading small{color:var(--brand);font:850 .65rem/1 system-ui;letter-spacing:.16em}.manga-heading h1{margin:.35rem 0;font:650 clamp(3rem,6vw,5rem)/1 var(--theme-title-font)}.manga-heading p{color:var(--muted-ink);font-size:.75rem}.manga-heading dl{display:flex;gap:1.4rem}.manga-heading dl div{display:grid;text-align:center}.manga-heading dt{font:650 2rem var(--theme-title-font)}.manga-heading dd{color:var(--muted-ink);font-size:.6rem}.library-bar{position:sticky;z-index:4;top:4.7rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:1rem 0 1.5rem;border:1px solid var(--line);border-radius:1rem;background:color-mix(in srgb,var(--surface-solid) 88%,transparent);padding:.45rem;box-shadow:0 12px 30px rgb(20 35 25/.06);backdrop-filter:blur(16px)}.library-bar nav{display:flex;gap:.25rem}.library-bar button{border:0;border-radius:.72rem;background:transparent;padding:.7rem .9rem;color:var(--muted-ink);font-size:.72rem;font-weight:850}.library-bar button span{margin-left:.3rem;opacity:.55}.library-bar button.is-active{background:var(--ink);color:var(--surface-solid)}.library-bar label{display:flex;width:min(20rem,36vw);align-items:center;gap:.5rem;padding:0 .65rem}.library-bar svg{width:1rem;fill:none;stroke:currentColor;stroke-width:1.8}.library-bar input{width:100%;border:0;outline:0;background:transparent;color:inherit}.manga-shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(9.5rem,1fr));gap:1.5rem 1.05rem}.manga-book[hidden]{display:none}.book-cover{position:relative;display:block;overflow:hidden;aspect-ratio:2/3;border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*.72);background:linear-gradient(145deg,color-mix(in srgb,var(--brand) 17%,var(--surface-solid)),var(--surface-solid));color:inherit;box-shadow:0 12px 28px rgb(20 35 25/.09);transition:transform .2s,box-shadow .2s}.book-cover:hover{transform:translateY(-5px);box-shadow:0 20px 38px rgb(20 35 25/.16)}.book-cover img{width:100%;height:100%;object-fit:cover}.book-cover>span{display:grid;width:100%;height:100%;place-items:center;font:700 3rem var(--theme-title-font)}.book-cover>b{position:absolute;top:.55rem;left:.55rem;border-radius:999px;background:rgb(20 28 21/.82);color:#fff;padding:.3rem .48rem;font-size:.55rem;backdrop-filter:blur(8px)}.book-cover>i{position:absolute;inset:auto .55rem .55rem;height:.22rem;overflow:hidden;border-radius:999px;background:#fff5}.book-cover>i:after{display:block;width:var(--progress,0%);height:100%;background:#cfff4f;content:''}.book-copy{padding:.7rem .12rem 0}.book-copy>small{display:block;overflow:hidden;color:var(--brand);font-size:.6rem;font-weight:850;text-overflow:ellipsis;white-space:nowrap}.book-copy h2{margin:.25rem 0;font-size:1rem;line-height:1.28}.book-copy h2 a{color:inherit}.book-copy>p{color:var(--muted-ink);font-size:.6rem}.book-action{display:inline-block;margin-top:.45rem;color:var(--ink);font-size:.61rem;font-weight:850}.book-progress{height:1rem;margin-top:.45rem;background:linear-gradient(color-mix(in srgb,var(--ink) 9%,transparent),color-mix(in srgb,var(--ink) 9%,transparent)) top/100% .22rem no-repeat}.book-progress i{display:block;width:0;height:.22rem;border-radius:999px;background:var(--brand)}.book-progress span{display:block;margin-top:.22rem;color:var(--muted-ink);font-size:.54rem}.manga-empty{min-height:15rem;border:1px dashed var(--line);border-radius:1rem;display:grid;place-content:center;gap:.4rem;text-align:center;color:var(--muted-ink)}.manga-empty strong{color:var(--ink);font:650 1.35rem var(--theme-title-font)}
@media(max-width:700px){.manga-library{padding:.4rem .7rem 3rem}.manga-heading{align-items:start;gap:1rem}.manga-heading h1{font-size:2.8rem}.manga-heading p{max-width:14rem;line-height:1.5}.manga-heading dl{gap:.7rem}.manga-heading dt{font-size:1.35rem}.library-bar{top:.55rem;align-items:stretch;flex-direction:column;margin:.7rem 0 1rem}.library-bar nav{display:grid;grid-template-columns:1fr 1fr}.library-bar button{width:100%}.library-bar label{width:100%;height:2.5rem}.manga-shelf{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem .65rem}.book-copy h2{font-size:.83rem}.book-copy>small{font-size:.54rem}.book-action{display:none}.book-cover>b{top:.35rem;left:.35rem;padding:.24rem .36rem}}
@media(max-width:420px){.manga-shelf{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script>
// @ts-nocheck
import { ensurePrivateDeviceToken } from '../../lib/private-device'
function init(){
  const root=document.querySelector('[data-manga-library]')
  if(!root||root.dataset.ready)return
  root.dataset.ready='1'
  const cards=[...root.querySelectorAll('[data-card]')],input=root.querySelector('[data-search]'),empty=root.querySelector('[data-empty]')
  let type=root.dataset.initial||'local'
  const apply=()=>{
    const q=input.value.trim().toLowerCase();let shown=0
    cards.forEach(card=>{const visible=card.dataset.type===type&&(!q||card.dataset.search.includes(q));card.hidden=!visible;if(visible)shown++})
    empty.hidden=shown>0
    empty.querySelector('[data-empty-copy]').textContent=q?'没有匹配当前关键词的漫画。':type==='local'?'从后台导入 CBZ 或 ZIP 漫画包。':'从后台检索并添加网络漫画。'
    root.querySelectorAll('[data-type]').forEach(button=>button.classList.toggle('is-active',button.dataset.type===type))
  }
  root.querySelectorAll('[data-type]').forEach(button=>button.addEventListener('click',()=>{type=button.dataset.type;apply()}))
  input.addEventListener('input',apply);apply()
  ;(async()=>{
    const token=await ensurePrivateDeviceToken(window.__PUBLIC_API_BASE__||'/api');if(!token)return
    try{
      const response=await fetch((window.__PUBLIC_API_BASE__||'/api')+'/private/manga',{headers:{'X-Device-Token':token}}),json=await response.json()
      if(!response.ok)return
      ;(json.data||[]).forEach(state=>{
        const card=root.querySelector('[data-id="'+state.id+'"]');if(!card)return
        const pages=Math.max(1,Number(state.page_count)||1),percent=Math.round(Math.max(0,Math.min(1,(Number(state.page_index)||0)/pages))*100),progress=card.querySelector('[data-progress]'),ring=card.querySelector('[data-progress-ring]'),action=card.querySelector('[data-action]')
        if(progress){progress.hidden=false;progress.querySelector('i').style.width=percent+'%';progress.querySelector('span').textContent='上次读到本章 '+percent+'%'}
        if(ring)ring.style.setProperty('--progress',percent+'%')
        if(action&&state.volume_slug&&state.chapter_slug){action.href='/manga/'+encodeURIComponent(state.slug)+'/'+encodeURIComponent(state.volume_slug)+'/'+encodeURIComponent(state.chapter_slug)+'?page='+Math.max(1,Number(state.page_index)+1);action.textContent='继续阅读 →'}
      })
    }catch{}
  })()
}
document.addEventListener('astro:page-load',init);init()
</script>