---
import BaseLayout from '../../layouts/BaseLayout.astro'
import MangaPortal from '../../components/MangaPortal.astro'
import { getMangaItems } from '../../lib/api'

const manga = await getMangaItems()
---

<BaseLayout title="漫画站" subtitle="搜索、发现与阅读本地和网络漫画" showSidebar={false} showBanner={false} wide>
  <MangaPortal manga={manga} />
</BaseLayout>
