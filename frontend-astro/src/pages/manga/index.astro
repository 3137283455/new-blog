---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getMangaItems } from '../../lib/api'
import { resolveUploadUrl } from '../../lib/media'
const manga=await getMangaItems()
const labels:Record<string,string>={reading:'在读',finished:'读完',planned:'想读',paused:'暂放'}
---
<BaseLayout title="漫画" subtitle="个人漫画收藏与外部阅读入口" showSidebar={false} showBanner={false} wide>
  <main class="manga-library" data-manga-library>
    <header class="manga-heading"><div><small>MANGA COLLECTION</small><h1>漫画</h1><p>收好想读与正在追的漫画，在熟悉的阅读站点继续。</p></div><strong>{String(manga.length).padStart(2,'0')}<span>部收藏</span></strong></header>
    <section class="manga-tools"><label><span>⌕</span><input type="search" placeholder="搜索标题、作者或简介" data-manga-search /></label><nav><button class="is-active" data-manga-filter="all">全部</button>{Object.entries(labels).map(([key,label])=><button data-manga-filter={key}>{label}</button>)}</nav></section>
    <section class="manga-grid" data-manga-grid>
      {manga.map((item:any)=><article class="manga-card" data-manga-card data-status={item.status||'reading'} data-search={(item.title+' '+(item.original_title||'')+' '+(item.author||'')+' '+(item.description||'')).toLowerCase()}>
        <a class="manga-cover" href={`/manga/${item.slug}`}>{item.cover?<img src={resolveUploadUrl(item.cover)} alt={item.title+'封面'} loading="lazy" />:<span>{item.title.slice(0,1)}</span>}<b>{labels[item.status]||'在读'}</b></a>
        <div><small>{item.author||item.publication||'作者未填写'}</small><h2><a href={`/manga/${item.slug}`}>{item.title}</a></h2><p>{item.description||'还没有添加简介。'}</p><footer><span>{item.progress||'未记录进度'}</span><a href={`/manga/${item.slug}`}>详情与阅读源 →</a></footer></div>
      </article>)}
    </section>
    <div class="manga-empty" data-manga-empty hidden><strong>没有匹配的漫画</strong><span>换一个关键词或阅读状态。</span></div>
    {!manga.length&&<div class="manga-empty"><strong>漫画架还是空的</strong><span>从后台内容中心检索并加入第一部漫画。</span><a href="/admin">前往内容中心 →</a></div>}
  </main>
</BaseLayout>
<style>
.manga-library{width:min(1180px,100%);margin:auto;padding:1rem 1rem 5rem;color:var(--ink);display:grid;gap:1rem}.manga-heading{display:flex;align-items:end;justify-content:space-between;padding:1.2rem 0 1.4rem;border-bottom:1px solid var(--line)}.manga-heading small{color:var(--brand);font:850 .65rem/1 system-ui;letter-spacing:.18em}.manga-heading h1{margin:.35rem 0;font:650 clamp(3rem,6vw,5rem)/1 var(--theme-title-font)}.manga-heading p{color:var(--muted-ink);font-size:.76rem}.manga-heading>strong{display:flex;align-items:end;gap:.45rem;font:650 2.4rem/1 var(--theme-title-font)}.manga-heading>strong span{padding-bottom:.2rem;color:var(--muted-ink);font:700 .63rem system-ui}.manga-tools{display:flex;align-items:center;justify-content:space-between;gap:1rem}.manga-tools>label{display:flex;width:min(28rem,48vw);height:2.8rem;align-items:center;gap:.6rem;border:1px solid var(--line);border-radius:.8rem;background:color-mix(in srgb,var(--surface-solid) 86%,transparent);padding:0 .8rem}.manga-tools input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:inherit}.manga-tools nav{display:flex;gap:.3rem;overflow-x:auto}.manga-tools button{flex:none;border:0;border-radius:999px;background:transparent;padding:.5rem .75rem;color:var(--muted-ink);font-size:.68rem;font-weight:800}.manga-tools button.is-active{background:var(--ink);color:var(--surface-solid)}.manga-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr));gap:1rem}.manga-card{display:grid;grid-template-columns:7.7rem minmax(0,1fr);gap:1rem;min-height:12rem;border:1px solid var(--line);border-radius:var(--theme-card-radius,18px);background:color-mix(in srgb,var(--surface-solid) 85%,transparent);padding:.75rem;box-shadow:0 12px 32px rgb(25 38 29/.06)}.manga-card[hidden]{display:none}.manga-cover{position:relative;overflow:hidden;border-radius:calc(var(--theme-card-radius,18px)*.6);background:color-mix(in srgb,var(--brand) 12%,var(--surface-solid));color:inherit;aspect-ratio:2/3}.manga-cover img{width:100%;height:100%;object-fit:cover}.manga-cover>span{display:grid;width:100%;height:100%;place-items:center;font:700 2.6rem var(--theme-title-font)}.manga-cover b{position:absolute;left:.45rem;top:.45rem;border-radius:999px;background:rgb(18 26 20/.8);color:#fff;padding:.25rem .42rem;font-size:.55rem}.manga-card>div{min-width:0;display:flex;flex-direction:column;padding:.45rem .2rem}.manga-card small{overflow:hidden;color:var(--brand);font-size:.62rem;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.manga-card h2{margin:.3rem 0;font:650 1.35rem/1.25 var(--theme-title-font)}.manga-card h2 a{color:inherit}.manga-card p{display:-webkit-box;overflow:hidden;color:var(--muted-ink);font-size:.68rem;line-height:1.6;-webkit-box-orient:vertical;-webkit-line-clamp:3}.manga-card footer{display:grid;gap:.35rem;margin-top:auto;color:var(--muted-ink);font-size:.6rem}.manga-card footer a{color:var(--ink);font-weight:800}.manga-empty{min-height:13rem;border:1px dashed var(--line);border-radius:var(--theme-card-radius,18px);display:grid;place-content:center;gap:.4rem;text-align:center;color:var(--muted-ink)}.manga-empty strong{color:var(--ink);font:650 1.3rem var(--theme-title-font)}.manga-empty a{color:var(--brand);font-weight:800}
@media(max-width:700px){.manga-library{padding:.4rem .65rem 3rem}.manga-heading{align-items:start;gap:1rem}.manga-heading h1{font-size:2.8rem}.manga-heading>strong{font-size:1.6rem}.manga-heading p{max-width:15rem;line-height:1.5}.manga-tools{align-items:stretch;flex-direction:column}.manga-tools>label{width:100%}.manga-tools nav{margin:0 -.2rem;padding:0 .2rem}.manga-grid{grid-template-columns:1fr}.manga-card{grid-template-columns:6.5rem minmax(0,1fr);min-height:10.5rem}}
</style>
<script>
// @ts-nocheck
function initManga(){const root=document.querySelector('[data-manga-library]');if(!root||root.dataset.ready)return;root.dataset.ready='1';const cards=[...root.querySelectorAll('[data-manga-card]')],input=root.querySelector('[data-manga-search]'),empty=root.querySelector('[data-manga-empty]');let filter='all';const apply=()=>{const query=input.value.trim().toLowerCase();let count=0;cards.forEach((card)=>{const visible=(filter==='all'||card.dataset.status===filter)&&(!query||card.dataset.search.includes(query));card.hidden=!visible;if(visible)count++});if(empty)empty.hidden=count>0||cards.length===0};root.querySelectorAll('[data-manga-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.mangaFilter;root.querySelectorAll('[data-manga-filter]').forEach((item)=>item.classList.toggle('is-active',item===button));apply()}));input?.addEventListener('input',apply);apply()}
document.addEventListener('astro:page-load',initManga);initManga();
</script>