und:#172019;color:white;padding:.8rem 1.2rem;border-radius:999px;box-shadow:0 14px 40px #0003}@media(max-width:1180px){.reader-shell{display:block;padding:0;border-radius:18px;overflow:clip}.reader-toc{position:fixed;display:none;z-index:70;inset:5rem auto 1rem 1rem;width:min(320px,calc(100vw - 2rem));max-height:none}.reader-toc.open{display:block}.reader-toc header [data-toc-close],.reader-main>header button{display:block}.reader-tools{position:fixed;z-index:72;top:auto;right:50%;bottom:1rem;transform:translateX(50%);display:flex}.reader-main{margin:0 auto;padding:2rem 1.5rem 7rem}.reader-shell[data-mode=paged] .reader-content{height:calc(100vh - 14rem);column-width:calc(100vw - 4rem);column-gap:2rem}}@media(max-width:600px){.reader-main{padding:1.4rem 1rem 7rem}.reader-main h1{margin:.7rem 0;font-size:clamp(1.8rem,9vw,2.6rem)}.reader-content{padding-top:2rem}.chapter-nav{gap:1rem}.chapter-nav a{max-width:48%;font-size:.85rem}.reader-tools button{width:40px;height:40px}}
