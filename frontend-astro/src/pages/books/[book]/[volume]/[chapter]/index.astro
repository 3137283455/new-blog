---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getBookChapter } from '../../../../../lib/api'
const data=await getBookChapter(Astro.params.book||'',Astro.params.volume||'',Astro.params.chapter||'')
if(!data) return Astro.redirect('/404')
const {book,chapter,navigation}=data
const index=navigation.findIndex((item:any)=>item.id===chapter.id)
const previous=navigation[index-1],next=navigation[index+1]
const volumeGroups=Array.from(navigation.reduce((groups:Map<number,any>,item:any)=>{
  if(!groups.has(item.volume_id)) groups.set(item.volume_id,{id:item.volume_id,title:item.volume_title,slug:item.volume_slug,chapters:[]})
  groups.get(item.volume_id).chapters.push(item)
  return groups
},new Map()).values())
---
<BaseLayout title={chapter.title} subtitle={book.title} showSidebar={false} showBanner={false} hideFooter wide>
  <div class="reader-shell" data-reader data-book-id={book.id} data-book-slug={book.slug} data-volume-id={chapter.volume_id} data-chapter-id={chapter.id}>
    <aside class="reader-toc" data-reader-toc>
      <header><a href={'/books/'+book.slug+'/'+chapter.volume_slug}>← {chapter.volume_title}</a><div><button type="button" data-toc-locate>定位本章</button><button type="button" data-toc-close aria-label="关闭目录">×</button></div></header>
      <h2>{book.title}</h2><p>{book.volume_count || volumeGroups.length} 卷 · {book.chapter_count || navigation.length} 章</p>
      <div class="reader-volume-list">
        {volumeGroups.map((group:any,groupIndex:number)=><section class:list={['reader-volume-group',group.id===chapter.volume_id&&'is-current']}>
          <h3><span>{String(groupIndex+1).padStart(2,'0')}</span>{group.title}</h3>
          <ol>{group.chapters.map((item:any,i:number)=><li><a class:list={[item.id===chapter.id&&'active']} aria-current={item.id===chapter.id?'page':undefined} data-reader-chapter-id={item.id} href={'/books/'+book.slug+'/'+item.volume_slug+'/'+item.slug}><span>{i+1}</span>{item.title}<small data-chapter-progress></small></a></li>)}</ol>
        </section>)}
      </div>
    </aside>
    <main class="reader-main">
      <header><button type="button" data-toc-open>目录</button><div><small>{chapter.volume_title}</small><h1>{chapter.title}</h1></div><span data-progress-label>0%</span></header>
      <article class="reader-content" data-reader-content set:html={chapter.content_html}></article>
      <nav class="chapter-nav">{previous?<a href={'/books/'+book.slug+'/'+previous.volume_slug+'/'+previous.slug}>← {previous.title}</a>:<span></span>}{next?<a href={'/books/'+book.slug+'/'+next.volume_slug+'/'+next.slug}>{next.title} →</a>:<a href={'/books/'+book.slug+'/'+chapter.volume_slug}>返回本卷目录 →</a>}</nav>
    </main>
    <div class="reader-tools">
      <button type="button" data-reader-action="toc" title="目录">☰</button>
      <button type="button" data-reader-action="bookmark" title="书签">☆</button>
      <button type="button" data-reader-action="highlight" title="高亮选中文字">▤</button>
      <button type="button" data-reader-action="note" title="笔记">✎</button>
      <button type="button" data-reader-action="annotations" title="书签与笔记">◎</button>
      <button type="button" data-reader-action="settings" title="阅读设置">Aa</button>
      <button type="button" data-reader-action="top" title="回到顶部">↑</button>
    </div>
    <dialog class="reader-settings" data-reader-settings>
      <form method="dialog"><header><h2>阅读设置</h2><button value="cancel">×</button></header>
        <label>阅读方式<select data-setting="mode"><option value="scroll">滚动</option><option value="paged">分页</option></select></label>
        <label>主题<div class="theme-choices"><button type="button" data-reader-theme="day">日间</button><button type="button" data-reader-theme="paper">纸张</button><button type="button" data-reader-theme="eye">护眼</button><button type="button" data-reader-theme="night">夜间</button></div></label>
        <label>字号<input data-setting="fontSize" type="range" min="16" max="30" value="20"/></label>
        <label>行距<input data-setting="lineHeight" type="range" min="14" max="24" value="19"/></label>
        <label>自定义背景色<input data-setting="background" type="color" value="#f4f2ea"/></label>
        <label>背景图片网址<input data-setting="backgroundImage" type="url" placeholder="https://…"/></label>
      </form>
    </dialog>
    <dialog class="reader-note" data-reader-note><form method="dialog"><header><h2 data-note-title>本章笔记</h2><button value="cancel">×</button></header><textarea placeholder="记录这一章的想法…"></textarea><footer><button type="button" data-note-save>保存私人笔记</button></footer></form></dialog>
    <dialog class="reader-note" data-reader-annotations><form method="dialog"><header><h2>书签、高亮与笔记</h2><button value="cancel">×</button></header><div data-annotation-list>正在加载…</div></form></dialog>
    <div class="reader-toast" data-reader-toast hidden></div>
  </div>
</BaseLayout>
<style>
.reader-shell{--reader-bg:#faf9f4;--reader-text:#233027;--reader-size:20px;--reader-line:1.9;min-height:calc(100vh - 6rem);background:var(--reader-bg);color:var(--reader-text);border-radius:24px;position:relative;display:grid;grid-template-columns:minmax(230px,290px) minmax(0,760px) 52px;justify-content:center;align-items:start;gap:clamp(1.25rem,3vw,3.5rem);padding:2rem clamp(1rem,2.5vw,2.5rem);overflow:visible}.reader-shell[data-theme=night]{--reader-bg:#121713;--reader-text:#dfe7df}.reader-shell[data-theme=paper]{--reader-bg:#efe4c9;--reader-text:#3e3426}.reader-shell[data-theme=eye]{--reader-bg:#dfead8;--reader-text:#26392b}.reader-toc{position:sticky;z-index:2;top:5.5rem;width:100%;max-height:calc(100vh - 7rem);overflow:auto;padding:1.2rem;background:color-mix(in srgb,var(--reader-bg) 94%,white);color:var(--reader-text);border:1px solid color-mix(in srgb,currentColor 14%,transparent);border-radius:18px;box-shadow:0 18px 45px rgba(20,35,25,.12)}.reader-toc header{display:flex;align-items:center;justify-content:space-between;gap:.6rem}.reader-toc header>div{display:flex;align-items:center;gap:.35rem}.reader-toc header a{color:inherit;font-size:.8rem;opacity:.6}.reader-toc header button{border:0;border-radius:999px;background:color-mix(in srgb,currentColor 8%,transparent);padding:.35rem .6rem;color:inherit;font-size:.7rem}.reader-toc header [data-toc-close]{display:none}.reader-toc h2{margin-top:2rem;font:600 1.35rem var(--theme-title-font)}.reader-toc p{font-size:.8rem;opacity:.5}.reader-toc ol{list-style:none;padding:0;margin-top:1rem}.reader-toc a{display:flex;gap:.7rem;padding:.65rem;color:inherit;text-decoration:none;border-radius:9px;font-size:.88rem}.reader-toc a.active{background:color-mix(in srgb,var(--brand) 15%,transparent);font-weight:700}.reader-toc a span{opacity:.4}.reader-toc a small{margin-left:auto;white-space:nowrap;color:var(--brand);font-size:.64rem;font-weight:700}.reader-toc a.is-last-read:not(.active){box-shadow:inset 3px 0 var(--brand);background:color-mix(in srgb,var(--brand) 7%,transparent)}.reader-volume-list{display:grid;gap:1rem;margin-top:1rem}.reader-volume-group{border-top:1px solid color-mix(in srgb,currentColor 10%,transparent);padding-top:.8rem}.reader-volume-group:first-child{border-top:0;padding-top:0}.reader-volume-group h3{display:flex;gap:.6rem;margin:0 0 .35rem;padding:0 .65rem;font-size:.76rem;line-height:1.4;opacity:.62}.reader-volume-group h3 span{font:700 .65rem ui-monospace,monospace;opacity:.55}.reader-volume-group.is-current h3{color:var(--brand);opacity:1}.reader-volume-group ol{margin:.25rem 0 0}.reader-main{min-width:0;width:100%;max-width:760px;margin:0;padding:2rem 0 8rem}.reader-main>header{text-align:center;border-bottom:1px solid color-mix(in srgb,currentColor 12%,transparent);padding-bottom:2.5rem}.reader-main>header button{display:none}.reader-main>header small{opacity:.5}.reader-main h1{font:600 clamp(2rem,5vw,3.4rem)/1.15 var(--theme-title-font);margin:.7rem}.reader-main>header>span{font-size:.75rem;opacity:.45}.reader-content{font-size:var(--reader-size);line-height:var(--reader-line);letter-spacing:.02em;padding-top:3rem;overflow-wrap:anywhere}.reader-content :global(p){margin:0 0 1.35em;text-indent:2em}.reader-content :global(img){max-width:100%;height:auto;display:block;margin:2rem auto}.reader-content :global(mark.reader-highlight){background:#d8f36a80;color:inherit;border-radius:.15em;padding:0 .08em}.reader-content :global(h1),.reader-content :global(h2),.reader-content :global(h3){margin:2em 0 1em;font-family:var(--theme-title-font)}.reader-shell[data-mode=paged] .reader-content{height:calc(100vh - 13rem);column-width:700px;column-gap:5rem;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory}.chapter-nav{display:flex;justify-content:space-between;gap:2rem;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent);margin-top:4rem;padding-top:2rem}.chapter-nav a{color:inherit;text-decoration:none}.reader-tools{position:sticky;z-index:3;top:calc(50vh - 9rem);display:grid;padding:.35rem;border-radius:999px;background:#172019;box-shadow:0 16px 40px rgba(20,35,25,.2)}.reader-tools button{width:42px;height:42px;border:0;background:transparent;color:white;border-radius:50%;font-weight:700}.reader-tools button:hover{background:#ffffff1f}.reader-tools button.is-active{background:var(--brand);color:white}.reader-settings,.reader-note{width:min(440px,calc(100vw - 2rem));border:0;border-radius:22px;padding:0;color:inherit}.reader-settings::backdrop,.reader-note::backdrop{background:#0e151080;backdrop-filter:blur(5px)}.reader-settings form,.reader-note form{padding:1.3rem}.reader-settings header,.reader-note header{display:flex;justify-content:space-between}.reader-settings label{display:grid;gap:.5rem;margin-top:1.2rem}.reader-settings select,.reader-settings input[type=url],.annotation-row{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 0;border-bottom:1px solid #0001}.annotation-row small{opacity:.5}.annotation-row footer button{color:var(--brand)}.annotation-row footer [data-annotation-delete]{color:#b73535}.annotation-row footer{display:flex;align-items:center;gap:.55rem}.annotation-row footer a,.annotation-row footer button{border:0;background:transparent;font-size:.72rem;text-decoration:none}.annotation-row footer a{color:var(--brand)}.reader-note textarea{padding:.7rem;border:1px solid #0002;border-radius:10px}.theme-choices{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem}.theme-choices button{padding:.65rem;border:1px solid #0002;border-radius:10px}.theme-choices button.is-active{border-color:var(--brand);background:color-mix(in srgb,var(--brand) 15%,white);color:inherit;font-weight:700}.reader-note textarea{width:100%;min-height:180px;margin-top:1rem}.reader-note footer{text-align:right}.reader-note [data-note-save]{padding:.7rem 1rem;border-radius:999px;background:#172019;color:white}.reader-toast{position:fixed;z-index:80;left:50%;top:18%;transform:translateX(-50%);background:#172019;color:white;padding:.8rem 1.2rem;border-radius:999px;box-shadow:0 14px 40px #0003}@media(max-width:1180px){.reader-shell{display:block;padding:0;border-radius:18px;overflow:clip}.reader-toc{position:fixed;display:none;z-index:70;inset:5rem auto 1rem 1rem;width:min(320px,calc(100vw - 2rem));max-height:none}.reader-toc.open{display:block}.reader-toc header [data-toc-close],.reader-main>header button{display:block}.reader-tools{position:fixed;z-index:72;top:auto;right:50%;bottom:1rem;transform:translateX(50%);display:flex}.reader-main{margin:0 auto;padding:2rem 1.5rem 7rem}.reader-shell[data-mode=paged] .reader-content{height:calc(100vh - 14rem);column-width:calc(100vw - 4rem);column-gap:2rem}}@media(max-width:600px){.reader-main{padding:1.4rem 1rem 7rem}.reader-main h1{margin:.7rem 0;font-size:clamp(1.8rem,9vw,2.6rem)}.reader-content{padding-top:2rem}.chapter-nav{gap:1rem}.chapter-nav a{max-width:48%;font-size:.85rem}.reader-tools button{width:40px;height:40px}}
</style>
<script is:inline>
  function initReader(){
    const root=document.querySelector('[data-reader]');if(!root||root.dataset.ready)return;root.dataset.ready='1';
    const api=window.__PUBLIC_API_BASE__||'/api', token=localStorage.getItem('boke_private_device_token')||'', bookId=root.dataset.bookId,bookSlug=root.dataset.bookSlug,chapterId=Number(root.dataset.chapterId),volumeId=Number(root.dataset.volumeId),requestedPosition=new URL(location.href).searchParams.get('at');
    const content=root.querySelector('[data-reader-content]'),toc=root.querySelector('[data-reader-toc]'),toast=root.querySelector('[data-reader-toast]'),settingsDialog=root.querySelector('[data-reader-settings]'),noteDialog=root.querySelector('[data-reader-note]'),annotationDialog=root.querySelector('[data-reader-annotations]');
    let revision=0,timer=0,annotations=[],bookmark=null,pendingQuote='',editingNoteId=0,settings={theme:'day',mode:'scroll',fontSize:20,lineHeight:19,background:'',backgroundImage:''};
    const headers=()=>token?{'Content-Type':'application/json','X-Device-Token':token}:{'Content-Type':'application/json'};
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const request=async(path,options={})=>{const response=await fetch(api+path,{...options,headers:{...headers(),...(options.headers||{})}});const json=await response.json().catch(()=>({}));if(!response.ok||json.success===false)throw new Error(json.message||'操作失败');return json.data};
    const say=(message)=>{toast.textContent=message;toast.hidden=false;clearTimeout(toast._timer);toast._timer=setTimeout(()=>toast.hidden=true,1800)};
    const apply=()=>{root.dataset.theme=settings.theme;root.dataset.mode=settings.mode;root.style.setProperty('--reader-size',settings.fontSize+'px');root.style.setProperty('--reader-line',String(settings.lineHeight/10));if(settings.background)root.style.setProperty('--reader-bg',settings.background);else root.style.removeProperty('--reader-bg');if(settings.backgroundImage)root.style.backgroundImage='url("'+settings.backgroundImage.replace(/"/g,'')+'")';else root.style.backgroundImage='';root.querySelectorAll('[data-setting]').forEach((el)=>{if(settings[el.dataset.setting]!=null)el.value=settings[el.dataset.setting]});root.querySelectorAll('[data-reader-theme]').forEach((button)=>button.classList.toggle('is-active',button.dataset.readerTheme===settings.theme))};
    const position=()=>{if(settings.mode==='paged')return content.scrollWidth<=content.clientWidth?0:content.scrollLeft/(content.scrollWidth-content.clientWidth);return document.documentElement.scrollHeight<=innerHeight?0:scrollY/(document.documentElement.scrollHeight-innerHeight)};
    const goToPosition=(value,smooth=true)=>{const progress=Math.max(0,Math.min(1,Number(value)||0));if(settings.mode==='paged')content.scrollTo({left:progress*Math.max(0,content.scrollWidth-content.clientWidth),behavior:smooth?'smooth':'auto'});else scrollTo({top:progress*Math.max(0,document.documentElement.scrollHeight-innerHeight),behavior:smooth?'smooth':'auto'})};
    const chapterLink=(id)=>toc.querySelector('[data-reader-chapter-id="'+Number(id)+'"]');
    const locateToc=(id=chapterId)=>{const link=chapterLink(id);if(!link)return;const tocBox=toc.getBoundingClientRect(),linkBox=link.getBoundingClientRect();toc.scrollTop+=linkBox.top-tocBox.top-(toc.clientHeight-linkBox.height)/2};
    const markTocProgress=(id,value,label='上次')=>{toc.querySelectorAll('[data-reader-chapter-id]').forEach((link)=>{const match=Number(link.dataset.readerChapterId)===Number(id);link.classList.toggle('is-last-read',match);const badge=link.querySelector('[data-chapter-progress]');if(badge)badge.textContent=match?label+' '+Math.round(Math.max(0,Math.min(1,Number(value)||0))*100)+'%':''})};
    const save=async(force=false)=>{if(!token)return;const body={volume_id:volumeId,chapter_id:chapterId,mode:settings.mode,position:position(),anchor:'',settings,revision,force};try{const r=await fetch(api+'/private/books/'+bookId+'/progress',{method:'PUT',headers:headers(),body:JSON.stringify(body)});const j=await r.json();if(r.status===409){if(confirm('另一台设备有更新。确定使用当前设备的阅读位置覆盖吗？'))return save(true);return}if(r.ok)revision=j.data.revision}catch{}};
    const schedule=()=>{clearTimeout(timer);timer=setTimeout(()=>save(),900);const progress=position(),value=Math.round(progress*100);const label=root.querySelector('[data-progress-label]');if(label)label.textContent=value+'%';markTocProgress(chapterId,progress,'本章')};
    const clearHighlights=()=>content.querySelectorAll('mark.reader-highlight').forEach((mark)=>mark.replaceWith(...mark.childNodes));
    const markQuote=(quote)=>{if(!quote)return false;const nodes=[],walker=document.createTreeWalker(content,NodeFilter.SHOW_TEXT);let node;while(node=walker.nextNode())if(!node.parentElement?.closest('mark.reader-highlight'))nodes.push(node);const full=nodes.map((item)=>item.nodeValue||'').join(''),start=full.indexOf(quote);if(start<0)return false;const end=start+quote.length;let offset=0;for(const textNode of nodes){const length=(textNode.nodeValue||'').length,nodeStart=offset,nodeEnd=offset+length;offset=nodeEnd;if(end<=nodeStart||start>=nodeEnd)continue;const range=document.createRange();range.setStart(textNode,Math.max(0,start-nodeStart));range.setEnd(textNode,Math.min(length,end-nodeStart));const mark=document.createElement('mark');mark.className='reader-highlight';try{range.surroundContents(mark)}catch{}}return true};
    const syncBookmark=()=>{const button=root.querySelector('[data-reader-action="bookmark"]');bookmark=annotations.find((item)=>item.type==='bookmark'&&item.chapter_id===chapterId&&item.status==='active')||null;button.classList.toggle('is-active',Boolean(bookmark));button.textContent=bookmark?'★':'☆';button.title=bookmark?'取消本章书签':'添加本章书签';button.setAttribute('aria-pressed',String(Boolean(bookmark)))};
    const annotationHref=(item)=>{if(!item.volume_slug||!item.chapter_slug)return '';const progress=Number(item.position?.progress),query=Number.isFinite(progress)?'?at='+Math.max(0,Math.min(1,progress)):'';return '/books/'+encodeURIComponent(bookSlug)+'/'+encodeURIComponent(item.volume_slug)+'/'+encodeURIComponent(item.chapter_slug)+query};
    const renderAnnotations=()=>{const list=annotationDialog.querySelector('[data-annotation-list]');list.innerHTML=annotations.length?annotations.map((item)=>{const progress=Math.round(Math.max(0,Math.min(1,Number(item.position?.progress)||0))*100),current=item.chapter_id===chapterId,href=annotationHref(item),kind={bookmark:'书签',highlight:'高亮',note:'笔记'}[item.type]||item.type,copy=item.note||item.quote||'本章阅读位置',location=[item.volume_title,item.chapter_title].filter(Boolean).join(' · ');return '<article class="annotation-row"><div><small>'+esc(kind)+(location?' · '+esc(location):'')+(progress?' · '+progress+'%':'')+'</small><p>'+esc(copy)+'</p></div><footer>'+(current?'<button type="button" data-annotation-jump="'+item.id+'">定位</button>':href?'<a href="'+esc(href)+'">打开</a>':'')+(item.type==='note'?'<button type="button" data-annotation-edit="'+item.id+'">编辑</button>':'')+'<button type="button" data-annotation-delete="'+item.id+'">删除</button></footer></article>'}).join(''):'<p>还没有私人标注。</p>'};
    const loadAnnotations=async()=>{if(!token)return;try{annotations=await request('/private/books/'+bookId+'/annotations')||[];clearHighlights();annotations.filter((item)=>item.type==='highlight'&&item.chapter_id===chapterId&&item.status==='active').forEach((item)=>markQuote(item.quote));syncBookmark();renderAnnotations()}catch(error){say(error.message)}};
    const toggleBookmark=async()=>{if(!token)return say('请先在后台登录一次，将此设备设为私人设备');try{if(bookmark){await request('/private/books/'+bookId+'/annotations/'+bookmark.id,{method:'DELETE'});say('本章书签已取消')}else{await request('/private/books/'+bookId+'/annotations',{method:'POST',body:JSON.stringify({type:'bookmark',volume_id:volumeId,chapter_id:chapterId,position:{progress:position()}})});say('本章书签已保存')}await loadAnnotations()}catch(error){say(error.message)}};
    const captureSelection=()=>{const selection=getSelection(),quote=selection?.toString().trim();if(quote&&selection.anchorNode&&content.contains(selection.anchorNode))pendingQuote=quote};
    const createHighlight=async()=>{if(!token)return say('高亮只在私人设备可用');captureSelection();const quote=pendingQuote;if(!quote)return say('请先选中正文中的文字');const full=content.textContent||'',index=full.indexOf(quote);try{await request('/private/books/'+bookId+'/annotations',{method:'POST',body:JSON.stringify({type:'highlight',volume_id:volumeId,chapter_id:chapterId,quote,prefix:index>=0?full.slice(Math.max(0,index-80),index):'',suffix:index>=0?full.slice(index+quote.length,index+quote.length+80):'',position:{progress:position()}})});getSelection()?.removeAllRanges();pendingQuote='';await loadAnnotations();say('高亮已保存并同步')}catch(error){say(error.message)}};
    const openNote=(item=null)=>{if(!token)return say('笔记只在私人设备可用');editingNoteId=Number(item?.id)||0;noteDialog.querySelector('[data-note-title]').textContent=item?'编辑笔记':'本章笔记';noteDialog.querySelector('textarea').value=item?.note||'';noteDialog.showModal()};
    const saveNote=async()=>{if(!token)return say('笔记只在私人设备可用');const note=noteDialog.querySelector('textarea').value.trim();if(!note)return say('请先填写笔记内容');try{if(editingNoteId)await request('/private/books/'+bookId+'/annotations/'+editingNoteId,{method:'PUT',body:JSON.stringify({note})});else await request('/private/books/'+bookId+'/annotations',{method:'POST',body:JSON.stringify({type:'note',volume_id:volumeId,chapter_id:chapterId,note,position:{progress:position()}})});noteDialog.close();editingNoteId=0;await loadAnnotations();say('笔记已保存并同步')}catch(error){say(error.message)}};
    const load=async()=>{apply();requestAnimationFrame(()=>locateToc());if(!token){if(requestedPosition!==null)requestAnimationFrame(()=>goToPosition(requestedPosition,false));return}try{const r=await fetch(api+'/private/books/'+bookId+'/progress',{headers:headers()});if(r.ok){const j=await r.json(),state=j.data;if(state){revision=state.revision||0;settings=Object.assign(settings,state.settings||{},{mode:state.mode||settings.mode});apply();markTocProgress(state.chapter_id,state.position,state.chapter_id===chapterId?'本章':'上次');requestAnimationFrame(()=>{locateToc();if(requestedPosition!==null)goToPosition(requestedPosition,false);else if(state.chapter_id===chapterId)goToPosition(state.position,false)})}else if(requestedPosition!==null)requestAnimationFrame(()=>goToPosition(requestedPosition,false))}}catch{}await loadAnnotations()};
    root.querySelectorAll('[data-reader-action]').forEach((button)=>button.addEventListener('click',async()=>{const action=button.dataset.readerAction;if(action==='toc'){toc.classList.toggle('open');if(toc.classList.contains('open'))requestAnimationFrame(()=>locateToc())}else if(action==='top')goToPosition(0);else if(action==='settings')settingsDialog.showModal();else if(action==='annotations'){if(!token)return say('此功能只在私人设备可用');await loadAnnotations();annotationDialog.showModal()}else if(action==='note')openNote();else if(action==='highlight')await createHighlight();else if(action==='bookmark')await toggleBookmark()}));
    root.querySelector('[data-toc-open]')?.addEventListener('click',()=>{toc.classList.add('open');requestAnimationFrame(()=>locateToc())});root.querySelector('[data-toc-close]')?.addEventListener('click',()=>toc.classList.remove('open'));root.querySelector('[data-toc-locate]')?.addEventListener('click',()=>locateToc());
    root.querySelectorAll('[data-reader-theme]').forEach((button)=>button.addEventListener('click',()=>{settings.theme=button.dataset.readerTheme;settings.background='';apply();schedule()}));
    root.querySelectorAll('[data-setting]').forEach((input)=>input.addEventListener('input',()=>{const key=input.dataset.setting;settings[key]=input.type==='range'?Number(input.value):input.value;apply();schedule()}));
    annotationDialog.addEventListener('click',async(event)=>{const action=event.target.closest('[data-annotation-delete],[data-annotation-edit],[data-annotation-jump]');if(!action)return;const id=Number(action.dataset.annotationDelete||action.dataset.annotationEdit||action.dataset.annotationJump),item=annotations.find((entry)=>Number(entry.id)===id);if(!item)return;if(action.dataset.annotationJump){annotationDialog.close();goToPosition(item.position?.progress);return}if(action.dataset.annotationEdit){annotationDialog.close();openNote(item);return}if(!confirm('确定删除这条标注吗？'))return;try{await request('/private/books/'+bookId+'/annotations/'+id,{method:'DELETE'});await loadAnnotations();say('标注已删除')}catch(error){say(error.message)}});
    root.querySelector('[data-note-save]')?.addEventListener('click',saveNote);content.addEventListener('mouseup',captureSelection);content.addEventListener('keyup',captureSelection);
    addEventListener('scroll',schedule,{passive:true});content.addEventListener('scroll',schedule,{passive:true});addEventListener('pagehide',()=>save());load();
  }
  document.addEventListener('astro:page-load',initReader);initReader();
</script>
