---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getBookChapter } from '../../../../../lib/api'
const data=await getBookChapter(Astro.params.book||'',Astro.params.volume||'',Astro.params.chapter||'')
if(!data) return Astro.redirect('/404')
const {book,chapter,navigation}=data
const index=navigation.findIndex((item:any)=>item.id===chapter.id)
const previous=navigation[index-1],next=navigation[index+1]
---
<BaseLayout title={chapter.title} subtitle={book.title} showSidebar={false} showBanner={false} hideFooter wide>
  <div class="reader-shell" data-reader data-book-id={book.id} data-volume-id={chapter.volume_id} data-chapter-id={chapter.id}>
    <aside class="reader-toc" data-reader-toc>
      <header><a href={'/books/'+book.slug+'/'+chapter.volume_slug}>← {chapter.volume_title}</a><button type="button" data-toc-close>×</button></header>
      <h2>{book.title}</h2><p>{chapter.volume_title}</p>
      <ol>{navigation.map((item:any,i:number)=><li><a class:list={[item.id===chapter.id&&'active']} href={'/books/'+book.slug+'/'+chapter.volume_slug+'/'+item.slug}><span>{i+1}</span>{item.title}</a></li>)}</ol>
    </aside>
    <main class="reader-main">
      <header><button type="button" data-toc-open>目录</button><div><small>{chapter.volume_title}</small><h1>{chapter.title}</h1></div><span data-progress-label>0%</span></header>
      <article class="reader-content" data-reader-content set:html={chapter.content_html}></article>
      <nav class="chapter-nav">{previous?<a href={'/books/'+book.slug+'/'+chapter.volume_slug+'/'+previous.slug}>← {previous.title}</a>:<span></span>}{next?<a href={'/books/'+book.slug+'/'+chapter.volume_slug+'/'+next.slug}>{next.title} →</a>:<a href={'/books/'+book.slug+'/'+chapter.volume_slug}>返回本卷目录 →</a>}</nav>
    </main>
    <div class="reader-tools">
      <button type="button" data-reader-action="toc" title="目录">☰</button>
      <button type="button" data-reader-action="bookmark" title="书签">☆</button>
      <button type="button" data-reader-action="highlight" title="高亮选中文字">▤</button>
      <button type="button" data-reader-action="note" title="笔记">✎</button>
      <button type="button" data-reader-action="annotations" title="书签与笔记">◎</button>
      <button type="button" data-reader-action="settings" title="阅读设置">Aa</button>
      <button type="button" data-reader-action="top" title="回到顶部">↑</button>
    </div>
    <dialog class="reader-settings" data-reader-settings>
      <form method="dialog"><header><h2>阅读设置</h2><button value="cancel">×</button></header>
        <label>阅读方式<select data-setting="mode"><option value="scroll">滚动</option><option value="paged">分页</option></select></label>
        <label>主题<div class="theme-choices"><button type="button" data-reader-theme="day">日间</button><button type="button" data-reader-theme="paper">纸张</button><button type="button" data-reader-theme="eye">护眼</button><button type="button" data-reader-theme="night">夜间</button></div></label>
        <label>字号<input data-setting="fontSize" type="range" min="16" max="30" value="20"/></label>
        <label>行距<input data-setting="lineHeight" type="range" min="14" max="24" value="19"/></label>
        <label>自定义背景色<input data-setting="background" type="color" value="#f4f2ea"/></label>
        <label>背景图片网址<input data-setting="backgroundImage" type="url" placeholder="https://…"/></label>
      </form>
    </dialog>
    <dialog class="reader-note" data-reader-note><form method="dialog"><header><h2>本章笔记</h2><button value="cancel">×</button></header><textarea placeholder="记录这一章的想法…"></textarea><footer><button type="button" data-note-save>保存私人笔记</button></footer></form></dialog>
    <dialog class="reader-note" data-reader-annotations><form method="dialog"><header><h2>书签、高亮与笔记</h2><button value="cancel">×</button></header><div data-annotation-list>正在加载…</div></form></dialog>
    <div class="reader-toast" data-reader-toast hidden></div>
  </div>
</BaseLayout>
<style>
.reader-shell{--reader-bg:#faf9f4;--reader-text:#233027;--reader-size:20px;--reader-line:1.9;min-height:calc(100vh - 6rem);background:var(--reader-bg);color:var(--reader-text);border-radius:24px;position:relative;overflow:clip}.reader-shell[data-theme=night]{--reader-bg:#121713;--reader-text:#dfe7df}.reader-shell[data-theme=paper]{--reader-bg:#efe4c9;--reader-text:#3e3426}.reader-shell[data-theme=eye]{--reader-bg:#dfead8;--reader-text:#26392b}.reader-toc{position:fixed;z-index:61;left:max(1rem,calc((100vw - 1280px)/2));top:5.2rem;width:290px;max-height:calc(100vh - 6.5rem);overflow:auto;padding:1.2rem;background:var(--reader-bg);color:var(--reader-text);border:1px solid color-mix(in srgb,currentColor 14%,transparent);border-radius:18px;box-shadow:0 24px 60px rgba(20,35,25,.16)}.reader-toc header{display:flex;justify-content:space-between}.reader-toc header a{color:inherit;font-size:.8rem;opacity:.6}.reader-toc header button{display:none}.reader-toc h2{margin-top:2rem;font:600 1.35rem var(--theme-title-font)}.reader-toc p{font-size:.8rem;opacity:.5}.reader-toc ol{list-style:none;padding:0;margin-top:1rem}.reader-toc a{display:flex;gap:.7rem;padding:.65rem;color:inherit;text-decoration:none;border-radius:9px;font-size:.88rem}.reader-toc a.active{background:color-mix(in srgb,var(--brand) 15%,transparent);font-weight:700}.reader-toc a span{opacity:.4}.reader-main{max-width:760px;margin:0 auto;padding:4rem 2.3rem 8rem}.reader-main>header{text-align:center;border-bottom:1px solid color-mix(in srgb,currentColor 12%,transparent);padding-bottom:2.5rem}.reader-main>header button{display:none}.reader-main>header small{opacity:.5}.reader-main h1{font:600 clamp(2rem,5vw,3.4rem)/1.15 var(--theme-title-font);margin:.7rem}.reader-main>header>span{font-size:.75rem;opacity:.45}.reader-content{font-size:var(--reader-size);line-height:var(--reader-line);letter-spacing:.02em;padding-top:3rem;overflow-wrap:anywhere}.reader-content :global(p){margin:0 0 1.35em;text-indent:2em}.reader-content :global(img){max-width:100%;height:auto;display:block;margin:2rem auto}.reader-content :global(mark.reader-highlight){background:#d8f36a80;color:inherit;border-radius:.15em;padding:0 .08em}.reader-content :global(h1),.reader-content :global(h2),.reader-content :global(h3){margin:2em 0 1em;font-family:var(--theme-title-font)}.reader-shell[data-mode=paged] .reader-content{height:calc(100vh - 13rem);column-width:700px;column-gap:5rem;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory}.chapter-nav{display:flex;justify-content:space-between;gap:2rem;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent);margin-top:4rem;padding-top:2rem}.chapter-nav a{color:inherit;text-decoration:none}.reader-tools{position:fixed;z-index:62;right:max(1rem,calc((100vw - 1250px)/2));top:50%;transform:translateY(-50%);display:grid;padding:.35rem;border-radius:999px;background:#172019;box-shadow:0 16px 40px rgba(20,35,25,.2)}.reader-tools button{width:42px;height:42px;border:0;background:transparent;color:white;border-radius:50%;font-weight:700}.reader-tools button:hover{background:#ffffff1f}.reader-settings,.reader-note{width:min(440px,calc(100vw - 2rem));border:0;border-radius:22px;padding:0;color:inherit}.reader-settings::backdrop,.reader-note::backdrop{background:#0e151080;backdrop-filter:blur(5px)}.reader-settings form,.reader-note form{padding:1.3rem}.reader-settings header,.reader-note header{display:flex;justify-content:space-between}.reader-settings label{display:grid;gap:.5rem;margin-top:1.2rem}.reader-settings select,.reader-settings input[type=url],.annotation-row{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 0;border-bottom:1px solid #0001}.annotation-row small{opacity:.5}.annotation-row button{color:#b73535}.reader-note textarea{padding:.7rem;border:1px solid #0002;border-radius:10px}.theme-choices{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem}.theme-choices button{padding:.65rem;border:1px solid #0002;border-radius:10px}.annotation-row{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 0;border-bottom:1px solid #0001}.annotation-row small{opacity:.5}.annotation-row button{color:#b73535}.reader-note textarea{width:100%;min-height:180px;margin-top:1rem}.reader-note footer{text-align:right}.reader-note [data-note-save]{padding:.7rem 1rem;border-radius:999px;background:#172019;color:white}.reader-toast{position:fixed;z-index:80;left:50%;top:18%;transform:translateX(-50%);background:#172019;color:white;padding:.8rem 1.2rem;border-radius:999px;box-shadow:0 14px 40px #0003}@media(max-width:1100px){.reader-toc{display:none;inset:4.5rem auto 1rem 1rem;max-height:none}.reader-toc.open{display:block}.reader-toc header button,.reader-main>header button{display:block}.reader-tools{top:auto;right:50%;bottom:1rem;transform:translateX(50%);display:flex}.reader-main{padding:2rem 1.2rem 7rem}.reader-shell{border-radius:0}.reader-shell[data-mode=paged] .reader-content{height:calc(100vh - 14rem);column-width:calc(100vw - 3rem);column-gap:2rem}}
</style>
<script is:inline>
  function initReader(){
    const root=document.querySelector('[data-reader]');if(!root||root.dataset.ready)return;root.dataset.ready='1';
    const api=window.__PUBLIC_API_BASE__||'/api', token=localStorage.getItem('boke_private_device_token')||'', bookId=root.dataset.bookId, chapterId=Number(root.dataset.chapterId),volumeId=Number(root.dataset.volumeId);
    const content=root.querySelector('[data-reader-content]'),toast=root.querySelector('[data-reader-toast]'),settingsDialog=root.querySelector('[data-reader-settings]'),noteDialog=root.querySelector('[data-reader-note]'),annotationDialog=root.querySelector('[data-reader-annotations]');
    let revision=0,timer=0,settings={theme:'day',mode:'scroll',fontSize:20,lineHeight:19,background:'',backgroundImage:''};
    const headers=()=>token?{'Content-Type':'application/json','X-Device-Token':token}:{'Content-Type':'application/json'};
    const say=(message)=>{toast.textContent=message;toast.hidden=false;clearTimeout(toast._timer);toast._timer=setTimeout(()=>toast.hidden=true,1800)};
    const apply=()=>{root.dataset.theme=settings.theme;root.dataset.mode=settings.mode;root.style.setProperty('--reader-size',settings.fontSize+'px');root.style.setProperty('--reader-line',String(settings.lineHeight/10));if(settings.background)root.style.setProperty('--reader-bg',settings.background);if(settings.backgroundImage)root.style.backgroundImage='url("'+settings.backgroundImage.replace(/"/g,'')+'")';else root.style.backgroundImage='';root.querySelectorAll('[data-setting]').forEach((el)=>{if(settings[el.dataset.setting]!=null)el.value=settings[el.dataset.setting]})};
    const position=()=>{if(settings.mode==='paged')return content.scrollWidth<=content.clientWidth?0:content.scrollLeft/(content.scrollWidth-content.clientWidth);return document.documentElement.scrollHeight<=innerHeight?0:scrollY/(document.documentElement.scrollHeight-innerHeight)};
    const save=async(force=false)=>{if(!token)return;const body={volume_id:volumeId,chapter_id:chapterId,mode:settings.mode,position:position(),anchor:'',settings,revision,force};try{const r=await fetch(api+'/private/books/'+bookId+'/progress',{method:'PUT',headers:headers(),body:JSON.stringify(body)});const j=await r.json();if(r.status===409){if(confirm('另一台设备有更新。确定使用当前设备的阅读位置覆盖吗？'))return save(true);return}if(r.ok)revision=j.data.revision}catch{}};
    const schedule=()=>{clearTimeout(timer);timer=setTimeout(()=>save(),900);const value=Math.round(position()*100);const label=root.querySelector('[data-progress-label]');if(label)label.textContent=value+'%'};
    const markQuote=(quote)=>{if(!quote||!content.textContent.includes(quote))return;const walker=document.createTreeWalker(content,NodeFilter.SHOW_TEXT);let node;while(node=walker.nextNode()){const index=node.nodeValue.indexOf(quote);if(index<0)continue;const range=document.createRange();range.setStart(node,index);range.setEnd(node,index+quote.length);const mark=document.createElement('mark');mark.className='reader-highlight';try{range.surroundContents(mark)}catch{}break}};
    const loadAnnotations=async()=>{if(!token)return;try{const r=await fetch(api+'/private/books/'+bookId+'/annotations',{headers:headers()});if(!r.ok)return;const j=await r.json(),items=j.data||[];items.filter((item)=>item.type==='highlight'&&item.chapter_id===chapterId&&item.status==='active').forEach((item)=>markQuote(item.quote));const list=annotationDialog.querySelector('[data-annotation-list]');list.innerHTML=items.length?items.map((item)=>'<article class="annotation-row"><div><small>'+({bookmark:'书签',highlight:'高亮',note:'笔记'}[item.type]||item.type)+'</small><p>'+String(item.note||item.quote||'本章位置').replace(/[&<>]/g,'')+'</p></div><button type="button" data-annotation-delete="'+item.id+'">删除</button></article>').join(''):'<p>还没有私人标注。</p>'}catch{}};
    const load=async()=>{apply();if(!token)return;try{const r=await fetch(api+'/private/books/'+bookId+'/progress',{headers:headers()});if(!r.ok)return;const j=await r.json(),state=j.data;if(!state)return;revision=state.revision||0;settings=Object.assign(settings,state.settings||{}, {mode:state.mode||settings.mode});apply();requestAnimationFrame(()=>{if(state.chapter_id===chapterId){if(settings.mode==='paged')content.scrollLeft=state.position*(content.scrollWidth-content.clientWidth);else scrollTo(0,state.position*(document.documentElement.scrollHeight-innerHeight))}})}catch{}await loadAnnotations()};
    root.querySelectorAll('[data-reader-action]').forEach((button)=>button.addEventListener('click',async()=>{const action=button.dataset.readerAction;if(action==='toc')root.querySelector('[data-reader-toc]').classList.toggle('open');if(action==='top')scrollTo({top:0,behavior:'smooth'});if(action==='settings')settingsDialog.showModal();if(action==='annotations'){if(!token)return say('此功能只在私人设备可用');annotationDialog.showModal();loadAnnotations()};if(action==='note')noteDialog.showModal();if(action==='highlight'){const selection=getSelection();const quote=selection?.toString().trim();if(!quote||!selection?.anchorNode||!content.contains(selection.anchorNode))return say('请先选中正文中的文字');if(!token)return say('高亮只在私人设备可用');const r=await fetch(api+'/private/books/'+bookId+'/annotations',{method:'POST',headers:headers(),body:JSON.stringify({type:'highlight',volume_id:volumeId,chapter_id:chapterId,quote,prefix:'',suffix:'',position:{progress:position()}})});if(r.ok){markQuote(quote);selection.removeAllRanges();say('高亮已同步')}};if(action==='bookmark'){if(!token)return say('请先在后台登录一次，将此设备设为私人设备');const r=await fetch(api+'/private/books/'+bookId+'/annotations',{method:'POST',headers:headers(),body:JSON.stringify({type:'bookmark',volume_id:volumeId,chapter_id:chapterId,position:{progress:position()}})});say(r.ok?'书签已保存':'书签保存失败')}}));
    root.querySelector('[data-toc-open]')?.addEventListener('click',()=>root.querySelector('[data-reader-toc]').classList.add('open'));root.querySelector('[data-toc-close]')?.addEventListener('click',()=>root.querySelector('[data-reader-toc]').classList.remove('open'));
    root.querySelectorAll('[data-reader-theme]').forEach((button)=>button.addEventListener('click',()=>{settings.theme=button.dataset.readerTheme;settings.background='';apply();schedule()}));
    root.querySelectorAll('[data-setting]').forEach((input)=>input.addEventListener('input',()=>{const key=input.dataset.setting;settings[key]=input.type==='range'?Number(input.value):input.value;apply();schedule()}));
        annotationDialog.addEventListener('click',async(event)=>{const button=event.target.closest('[data-annotation-delete]');if(!button)return;const r=await fetch(api+'/private/books/'+bookId+'/annotations/'+button.dataset.annotationDelete,{method:'DELETE',headers:headers()});if(r.ok)loadAnnotations()});
    root.querySelector('[data-note-save]')?.addEventListener('click',async()=>{if(!token)return say('此功能只在私人设备可用');const note=noteDialog.querySelector('textarea').value.trim();if(!note)return;const r=await fetch(api+'/private/books/'+bookId+'/annotations',{method:'POST',headers:headers(),body:JSON.stringify({type:'note',volume_id:volumeId,chapter_id:chapterId,note,position:{progress:position()}})});if(r.ok){say('笔记已保存');noteDialog.close()}});
    addEventListener('scroll',schedule,{passive:true});content.addEventListener('scroll',schedule,{passive:true});addEventListener('pagehide',()=>save());load();
  }
  document.addEventListener('astro:page-load',initReader);initReader();
</script>
