.reader-shell.is-immersive{width:100%;min-height:100vh;border-radius:0;grid-template-columns:minmax(0,var(--reader-width)) 52px;gap:clamp(1rem,3vw,3rem);padding:1.5rem clamp(1rem,4vw,4rem)}.reader-shell.is-immersive .reader-main{grid-column:1}.reader-shell.is-immersive .reader-toc{display:none}.reader-shell.is-immersive .reader-toc.open{display:block;position:fixed;z-index:75;inset:1rem auto 1rem 1rem;width:min(330px,calc(100vw - 2rem));max-height:none}.reader-shell.is-immersive .reader-toc.open [data-toc-close]{display:block}.reader-shell.is-immersive .reader-tools{grid-column:2;opacity:.3;transition:opacity .2s}.reader-shell.is-immersive .reader-tools:hover,.reader-shell.is-immersive .reader-tools:focus-within{opacity:1}.reader-shell.is-immersive .reader-main>header{padding-top:.5rem}
@media(max-width:1180px){.reader-main{max-width:min(var(--reader-width),100%)}.reader-shell.is-immersive{display:block;padding:0}.reader-shell.is-immersive .reader-main{padding:1.5rem max(1rem,calc((100vw - var(--reader-width))/2)) 6.5rem}.reader-shell.is-immersive .reader-tools{opacity:.88}}
