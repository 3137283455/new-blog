@media(max-width:1180px){
  .reader-tools{position:fixed;z-index:74;top:50%;right:max(12px,env(safe-area-inset-right));bottom:auto;transform:translateY(-50%);display:grid;max-width:none;overflow:visible;border:1px solid #ffffff18;border-radius:24px;background:color-mix(in srgb,#111a14 94%,transparent);box-shadow:0 14px 38px rgba(12,22,15,.22);backdrop-filter:blur(14px)}
  .reader-tools button{position:relative;width:42px;height:42px;flex:0 0 42px}
  .reader-tools button::after{content:attr(title);position:absolute;right:calc(100% + 10px);padding:.38rem .62rem;border-radius:8px;background:#172019;color:#fff;font-size:.7rem;font-weight:600;white-space:nowrap;opacity:0;pointer-events:none;transform:translateX(5px);transition:.16s ease}
  .reader-tools button:hover::after,.reader-tools button:focus-visible::after{opacity:1;transform:none}
}
@media(max-width:700px){
  .reader-shell{min-height:100dvh;border-radius:0;background:var(--reader-bg);overflow:visible}
  .reader-main,.reader-shell.is-immersive .reader-main{max-width:100%;padding:1.1rem clamp(1.15rem,5vw,1.5rem) 4rem}
  .reader-main>header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.75rem;padding:.5rem 0 1.15rem;text-align:left}
  .reader-main>header button{display:none}
  .reader-main>header>div{min-width:0}
  .reader-main>header small{display:block;overflow:hidden;font-size:.68rem;line-height:1.5;text-overflow:ellipsis;white-space:nowrap}
  .reader-main h1{overflow:visible;margin:.28rem 0 0;font-size:clamp(1.55rem,7vw,2rem);line-height:1.3;white-space:normal}
  .reader-main>header>span{align-self:end;padding-bottom:.35rem;font-size:.72rem}
  .reader-content{padding-top:1.65rem;font-size:clamp(17px,calc(var(--reader-size) * .92),22px);line-height:max(1.75,var(--reader-line));letter-spacing:.01em}
  .reader-content :global(p){margin-bottom:1.3em;text-align:left;text-indent:2em}
  .reader-content :global(img){margin:1.4rem auto;border-radius:6px}
  .chapter-nav{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:2.8rem;padding-top:1rem}
