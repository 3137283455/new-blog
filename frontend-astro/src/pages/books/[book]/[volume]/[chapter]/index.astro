    const say=(message)=>{toast.textContent=message;toast.hidden=false;clearTimeout(toast._timer);toast._timer=setTimeout(()=>toast.hidden=true,1800)};
    const setControls=(open,autoHide=true)=>{const visible=Boolean(open)&&innerWidth<=700;root.classList.toggle('controls-open',visible);controls.setAttribute('aria-expanded',String(visible));controls.setAttribute('aria-label',visible?'收起阅读工具':'展开阅读工具');root.querySelectorAll('.reader-mobile-topbar,.reader-mobile-bottombar').forEach((bar)=>bar.setAttribute('aria-hidden',String(!visible)));controlOriginY=scrollY;clearTimeout(controlTimer);if(visible&&autoHide)controlTimer=setTimeout(()=>setControls(false),6500)};
    const setToc=(open)=>{toc.classList.toggle('open',Boolean(open));scrim.hidden=!open;document.documentElement.classList.toggle('reader-toc-open',Boolean(open));if(open){setControls(false);requestAnimationFrame(()=>locateToc())}};
    const apply=()=>{root.dataset.theme=settings.theme;root.dataset.mode=settings.mode;root.style.setProperty('--reader-size',settings.fontSize+'px');root.style.setProperty('--reader-line',String(settings.lineHeight/10));root.style.setProperty('--reader-width',Math.max(600,Math.min(960,Number(settings.contentWidth)||760))+'px');if(settings.background)root.style.setProperty('--reader-bg',settings.background);else root.style.removeProperty('--reader-bg');if(settings.backgroundImage)root.style.backgroundImage='linear-gradient(color-mix(in srgb,var(--reader-bg) 86%,transparent),color-mix(in srgb,var(--reader-bg) 86%,transparent)),url("'+settings.backgroundImage.replace(/"/g,'')+'")';else root.style.backgroundImage='';root.classList.toggle('is-immersive',Boolean(settings.immersive));document.documentElement.classList.toggle('reader-immersive',Boolean(settings.immersive));root.querySelectorAll('[data-setting]').forEach((el)=>{if(settings[el.dataset.setting]!=null){if(el.type==='checkbox')el.checked=Boolean(settings[el.dataset.setting]);else el.value=settings[el.dataset.setting]}});root.querySelectorAll('[data-reader-theme]').forEach((button)=>button.classList.toggle('is-active',button.dataset.readerTheme===settings.theme));const immersiveButton=root.querySelector('[data-reader-action="immersive"]');immersiveButton.classList.toggle('is-active',Boolean(settings.immersive));immersiveButton.setAttribute('aria-pressed',String(Boolean(settings.immersive)));immersiveButton.title=settings.immersive?'退出沉浸阅读':'沉浸阅读';root.querySelectorAll('[data-reader-action="quick-theme"]').forEach((button)=>{button.classList.toggle('is-active',settings.theme==='night');const label=button.querySelector('small');if(label)label.textContent=settings.theme==='night'?'日间':'夜间'})};
    const position=()=>{if(settings.mode==='paged')return content.scrollWidth<=content.clientWidth?0:content.scrollLeft/(content.scrollWidth-content.clientWidth);return document.documentElement.scrollHeight<=innerHeight?0:scrollY/(document.documentElement.scrollHeight-innerHeight)};
    const goToPosition=(value,smooth=true)=>{const progress=Math.max(0,Math.min(1,Number(value)||0));if(settings.mode==='paged')content.scrollTo({left:progress*Math.max(0,content.scrollWidth-content.clientWidth),behavior:smooth?'smooth':'auto'});else scrollTo({top:progress*Math.max(0,document.documentElement.scrollHeight-innerHeight),behavior:smooth?'smooth':'auto'})};
    const chapterLink=(id)=>toc.querySelector('[data-reader-chapter-id="'+Number(id)+'"]');
    const locateToc=(id=chapterId)=>{const link=chapterLink(id);if(!link)return;const tocBox=toc.getBoundingClientRect(),linkBox=link.getBoundingClientRect();toc.scrollTop+=linkBox.top-tocBox.top-(toc.clientHeight-linkBox.height)/2};
    const markTocProgress=(id,value,label='上次')=>{toc.querySelectorAll('[data-reader-chapter-id]').forEach((link)=>{const match=Number(link.dataset.readerChapterId)===Number(id);link.classList.toggle('is-last-read',match);const badge=link.querySelector('[data-chapter-progress]');if(badge)badge.textContent=match?label+' '+Math.round(Math.max(0,Math.min(1,Number(value)||0))*100)+'%':''})};
    const save=async(force=false)=>{if(!token)return;const body={volume_id:volumeId,chapter_id:chapterId,mode:settings.mode,position:position(),anchor:'',settings,revision,force};try{const r=await fetch(api+'/private/books/'+bookId+'/progress',{method:'PUT',headers:headers(),body:JSON.stringify(body)});const j=await r.json();if(r.status===409){if(confirm('另一台设备有更新。确定使用当前设备的阅读位置覆盖吗？'))return save(true);return}if(r.ok)revision=j.data.revision}catch{}};
    const schedule=()=>{clearTimeout(timer);timer=setTimeout(()=>save(),900);const progress=position(),value=Math.round(progress*100);const label=root.querySelector('[data-progress-label]');if(label)label.textContent=value+'%';const mobileProgress=root.querySelector('[data-mobile-progress]');if(mobileProgress&&document.activeElement!==mobileProgress)mobileProgress.value=String(value);markTocProgress(chapterId,progress,'本章')};
    const clearHighlights=()=>content.querySelectorAll('mark.reader-highlight').forEach((mark)=>mark.replaceWith(...mark.childNodes));
    const markQuote=(quote)=>{if(!quote)return false;const nodes=[],walker=document.createTreeWalker(content,NodeFilter.SHOW_TEXT);let node;while(node=walker.nextNode())if(!node.parentElement?.closest('mark.reader-highlight'))nodes.push(node);const full=nodes.map((item)=>item.nodeValue||'').join(''),start=full.indexOf(quote);if(start<0)return false;const end=start+quote.length;let offset=0;for(const textNode of nodes){const length=(textNode.nodeValue||'').length,nodeStart=offset,nodeEnd=offset+length;offset=nodeEnd;if(end<=nodeStart||start>=nodeEnd)continue;const range=document.createRange();range.setStart(textNode,Math.max(0,start-nodeStart));range.setEnd(textNode,Math.min(length,end-nodeStart));const mark=document.createElement('mark');mark.className='reader-highlight';try{range.surroundContents(mark)}catch{}}return true};
    const syncBookmark=()=>{const buttons=root.querySelectorAll('[data-reader-action="bookmark"]');bookmark=annotations.find((item)=>item.type==='bookmark'&&item.chapter_id===chapterId&&item.status==='active')||null;buttons.forEach((button)=>{button.classList.toggle('is-active',Boolean(bookmark));button.textContent=bookmark?'★':'☆';button.title=bookmark?'取消本章书签':'添加本章书签';button.setAttribute('aria-pressed',String(Boolean(bookmark)))})};
    const annotationHref=(item)=>{if(!item.volume_slug||!item.chapter_slug)return '';const progress=Number(item.position?.progress),query=Number.isFinite(progress)?'?at='+Math.max(0,Math.min(1,progress)):'';return '/books/'+encodeURIComponent(bookSlug)+'/'+encodeURIComponent(item.volume_slug)+'/'+encodeURIComponent(item.chapter_slug)+query};
    const renderAnnotations=()=>{const list=annotationDialog.querySelector('[data-annotation-list]'),count=annotationDialog.querySelector('[data-annotation-count]');if(count)count.textContent=annotations.length+' 条私人记录';list.innerHTML=annotations.length?annotations.map((item)=>{const progress=Math.round(Math.max(0,Math.min(1,Number(item.position?.progress)||0))*100),current=item.chapter_id===chapterId,href=annotationHref(item),kind={bookmark:'书签',highlight:'高亮',note:'笔记'}[item.type]||item.type,copy=item.note||item.quote||'本章阅读位置',location=[item.volume_title,item.chapter_title].filter(Boolean).join(' · ');return '<article class="annotation-row annotation-type-'+esc(item.type)+'"><div class="annotation-copy"><small><b>'+esc(kind)+'</b><span>'+(location?esc(location):'当前章节')+(progress?' · '+progress+'%':'')+'</span></small><p>'+esc(copy)+'</p></div><footer>'+(current?'<button type="button" data-annotation-jump="'+item.id+'">定位</button>':href?'<a href="'+esc(href)+'">打开</a>':'')+(item.type==='note'?'<button type="button" data-annotation-edit="'+item.id+'">编辑</button>':'')+'<button type="button" data-annotation-delete="'+item.id+'">删除</button></footer></article>'}).join(''):'<div class="annotation-empty"><b>还没有私人记录</b><span>添加书签、选择文字高亮或写下笔记后，会集中显示在这里。</span></div>'};
    const loadAnnotations=async()=>{if(!token)return;try{annotations=await request('/private/books/'+bookId+'/annotations')||[];clearHighlights();annotations.filter((item)=>item.type==='highlight'&&item.chapter_id===chapterId&&item.status==='active').forEach((item)=>markQuote(item.quote));syncBookmark();renderAnnotations()}catch(error){say(error.message)}};
    const toggleBookmark=async()=>{if(!token)return say('请先在后台登录一次，将此设备设为私人设备');try{if(bookmark){await request('/private/books/'+bookId+'/annotations/'+bookmark.id,{method:'DELETE'});say('本章书签已取消')}else{await request('/private/books/'+bookId+'/annotations',{method:'POST',body:JSON.stringify({type:'bookmark',volume_id:volumeId,chapter_id:chapterId,position:{progress:position()}})});say('本章书签已保存')}await loadAnnotations()}catch(error){say(error.message)}};
    const hideSelectionMenu=()=>{selectionMenu.hidden=true};
    const captureSelection=()=>{const selection=getSelection(),quote=selection?.toString().trim();if(!quote||!selection.anchorNode||!content.contains(selection.anchorNode)){hideSelectionMenu();return}pendingQuote=quote;const rect=selection.rangeCount?selection.getRangeAt(0).getBoundingClientRect():null;if(!rect)return;selectionMenu.hidden=false;selectionMenu.style.left=Math.max(86,Math.min(innerWidth-86,rect.left+rect.width/2))+'px';selectionMenu.style.top=Math.max(58,rect.top-10)+'px';setControls(false)};
    const createHighlight=async()=>{if(!token)return say('高亮只在私人设备可用');captureSelection();const quote=pendingQuote;if(!quote)return say('请先选中正文中的文字');const full=content.textContent||'',index=full.indexOf(quote);try{await request('/private/books/'+bookId+'/annotations',{method:'POST',body:JSON.stringify({type:'highlight',volume_id:volumeId,chapter_id:chapterId,quote,prefix:index>=0?full.slice(Math.max(0,index-80),index):'',suffix:index>=0?full.slice(index+quote.length,index+quote.length+80):'',position:{progress:position()}})});getSelection()?.removeAllRanges();pendingQuote='';await loadAnnotations();say('高亮已保存并同步')}catch(error){say(error.message)}};
    const openNote=(item=null)=>{if(!token)return say('笔记只在私人设备可用');editingNoteId=Number(item?.id)||0;noteDialog.querySelector('[data-note-title]').textContent=item?'编辑笔记':'本章笔记';noteDialog.querySelector('textarea').value=item?.note||'';noteDialog.showModal()};
    const saveNote=async()=>{if(!token)return say('笔记只在私人设备可用');const note=noteDialog.querySelector('textarea').value.trim();if(!note)return say('请先填写笔记内容');try{if(editingNoteId)await request('/private/books/'+bookId+'/annotations/'+editingNoteId,{method:'PUT',body:JSON.stringify({note})});else await request('/private/books/'+bookId+'/annotations',{method:'POST',body:JSON.stringify({type:'note',volume_id:volumeId,chapter_id:chapterId,note,position:{progress:position()}})});noteDialog.close();editingNoteId=0;await loadAnnotations();say('笔记已保存并同步')}catch(error){say(error.message)}};
    const load=async()=>{apply();requestAnimationFrame(()=>locateToc());if(!token){if(requestedPosition!==null)requestAnimationFrame(()=>goToPosition(requestedPosition,false));return}try{const r=await fetch(api+'/private/books/'+bookId+'/progress',{headers:headers()});if(r.ok){const j=await r.json(),state=j.data;if(state){revision=state.revision||0;settings=Object.assign(settings,state.settings||{},{mode:state.mode||settings.mode});apply();markTocProgress(state.chapter_id,state.position,state.chapter_id===chapterId?'本章':'上次');requestAnimationFrame(()=>{locateToc();if(requestedPosition!==null)goToPosition(requestedPosition,false);else if(state.chapter_id===chapterId)goToPosition(state.position,false)})}else if(requestedPosition!==null)requestAnimationFrame(()=>goToPosition(requestedPosition,false))}}catch{}await loadAnnotations()};
    root.querySelectorAll('[data-reader-action]').forEach((button)=>button.addEventListener('click',async()=>{const action=button.dataset.readerAction;if(action==='toc')setToc(!toc.classList.contains('open'));else if(action==='top'){goToPosition(0);setControls(false)}else if(action==='settings'){setControls(false);settingsDialog.showModal()}else if(action==='quick-theme'){settings.theme=settings.theme==='night'?'paper':'night';settings.background='';apply();schedule();setControls(true)}else if(action==='immersive'){settings.immersive=!settings.immersive;setToc(false);setControls(false);apply();schedule();say(settings.immersive?'已进入沉浸阅读，按 Esc 退出':'已退出沉浸阅读')}else if(action==='annotations'){setToc(false);setControls(false);if(!token)return say('此功能只在私人设备可用');await loadAnnotations();annotationDialog.showModal()}else if(action==='note'){setControls(false);openNote()}else if(action==='highlight'){await createHighlight();setControls(false)}else if(action==='bookmark'){await toggleBookmark();setControls(true)}}));
    controls.addEventListener('click',()=>setControls(!root.classList.contains('controls-open')));scrim.addEventListener('click',()=>setToc(false));
    root.querySelector('[data-mobile-progress]')?.addEventListener('input',(event)=>goToPosition(Number(event.target.value)/100,false));
    root.querySelector('[data-toc-open]')?.addEventListener('click',()=>setToc(true));root.querySelector('[data-toc-close]')?.addEventListener('click',()=>setToc(false));root.querySelector('[data-toc-locate]')?.addEventListener('click',()=>locateToc());
    root.querySelector('[data-toc-annotations]')?.addEventListener('click',async()=>{setToc(false);if(!token)return say('此功能只在私人设备可用');await loadAnnotations();annotationDialog.showModal()});
    root.querySelector('[data-toc-search]')?.addEventListener('input',(event)=>{const query=event.target.value.trim().toLowerCase();toc.querySelectorAll('.reader-volume-group').forEach((group)=>{let visible=0;group.querySelectorAll('li').forEach((item)=>{const match=!query||item.textContent.toLowerCase().includes(query);item.hidden=!match;if(match)visible++});group.hidden=visible===0})});
    root.querySelectorAll('[data-reader-theme]').forEach((button)=>button.addEventListener('click',()=>{settings.theme=button.dataset.readerTheme;settings.background='';apply();schedule()}));
    root.querySelectorAll('[data-setting]').forEach((input)=>input.addEventListener('input',()=>{const key=input.dataset.setting;settings[key]=input.type==='checkbox'?input.checked:input.type==='range'?Number(input.value):input.value;apply();schedule()}));
    annotationDialog.addEventListener('click',async(event)=>{const action=event.target.closest('[data-annotation-delete],[data-annotation-edit],[data-annotation-jump]');if(!action)return;const id=Number(action.dataset.annotationDelete||action.dataset.annotationEdit||action.dataset.annotationJump),item=annotations.find((entry)=>Number(entry.id)===id);if(!item)return;if(action.dataset.annotationJump){annotationDialog.close();goToPosition(item.position?.progress);return}if(action.dataset.annotationEdit){annotationDialog.close();openNote(item);return}if(!confirm('确定删除这条标注吗？'))return;try{await request('/private/books/'+bookId+'/annotations/'+id,{method:'DELETE'});await loadAnnotations();say('标注已删除')}catch(error){say(error.message)}});
    root.querySelector('[data-note-save]')?.addEventListener('click',saveNote);content.addEventListener('mouseup',captureSelection);content.addEventListener('keyup',captureSelection);content.addEventListener('touchend',()=>setTimeout(captureSelection,80),{passive:true});
    selectionMenu.addEventListener('click',async(event)=>{const action=event.target.closest('[data-selection-action]')?.dataset.selectionAction;if(!action)return;if(action==='copy'){try{await navigator.clipboard.writeText(pendingQuote);say('已复制选中文字')}catch{say('复制失败，请长按使用系统复制')}}else if(action==='highlight')await createHighlight();else if(action==='note'){const quote=pendingQuote;openNote();if(token&&quote)noteDialog.querySelector('textarea').value='引用：'+quote+'\n\n'}hideSelectionMenu();getSelection()?.removeAllRanges()});
    content.addEventListener('click',(event)=>{if(innerWidth>700||event.target.closest('a,button,input,select,textarea,mark')||getSelection()?.toString().trim())return;const ratio=event.clientX/innerWidth;if(ratio>.2&&ratio<.8)setControls(!root.classList.contains('controls-open'))});
    addEventListener('keydown',(event)=>{if(event.key!=='Escape')return;if(toc.classList.contains('open'))return setToc(false);if(root.classList.contains('controls-open'))return setControls(false);if(settings.immersive){settings.immersive=false;apply();schedule();say('已退出沉浸阅读')}});
    addEventListener('resize',()=>{if(innerWidth>700)setControls(false)});
    addEventListener('scroll',()=>{schedule();hideSelectionMenu();if(root.classList.contains('controls-open')&&Math.abs(scrollY-controlOriginY)>72)setControls(false)},{passive:true});content.addEventListener('scroll',schedule,{passive:true});addEventListener('pagehide',()=>save());load();if(innerWidth<=700)setTimeout(()=>setControls(true),300);
  }
  document.addEventListener('astro:page-load',initReader);document.addEventListener('astro:before-swap',()=>document.documentElement.classList.remove('reader-immersive','reader-toc-open','reader-page-active'));initReader();
</script>
