---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getBook, getBookVolume } from '../../../lib/api'
import { resolveUploadUrl } from '../../../lib/media'

const slug=Astro.params.book||''
const book=await getBook(slug)
if(!book) return Astro.redirect('/404')
const volumes=(await Promise.all((book.volumes||[]).map(async(volume:any)=>{
  const detail=await getBookVolume(book.slug,volume.slug)
  return detail?.volume||volume
}))).filter(Boolean)
const chapterCount=volumes.reduce((sum:number,volume:any)=>sum+(volume.chapters?.length||0),0)
const first=volumes.find((volume:any)=>volume.chapters?.length)?.chapters?.[0]
const firstVolume=volumes.find((volume:any)=>volume.chapters?.length)
---
<BaseLayout title={`${book.title} · 全书目录`} subtitle="选择章节继续阅读" showSidebar={false} showBanner={false} wide>
  <main class="contents-page" data-book-contents data-book-id={book.id} data-book-slug={book.slug}>
    <header class="contents-hero">
      <a class="contents-back" href={'/books/'+book.slug}>← 返回书籍详情</a>
      <div class="contents-cover">{book.cover?<img src={resolveUploadUrl(book.cover)} alt="" />:<span>{book.title.slice(0,1)}</span>}</div>
      <div class="contents-intro"><small>BOOK CONTENTS</small><h1>{book.title}</h1><p>{book.author||'作者未填写'}</p><div><span>{volumes.length} 卷</span><span>{chapterCount||book.chapter_count||0} 章</span></div></div>
      {first&&firstVolume&&<a class="contents-start" href={'/books/'+book.slug+'/'+firstVolume.slug+'/'+first.slug} data-continue-reading>从第一章开始 →</a>}
    </header>

    <section class="contents-panel">
      <header><div><small>ALL CHAPTERS</small><h2>全书目录</h2></div><label><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg><input type="search" data-contents-search placeholder="搜索卷名或章节" /></label></header>
      <div class="contents-volumes">
        {volumes.map((volume:any,volumeIndex:number)=><details class="contents-volume" open={volumeIndex===0} data-volume>
          <summary><span>{String(volumeIndex+1).padStart(2,'0')}</span><div><h3>{volume.title}</h3><p>{volume.chapters?.length||0} 章</p></div><i aria-hidden="true"></i></summary>
          <ol>{volume.chapters?.map((chapter:any,chapterIndex:number)=><li data-chapter data-search-text={`${volume.title} ${chapter.title}`.toLowerCase()}><a href={'/books/'+book.slug+'/'+volume.slug+'/'+chapter.slug} data-chapter-id={chapter.id}><span>{String(chapterIndex+1).padStart(2,'0')}</span><b>{chapter.title}</b><small data-chapter-state>阅读 →</small></a></li>)}</ol>
        </details>)}
      </div>
      <div class="contents-empty" data-contents-empty hidden><b>没有找到匹配章节</b><span>换一个关键词试试。</span></div>
    </section>
  </main>
</BaseLayout>

<style>
.contents-page{max-width:1120px;margin:0 auto;padding:2rem 1rem 6rem}.contents-hero{position:relative;display:grid;grid-template-columns:150px minmax(0,1fr) auto;gap:2rem;align-items:end;padding:2.2rem;border:1px solid color-mix(in srgb,currentColor 10%,transparent);border-radius:26px;background:color-mix(in srgb,var(--theme-card-bg,#fff) 86%,transparent);box-shadow:0 22px 60px rgba(22,38,27,.09)}.contents-back{position:absolute;top:1.3rem;left:2.2rem;color:inherit;font-size:.72rem;text-decoration:none;opacity:.55}.contents-cover{aspect-ratio:2/3;overflow:hidden;border-radius:14px;background:color-mix(in srgb,var(--brand) 10%,white);box-shadow:0 16px 32px rgba(20,33,24,.16);display:grid;place-items:center;font:600 3.5rem var(--theme-title-font)}.contents-cover img{width:100%;height:100%;object-fit:cover}.contents-intro{min-width:0;padding-top:2rem}.contents-intro>small,.contents-panel>header small{color:var(--brand);font-size:.65rem;font-weight:800;letter-spacing:.16em}.contents-intro h1{margin:.4rem 0 .55rem;font:600 clamp(2.2rem,5vw,4.5rem)/1.05 var(--theme-title-font)}.contents-intro>p{opacity:.58}.contents-intro>div{display:flex;gap:.6rem;margin-top:1.1rem}.contents-intro>div span{padding:.35rem .65rem;border-radius:999px;background:color-mix(in srgb,currentColor 6%,transparent);font-size:.7rem}.contents-start{display:inline-flex;align-items:center;padding:.8rem 1rem;border-radius:12px;background:#172019;color:#fff;font-size:.76rem;font-weight:700;text-decoration:none}.contents-panel{margin-top:1.5rem;padding:2rem 2.2rem;border:1px solid color-mix(in srgb,currentColor 10%,transparent);border-radius:26px;background:color-mix(in srgb,var(--theme-card-bg,#fff) 83%,transparent)}.contents-panel>header{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-bottom:1.2rem;border-bottom:1px solid color-mix(in srgb,currentColor 10%,transparent)}.contents-panel h2{margin:.25rem 0 0;font:600 2rem var(--theme-title-font)}.contents-panel>header label{display:flex;width:min(360px,42vw);align-items:center;gap:.55rem;padding:.7rem .85rem;border:1px solid color-mix(in srgb,currentColor 12%,transparent);border-radius:12px;background:color-mix(in srgb,currentColor 2%,transparent)}.contents-panel>header svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;opacity:.5}.contents-panel input{min-width:0;width:100%;border:0;outline:0;background:transparent;color:inherit;font:inherit}.contents-volumes{display:grid;gap:.8rem;margin-top:1rem}.contents-volume{overflow:hidden;border:1px solid color-mix(in srgb,currentColor 9%,transparent);border-radius:16px;background:color-mix(in srgb,currentColor 2%,transparent)}.contents-volume summary{display:grid;grid-template-columns:2.5rem minmax(0,1fr) 20px;gap:.8rem;align-items:center;padding:1rem 1.1rem;cursor:pointer;list-style:none}.contents-volume summary::-webkit-details-marker{display:none}.contents-volume summary>span{font:750 .66rem ui-monospace,monospace;opacity:.4}.contents-volume h3{overflow:hidden;margin:0;font-size:.9rem;text-overflow:ellipsis;white-space:nowrap}.contents-volume summary p{margin:.2rem 0 0;font-size:.65rem;opacity:.45}.contents-volume summary i{position:relative;width:16px;height:16px}.contents-volume summary i::before,.contents-volume summary i::after{content:'';position:absolute;top:7px;left:2px;width:12px;height:1.5px;background:currentColor;transition:transform .18s}.contents-volume summary i::after{transform:rotate(90deg)}.contents-volume[open] summary i::after{transform:rotate(0)}.contents-volume ol{margin:0;padding:0 1rem 1rem;list-style:none}.contents-volume li a{display:grid;grid-template-columns:2.5rem minmax(0,1fr) auto;gap:.75rem;align-items:center;padding:.78rem .7rem;border-top:1px solid color-mix(in srgb,currentColor 7%,transparent);border-radius:9px;color:inherit;text-decoration:none;transition:background .15s ease,transform .15s ease}.contents-volume li a:hover{background:color-mix(in srgb,var(--brand) 7%,transparent);transform:translateX(2px)}.contents-volume li a>span{font:650 .64rem ui-monospace,monospace;opacity:.38}.contents-volume li b{font-size:.82rem;line-height:1.45}.contents-volume li small{color:var(--brand);font-size:.65rem;font-weight:700}.contents-volume li a.is-last-read{background:color-mix(in srgb,var(--brand) 9%,transparent);box-shadow:inset 3px 0 var(--brand)}.contents-empty{min-height:220px;text-align:center;place-content:center}.contents-empty b,.contents-empty span{display:block}.contents-empty span{margin-top:.4rem;font-size:.76rem;opacity:.5}
@media(max-width:700px){.contents-page{padding:.75rem .7rem 4rem}.contents-hero{grid-template-columns:82px minmax(0,1fr);gap:1rem;padding:3.2rem 1rem 1.2rem;border-radius:18px}.contents-back{top:1rem;left:1rem}.contents-cover{border-radius:10px}.contents-intro{padding:0}.contents-intro>small{font-size:.55rem}.contents-intro h1{font-size:1.75rem}.contents-intro>div{margin-top:.65rem}.contents-start{grid-column:1/-1;justify-content:center}.contents-panel{margin-top:.7rem;padding:1.1rem 1rem;border-radius:18px}.contents-panel>header{display:grid;gap:1rem;align-items:stretch}.contents-panel>header label{width:100%}.contents-panel h2{font-size:1.55rem}.contents-volume summary{grid-template-columns:2rem minmax(0,1fr) 18px;padding:.9rem .75rem}.contents-volume ol{padding:0 .55rem .65rem}.contents-volume li a{grid-template-columns:2rem minmax(0,1fr);padding:.75rem .5rem}.contents-volume li small{grid-column:2}.contents-volume h3{font-size:.8rem}}
</style>

<script>
  // @ts-nocheck
  import { ensurePrivateDeviceToken } from '../../../lib/private-device'
  async function initBookContents(){
    const root=document.querySelector('[data-book-contents]');if(!root||root.dataset.ready)return;root.dataset.ready='1';
    const search=root.querySelector('[data-contents-search]'),empty=root.querySelector('[data-contents-empty]');
    search?.addEventListener('input',()=>{const query=search.value.trim().toLowerCase();let visible=0;root.querySelectorAll('[data-volume]').forEach((volume)=>{let matches=0;volume.querySelectorAll('[data-chapter]').forEach((chapter)=>{const match=!query||chapter.dataset.searchText.includes(query);chapter.hidden=!match;if(match)matches++});volume.hidden=matches===0;if(query&&matches)volume.open=true;visible+=matches});empty.hidden=visible>0});
    const token=await ensurePrivateDeviceToken(window.__PUBLIC_API_BASE__||'/api');if(!token)return;
    try{const response=await fetch((window.__PUBLIC_API_BASE__||'/api')+'/private/books/'+root.dataset.bookId+'/progress',{headers:{'X-Device-Token':token}}),json=await response.json(),state=json.data;if(!response.ok||!state)return;const link=root.querySelector('[data-chapter-id="'+Number(state.chapter_id)+'"]');if(link){link.classList.add('is-last-read');const label=link.querySelector('[data-chapter-state]');if(label)label.textContent='上次 '+Math.round(Math.max(0,Math.min(1,Number(state.position)||0))*100)+'%';link.closest('details').open=true;const action=root.querySelector('[data-continue-reading]');if(action){action.href=link.href+'?at='+Math.max(0,Math.min(1,Number(state.position)||0));action.textContent='继续上次阅读 →'}}}catch{}
  }
  document.addEventListener('astro:page-load',initBookContents);initBookContents();
</script>
