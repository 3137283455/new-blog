---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BookLibraryRefactor from '../../components/BookLibraryRefactor.astro'
import ContentSourceExplorer from '../../components/ContentSourceExplorer.astro'
import { getBooks } from '../../lib/api'
import { resolveUploadUrl } from '../../lib/media'
const books = await getBooks()
const totalVolumes = books.reduce((sum, book) => sum + Number(book.volume_count || 0), 0)
const totalChapters = books.reduce((sum, book) => sum + Number(book.chapter_count || 0), 0)
const statusLabel = (status?: string) => ({ reading: '阅读中', finished: '已读完', planned: '想阅读', paused: '暂放' }[status || 'reading'] || '阅读中')
---
<BaseLayout title="书库" subtitle="小说、分卷与长期阅读" showSidebar={false} showBanner={false}>
  <BookLibraryRefactor books={books} />
  <ContentSourceExplorer kind="book" />
  <section class="library" data-legacy-library hidden style="display:none!important">
    <header class="library-heading"><div><p>PERSONAL LIBRARY</p><h1>书库</h1><span>读过的、正在读的，以及准备留到以后的故事。</span></div><dl><div><dt>{books.length}</dt><dd>藏书</dd></div><div><dt>{totalVolumes}</dt><dd>分卷</dd></div><div><dt>{totalChapters}</dt><dd>章节</dd></div></dl></header>
    <section class="continue-reading" data-continue hidden><div class="continue-cover"><img data-continue-cover alt="" /></div><div class="continue-copy"><p>CONTINUE READING</p><h2 data-continue-title>继续阅读</h2><span data-continue-chapter></span><div class="continue-progress"><i data-continue-bar></i></div><small data-continue-progress></small></div><a data-continue-link href="/books">继续阅读 <span>→</span></a></section>
    <section class="library-panel">
      <header class="library-toolbar"><label class="library-search"><span>⌕</span><input type="search" data-library-search placeholder="搜索书名、作者或简介" autocomplete="off" /><kbd>/</kbd></label><div class="library-actions"><select data-library-sort aria-label="书籍排序"><option value="updated">最近整理</option><option value="title">书名排序</option><option value="author">作者排序</option><option value="length">章节最多</option><option value="progress">阅读进度</option></select><button type="button" data-random-book title="随机打开一本">随机一本</button><div class="view-switch" aria-label="视图切换"><button type="button" data-library-view="grid" title="封面视图">▦</button><button type="button" data-library-view="list" title="列表视图">☷</button></div></div></header>
      <nav class="library-filters" aria-label="书库分类"><button class="is-active" type="button" data-library-filter="all">全部 <span>{books.length}</span></button>{['reading','finished','planned','paused'].map((status)=><button type="button" data-library-filter={status}>{statusLabel(status)} <span>{books.filter((book)=>(book.reading_status||'reading')===status).length}</span></button>)}</nav>
      <div class="shelf-meta"><span data-library-count>{books.length} 本书</span><small>选择封面查看详情，或从进度处继续阅读</small></div>
      <div class="book-shelf" data-book-shelf>
        {books.map((book,index)=><article class="shelf-book" data-book-card data-id={book.id} data-index={index} data-title={book.title.toLocaleLowerCase()} data-author={(book.author||'').toLocaleLowerCase()} data-description={(book.description||'').toLocaleLowerCase()} data-status={book.reading_status||'reading'} data-updated={book.updated_at||''} data-chapters={book.chapter_count||0} data-progress="0">
          <a class="shelf-cover" href={`/books/${book.slug}`}>{book.cover?<img src={resolveUploadUrl(book.cover)} alt={`${book.title}封面`} loading="lazy" decoding="async" />:<span>{book.title.slice(0,1)}</span>}<b>{book.reading_mode==='external'?'外部阅读':book.reading_mode==='document'?(book.source_format||'文档').toUpperCase():statusLabel(book.reading_status)}</b></a>
          <div class="shelf-copy"><small>{book.author||'作者未填写'}</small><h2><a href={`/books/${book.slug}`}>{book.title}</a></h2><p>{book.description||`${book.volume_count||0} 卷、${book.chapter_count||0} 章，等待从第一页开始。`}</p><div class="book-progress" data-book-progress hidden><i></i><span></span></div><footer><span>{book.reading_mode==='external'?'外部书站':book.reading_mode==='document'?`${(book.source_format||'文档').toUpperCase()} 文档`:`${book.volume_count||0} 卷 · ${book.chapter_count||0} 章`}</span><a data-book-action href={book.reading_mode==='chapters'||!book.reading_mode?`/books/${book.slug}`:(book.reading_url||`/books/${book.slug}`)} target={book.reading_mode==='chapters'||!book.reading_mode?undefined:'_blank'} rel={book.reading_mode==='chapters'||!book.reading_mode?undefined:'noopener noreferrer'}>{book.reading_mode==='external'?'前往阅读 ↗':book.reading_mode==='document'?'打开文档 ↗':'查看书籍 →'}</a></footer></div>
        </article>)}
      </div>
      <div class="library-empty" data-library-empty hidden><strong>没有找到这本书</strong><span>换个关键词或查看其他阅读状态。</span></div>
      {!books.length&&<div class="library-empty"><strong>书架还是空的</strong><span>从后台导入 EPUB、TXT、Markdown、PDF，或添加外部阅读链接。</span><a href="/admin">前往内容中心 →</a></div>}
    </section>
  </section>
</BaseLayout>
<style>
.library{width:100%;display:grid;gap:1rem;padding-bottom:4rem;color:var(--ink)}.library-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:.5rem .15rem 1rem;border-bottom:1px solid var(--line)}.library-heading p,.continue-copy>p{color:var(--brand);font:900 .65rem/1 system-ui;letter-spacing:.16em}.library-heading h1{margin:.35rem 0;font:700 clamp(2.5rem,5vw,4.2rem)/1 var(--theme-title-font)}.library-heading>div>span{color:var(--muted-ink);font-size:.78rem}.library-heading dl{display:flex;margin:0}.library-heading dl div{min-width:5rem;text-align:center;border-left:1px solid var(--line)}.library-heading dt{font:700 1.2rem var(--theme-title-font)}.library-heading dd{margin:.15rem 0 0;color:var(--muted-ink);font-size:.62rem}
.continue-reading{display:grid;grid-template-columns:5rem minmax(0,1fr) auto;align-items:center;gap:1rem;overflow:hidden;border:1px solid var(--line);border-radius:var(--theme-card-radius,18px);background:linear-gradient(110deg,color-mix(in srgb,var(--theme-primary) 15%,var(--surface-solid)),color-mix(in srgb,var(--surface-solid) 92%,transparent));padding:1rem}.continue-cover{width:5rem;aspect-ratio:2/3;overflow:hidden;border-radius:.65rem;background:color-mix(in srgb,var(--brand) 12%,var(--surface-solid))}.continue-cover img{width:100%;height:100%;object-fit:cover}.continue-copy{min-width:0}.continue-copy h2{margin:.3rem 0 .15rem;font-size:1.25rem}.continue-copy>span{display:block;overflow:hidden;color:var(--muted-ink);font-size:.7rem;text-overflow:ellipsis;white-space:nowrap}.continue-progress{width:min(100%,28rem);height:.28rem;margin-top:.65rem;overflow:hidden;border-radius:999px;background:color-mix(in srgb,var(--ink) 9%,transparent)}.continue-progress i,.book-progress i{display:block;width:0;height:100%;border-radius:inherit;background:var(--brand)}.continue-copy small{display:block;margin-top:.3rem;color:var(--muted-ink);font-size:.6rem}.continue-reading>a{display:flex;align-items:center;gap:.6rem;color:var(--ink);font-size:.75rem;font-weight:850}.continue-reading>a span{display:grid;width:2.2rem;height:2.2rem;place-items:center;border-radius:50%;background:var(--ink);color:var(--surface-solid)}
.library-panel{display:grid;gap:.85rem}.library-toolbar{display:flex;align-items:center;gap:.8rem}.library-search{min-width:0;flex:1;display:flex;align-items:center;gap:.65rem;height:2.8rem;border:1px solid var(--line);border-radius:.85rem;background:color-mix(in srgb,var(--surface-solid) 86%,transparent);padding:0 .8rem}.library-search span{font-size:1.15rem}.library-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--ink);font-size:.75rem}.library-search kbd{border:1px solid var(--line);border-radius:.35rem;background:var(--surface-solid);padding:.1rem .35rem;color:var(--muted-ink);font-size:.6rem}.library-actions{display:flex;gap:.5rem}.library-actions select,.library-actions>button,.view-switch{height:2.8rem;border:1px solid var(--line);border-radius:.8rem;background:color-mix(in srgb,var(--surface-solid) 86%,transparent);color:var(--ink);font-size:.7rem;font-weight:750}.library-actions select{padding:0 2rem 0 .75rem}.library-actions>button{padding:0 .85rem}.view-switch{display:flex;padding:.2rem}.view-switch button{width:2.2rem;border:0;border-radius:.55rem;background:transparent;color:var(--muted-ink)}.view-switch button.is-active{background:var(--ink);color:var(--surface-solid)}
.library-filters{display:flex;gap:.35rem;overflow-x:auto;padding-bottom:.1rem}.library-filters button{flex:none;border:0;border-radius:999px;background:transparent;color:var(--muted-ink);padding:.45rem .7rem;font-size:.68rem;font-weight:800}.library-filters button span{margin-left:.25rem;opacity:.55}.library-filters button.is-active{background:var(--ink);color:var(--surface-solid)}.shelf-meta{display:flex;justify-content:space-between;padding:.15rem .2rem;color:var(--muted-ink);font-size:.65rem}.shelf-meta small{font-size:inherit}
.book-shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(9.5rem,1fr));gap:1.25rem 1rem}.shelf-book{min-width:0}.shelf-cover{position:relative;display:block;aspect-ratio:2/3;overflow:hidden;border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*.72);background:linear-gradient(145deg,color-mix(in srgb,var(--brand) 18%,var(--surface-solid)),var(--surface-solid));color:var(--ink);box-shadow:0 12px 25px rgb(20 35 25/.08);transition:transform .2s,box-shadow .2s}.shelf-cover:hover{transform:translateY(-4px);box-shadow:0 20px 36px rgb(20 35 25/.15)}.shelf-cover img{width:100%;height:100%;object-fit:cover}.shelf-cover>span{display:grid;width:100%;height:100%;place-items:center;font:700 3rem var(--theme-title-font)}.shelf-cover b{position:absolute;top:.55rem;left:.55rem;border-radius:999px;background:rgb(20 28 21/.82);color:white;padding:.3rem .48rem;font-size:.56rem;backdrop-filter:blur(8px)}.shelf-copy{padding:.7rem .15rem 0}.shelf-copy>small{display:block;overflow:hidden;color:var(--brand);font-size:.61rem;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.shelf-copy h2{margin:.25rem 0 0;font-size:1rem;line-height:1.25}.shelf-copy h2 a{color:inherit}.shelf-copy>p{display:none}.shelf-copy footer{display:flex;justify-content:space-between;gap:.5rem;margin-top:.35rem;color:var(--muted-ink);font-size:.59rem}.shelf-copy footer a{color:var(--ink);font-weight:800}.book-progress{height:.25rem;margin-top:.55rem;overflow:hidden;border-radius:999px;background:color-mix(in srgb,var(--ink) 9%,transparent)}.book-progress span{display:block;margin-top:.3rem;color:var(--muted-ink);font-size:.56rem}
.book-shelf[data-view=list]{grid-template-columns:1fr;gap:.6rem}.book-shelf[data-view=list] .shelf-book{display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:1rem;min-height:7rem;border:1px solid var(--line);border-radius:var(--theme-card-radius,18px);background:color-mix(in srgb,var(--surface-solid) 84%,transparent);padding:.65rem}.book-shelf[data-view=list] .shelf-cover{height:6.4rem;aspect-ratio:2/3;border-radius:.55rem}.book-shelf[data-view=list] .shelf-cover b{display:none}.book-shelf[data-view=list] .shelf-copy{display:flex;flex-direction:column;padding:.25rem 0}.book-shelf[data-view=list] .shelf-copy h2{font-size:1.15rem}.book-shelf[data-view=list] .shelf-copy>p{display:-webkit-box;overflow:hidden;margin-top:.35rem;color:var(--muted-ink);font-size:.67rem;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.book-shelf[data-view=list] .shelf-copy footer{margin-top:auto}.library-empty[hidden]{display:none}.library-empty{display:grid;place-items:center;gap:.3rem;min-height:12rem;border:1px dashed var(--line);border-radius:var(--theme-card-radius,18px);color:var(--muted-ink);text-align:center}.library-empty strong{color:var(--ink);font:700 1.2rem var(--theme-title-font)}.library-empty a{color:var(--brand);font-size:.72rem;font-weight:800}
@media(max-width:700px){.library-heading{align-items:start;flex-direction:column;gap:1rem}.library-heading dl{width:100%}.library-heading dl div{flex:1}.continue-reading{grid-template-columns:4rem minmax(0,1fr)}.continue-cover{width:4rem}.continue-reading>a{grid-column:2;font-size:.68rem}.library-toolbar{align-items:stretch;flex-direction:column}.library-actions{width:100%}.library-actions select{min-width:0;flex:1}.shelf-meta small{display:none}.book-shelf{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem .65rem}}
@media(max-width:440px){.book-shelf{grid-template-columns:repeat(2,minmax(0,1fr))}.library-actions>button{display:none}.shelf-copy footer a{font-size:0}.shelf-copy footer a::after{content:"→";font-size:.65rem}}
.book-progress{height:1.05rem;overflow:visible;background:linear-gradient(color-mix(in srgb,var(--ink) 9%,transparent),color-mix(in srgb,var(--ink) 9%,transparent)) top/100% .25rem no-repeat}.book-progress i{height:.25rem}.book-progress span{line-height:1}
@media(max-width:700px){
  .library{gap:.75rem;padding-bottom:2rem}.library-heading{gap:.75rem;padding:0 0 .75rem}.library-heading h1{margin:.25rem 0;font-size:2.35rem}.library-heading>div>span{display:block;max-width:19rem;font-size:.7rem;line-height:1.55}.library-heading dl{overflow:hidden;border:1px solid var(--line);border-radius:.75rem;background:color-mix(in srgb,var(--surface-solid) 80%,transparent)}.library-heading dl div{min-width:0;padding:.55rem .25rem}.library-heading dl div:first-child{border-left:0}.library-heading dt{font-size:1rem}.library-heading dd{font-size:.58rem}
  .continue-reading{grid-template-columns:4.2rem minmax(0,1fr);gap:.75rem;padding:.75rem}.continue-cover{width:4.2rem}.continue-copy h2{font-size:1.05rem}.continue-copy>span{font-size:.64rem}.continue-reading>a{grid-column:1/-1;justify-content:space-between;border-top:1px solid var(--line);padding-top:.65rem}.continue-reading>a span{width:1.8rem;height:1.8rem}
  .library-panel{gap:.65rem}.library-toolbar{gap:.5rem}.library-search{width:100%;height:2.7rem}.library-search kbd{display:none}.library-actions{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.45rem}.library-actions select{width:100%;height:2.55rem}.library-actions>button{display:none}.view-switch{height:2.55rem}.library-filters{margin:0 -.25rem;padding:0 .25rem .15rem;scrollbar-width:none}.library-filters::-webkit-scrollbar{display:none}.library-filters button{padding:.42rem .62rem}.shelf-meta{padding:.05rem .1rem}
  .book-shelf{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem .75rem}.shelf-copy{padding:.55rem .1rem 0}.shelf-copy h2{font-size:.92rem}.shelf-copy footer{align-items:center}.shelf-copy footer>span{overflow:hidden;max-width:7rem;text-overflow:ellipsis;white-space:nowrap}.shelf-cover b{top:.4rem;left:.4rem;padding:.25rem .4rem}
  .book-shelf[data-view=list] .shelf-book{grid-template-columns:4rem minmax(0,1fr);gap:.75rem;min-height:6.5rem;padding:.55rem}.book-shelf[data-view=list] .shelf-cover{height:5.7rem}.book-shelf[data-view=list] .shelf-copy h2{font-size:1rem}.book-shelf[data-view=list] .shelf-copy>p{-webkit-line-clamp:1}
}
@media(max-width:360px){.book-shelf{gap:.85rem .55rem}.shelf-copy footer>span{font-size:.55rem}.library-filters button{padding-inline:.55rem}}</style>
<script>
// @ts-nocheck
import { ensurePrivateDeviceToken } from '../../lib/private-device'
function initLibrary(){
  const root=document.querySelector('[data-library]');if(!root||root.dataset.ready)return;root.dataset.ready='1';
  const shelf=root.querySelector('[data-book-shelf]'),cards=[...root.querySelectorAll('[data-book-card]')],search=root.querySelector('[data-library-search]'),sort=root.querySelector('[data-library-sort]'),count=root.querySelector('[data-library-count]'),empty=root.querySelector('[data-library-empty]');
  let filter='all',progress=new Map();
  const normalize=(value)=>String(value||'').trim().toLocaleLowerCase();
  const apply=()=>{const term=normalize(search.value);let visible=cards.filter((card)=>{const matchesStatus=filter==='all'||card.dataset.status===filter,matchesTerm=!term||[card.dataset.title,card.dataset.author,card.dataset.description].some((value)=>normalize(value).includes(term));card.hidden=!(matchesStatus&&matchesTerm);return !card.hidden});const mode=sort.value;visible.sort((a,b)=>mode==='title'?(a.dataset.title||'').localeCompare(b.dataset.title||'','zh-CN'):mode==='author'?(a.dataset.author||'').localeCompare(b.dataset.author||'','zh-CN'):mode==='length'?Number(b.dataset.chapters)-Number(a.dataset.chapters):mode==='progress'?Number(b.dataset.progress)-Number(a.dataset.progress):(b.dataset.updated||'').localeCompare(a.dataset.updated||''));visible.forEach((card)=>shelf.append(card));count.textContent=visible.length+' 本书';empty.hidden=visible.length>0||cards.length===0};
  const setView=(view)=>{shelf.dataset.view=view;root.querySelectorAll('[data-library-view]').forEach((button)=>button.classList.toggle('is-active',button.dataset.libraryView===view));localStorage.setItem('boke_library_view',view)};
  root.querySelectorAll('[data-library-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.libraryFilter;root.querySelectorAll('[data-library-filter]').forEach((item)=>item.classList.toggle('is-active',item===button));apply()}));
  root.querySelectorAll('[data-library-view]').forEach((button)=>button.addEventListener('click',()=>setView(button.dataset.libraryView)));
  search.addEventListener('input',apply);sort.addEventListener('change',apply);root.querySelector('[data-random-book]')?.addEventListener('click',()=>{const visible=cards.filter((card)=>!card.hidden);if(!visible.length)return;const card=visible[Math.floor(Math.random()*visible.length)],link=card.querySelector('[data-book-action]')||card.querySelector('.shelf-cover');if(link)location.href=link.href});
  addEventListener('keydown',(event)=>{if(event.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)){event.preventDefault();search.focus()}});
  const loadProgress=async()=>{const token=await ensurePrivateDeviceToken(window.__PUBLIC_API_BASE__||'/api');if(!token)return;try{const response=await fetch((window.__PUBLIC_API_BASE__||'/api')+'/private/library',{headers:{'X-Device-Token':token}}),json=await response.json();if(!response.ok||!Array.isArray(json.data))return;json.data.forEach((item)=>progress.set(String(item.id),item));cards.forEach((card)=>{const item=progress.get(card.dataset.id);if(!item)return;const value=Math.max(0,Math.min(1,Number(item.overall_progress)||0)),percent=Math.max(1,Math.round(value*100)),bar=card.querySelector('[data-book-progress]'),action=card.querySelector('[data-book-action]');card.dataset.progress=String(value);bar.hidden=false;bar.querySelector('i').style.width=percent+'%';bar.querySelector('span').textContent='全书 '+percent+'%';if(item.volume_slug&&item.chapter_slug){action.href='/books/'+encodeURIComponent(item.slug)+'/'+encodeURIComponent(item.volume_slug)+'/'+encodeURIComponent(item.chapter_slug)+'?at='+Math.max(0,Math.min(1,Number(item.chapter_progress)||0));action.textContent='继续阅读 →'}});const latest=json.data.find((item)=>item.volume_slug&&item.chapter_slug),panel=root.querySelector('[data-continue]');if(latest&&panel){const source=cards.find((card)=>card.dataset.id===String(latest.id)),image=source?.querySelector('.shelf-cover img'),value=Math.max(0,Math.min(1,Number(latest.overall_progress)||0)),percent=Math.max(1,Math.round(value*100));panel.hidden=false;const cover=panel.querySelector('[data-continue-cover]');if(image){cover.src=image.src;cover.alt=image.alt}else cover.closest('.continue-cover').hidden=true;panel.querySelector('[data-continue-title]').textContent=latest.title;panel.querySelector('[data-continue-chapter]').textContent=(latest.volume_title?latest.volume_title+' · ':'')+(latest.chapter_title||'继续上次阅读');panel.querySelector('[data-continue-bar]').style.width=percent+'%';panel.querySelector('[data-continue-progress]').textContent='第 '+(latest.chapter_number||1)+' / '+(latest.chapter_count||1)+' 章 · 全书 '+percent+'%';panel.querySelector('[data-continue-link]').href='/books/'+encodeURIComponent(latest.slug)+'/'+encodeURIComponent(latest.volume_slug)+'/'+encodeURIComponent(latest.chapter_slug)+'?at='+Math.max(0,Math.min(1,Number(latest.chapter_progress)||0))}apply()}catch{}};
  setView(localStorage.getItem('boke_library_view')==='list'?'list':'grid');apply();loadProgress();
}
document.addEventListener('astro:page-load',initLibrary);initLibrary();
</script>
