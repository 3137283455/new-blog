---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getBooks } from '../../lib/api'
import { resolveUploadUrl } from '../../lib/media'
const books = await getBooks()
const totalVolumes = books.reduce((sum, book) => sum + Number(book.volume_count || 0), 0)
const totalChapters = books.reduce((sum, book) => sum + Number(book.chapter_count || 0), 0)
const statusLabel = (status?: string) => ({ reading: '阅读中', finished: '已读完', planned: '想阅读', paused: '暂放' }[status || 'reading'] || '阅读中')
const formatUpdate = (date?: string) => date ? new Date(date).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' }) : '持续整理'
---
<BaseLayout title="书库" subtitle="小说、分卷与长期阅读" showSidebar={false} showBanner={false}>
  <section class="book-library">
    <header class="library-hero">
      <div class="library-intro"><p><span></span>PERSONAL LIBRARY</p><h1>我的书库</h1><strong>把喜欢的故事，安静地收进自己的书架。</strong><small>每本书都保留独立分卷、章节目录与跨设备阅读位置。</small></div>
      <dl class="library-summary" aria-label="书库统计"><div><dt>{books.length}</dt><dd>本藏书</dd></div><div><dt>{totalVolumes}</dt><dd>个分卷</dd></div><div><dt>{totalChapters}</dt><dd>篇章节</dd></div></dl>
    </header>
    {books.length ? <section class="library-shelf">
      <header class="shelf-heading"><div><p>BOOKSHELF</p><h2>书架</h2></div><span>{books.length === 1 ? '正在阅读这一册' : `共 ${books.length} 本，按最近整理排列`}</span></header>
      <div class="book-grid">{books.map((book, index) => <a class="book-card" href={`/books/${book.slug}`}>
        <div class="book-cover">{book.cover ? <img src={resolveUploadUrl(book.cover)} alt={`${book.title}封面`} loading="lazy" decoding="async" /> : <span aria-hidden="true">{book.title.slice(0, 1)}</span>}<i>{String(index + 1).padStart(2, '0')}</i></div>
        <div class="book-copy"><header><b class:list={['book-status', `is-${book.reading_status || 'reading'}`]}>{statusLabel(book.reading_status)}</b><time datetime={book.updated_at}>{formatUpdate(book.updated_at)}</time></header><h3>{book.title}</h3><p class="book-author">{book.author || '作者未填写'}</p><p class="book-description">{book.description || '这本书还没有简介，进入书籍查看分卷与章节。'}</p><footer><div><span><strong>{book.volume_count || 0}</strong> 卷</span><span><strong>{book.chapter_count || 0}</strong> 章</span></div><em>打开书籍 <span>↗</span></em></footer></div>
      </a>)}</div>
    </section> : <div class="book-empty"><span aria-hidden="true">＋</span><div><strong>书架还是空的</strong><p>在后台“内容中心 → 书库”导入 EPUB 后，书籍会整齐地出现在这里。</p></div><a href="/admin">前往内容中心 ↗</a></div>}
  </section>
</BaseLayout>
<style>
.book-library{width:100%;display:grid;gap:1.15rem;padding-bottom:4rem;color:var(--ink)}
.library-hero{position:relative;isolation:isolate;min-height:17rem;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;overflow:hidden;border:1px solid var(--line);border-radius:var(--theme-card-radius,18px);background:linear-gradient(125deg,color-mix(in srgb,var(--theme-primary) 18%,var(--surface-solid)),color-mix(in srgb,var(--surface-solid) 94%,transparent) 58%,color-mix(in srgb,var(--theme-primary) 8%,var(--surface-solid)));padding:clamp(1.5rem,4vw,3.2rem)}
.library-hero::before{content:"BOOKS";position:absolute;z-index:-1;right:-.04em;top:-.2em;color:color-mix(in srgb,var(--theme-primary) 8%,transparent);font:700 clamp(6rem,16vw,13rem)/1 var(--theme-title-font);letter-spacing:-.07em;pointer-events:none}
.library-intro{max-width:42rem}.library-intro>p,.shelf-heading p{display:flex;align-items:center;gap:.6rem;color:var(--brand);font:900 .67rem/1 system-ui,sans-serif;letter-spacing:.16em}.library-intro>p span{width:2rem;height:2px;background:var(--brand)}
.library-intro h1{margin:.7rem 0 .85rem;font:600 clamp(2.8rem,6vw,5.2rem)/.95 var(--theme-title-font);letter-spacing:-.045em}.library-intro>strong{display:block;font-size:clamp(.95rem,1.7vw,1.2rem)}.library-intro>small{display:block;margin-top:.5rem;color:var(--muted-ink);font-size:.78rem;line-height:1.7}
.library-summary{position:relative;display:grid;grid-template-columns:repeat(3,minmax(4.5rem,1fr));min-width:min(100%,20rem);margin:0;border:1px solid var(--line);border-radius:calc(var(--theme-card-radius,18px)*.75);background:color-mix(in srgb,var(--surface-solid) 72%,transparent);backdrop-filter:blur(12px)}.library-summary div{padding:1rem;text-align:center}.library-summary div+div{border-left:1px solid var(--line)}.library-summary dt{font:700 1.45rem/1 var(--theme-title-font)}.library-summary dd{margin:.35rem 0 0;color:var(--muted-ink);font-size:.65rem}
.library-shelf{display:grid;gap:.9rem}.shelf-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:.8rem .2rem .35rem}.shelf-heading h2{margin:.25rem 0 0;font:700 1.75rem/1 var(--theme-title-font)}.shelf-heading>span{color:var(--muted-ink);font-size:.7rem}
.book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.book-card{min-width:0;display:grid;grid-template-columns:9.4rem minmax(0,1fr);gap:1.25rem;min-height:15.5rem;overflow:hidden;border:1px solid var(--line);border-radius:var(--theme-card-radius,18px);background:color-mix(in srgb,var(--surface-solid) 88%,transparent);color:var(--ink);padding:1rem;text-decoration:none;box-shadow:0 14px 36px rgb(24 45 31/.04);transition:transform .22s,border-color .22s,box-shadow .22s}.book-card:only-child{grid-column:1/-1;grid-template-columns:minmax(10rem,12rem) minmax(0,1fr);min-height:18rem}.book-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--brand) 42%,var(--line));box-shadow:0 22px 50px rgb(24 45 31/.11)}
.book-cover{position:relative;min-height:100%;overflow:hidden;border-radius:calc(var(--theme-card-radius,18px)*.66);background:linear-gradient(145deg,color-mix(in srgb,var(--theme-primary) 20%,var(--surface-solid)),color-mix(in srgb,var(--theme-primary) 6%,var(--surface-solid)));display:grid;place-items:center;font:700 3.4rem var(--theme-title-font)}.book-cover::after{content:"";position:absolute;inset:0;border:1px solid rgb(255 255 255/.22);border-radius:inherit;pointer-events:none}.book-cover img{width:100%;height:100%;object-fit:cover;transition:transform .45s}.book-card:hover .book-cover img{transform:scale(1.035)}.book-cover i{position:absolute;left:.65rem;bottom:.65rem;display:grid;width:2rem;height:2rem;place-items:center;border-radius:50%;background:rgb(20 28 21/.82);color:white;font:800 .62rem/1 ui-monospace,monospace;font-style:normal;backdrop-filter:blur(8px)}
.book-copy{min-width:0;display:flex;flex-direction:column;padding:.35rem .2rem .2rem}.book-copy>header{display:flex;align-items:center;justify-content:space-between;gap:.7rem}.book-copy time{color:var(--muted-ink);font-size:.65rem}.book-status{border-radius:999px;background:color-mix(in srgb,var(--theme-primary) 13%,transparent);color:var(--brand);padding:.35rem .58rem;font:850 .62rem/1 system-ui,sans-serif}.book-status.is-finished{background:color-mix(in srgb,#5b74c9 13%,transparent);color:#5268b5}.book-status.is-paused{background:color-mix(in srgb,#b78134 13%,transparent);color:#9a681e}
.book-copy h3{margin:1rem 0 .3rem;font:650 clamp(1.5rem,2.5vw,2.25rem)/1.1 var(--theme-title-font);letter-spacing:-.025em}.book-author{color:var(--brand);font-size:.72rem;font-weight:800}.book-description{display:-webkit-box;overflow:hidden;margin-top:.8rem;color:var(--muted-ink);font-size:.76rem;line-height:1.75;-webkit-box-orient:vertical;-webkit-line-clamp:3}.book-copy footer{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:1rem}.book-copy footer>div{display:flex;gap:1rem;color:var(--muted-ink);font-size:.68rem}.book-copy footer strong{color:var(--ink);font-size:.9rem}.book-copy footer em{color:var(--ink);font-size:.72rem;font-style:normal;font-weight:800}.book-copy footer em span{display:inline-grid;width:1.8rem;height:1.8rem;margin-left:.35rem;place-items:center;border-radius:50%;background:var(--ink);color:var(--surface-solid)}
.book-empty{display:flex;align-items:center;gap:1rem;border:1px dashed color-mix(in srgb,var(--brand) 35%,var(--line));border-radius:var(--theme-card-radius,18px);background:color-mix(in srgb,var(--surface-solid) 72%,transparent);padding:2rem}.book-empty>span{display:grid;width:3.2rem;height:3.2rem;flex:none;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--brand) 13%,transparent);color:var(--brand);font-size:1.4rem}.book-empty strong{font:700 1.25rem var(--theme-title-font)}.book-empty p{margin-top:.3rem;color:var(--muted-ink);font-size:.75rem}.book-empty a{margin-left:auto;color:var(--brand);font-size:.75rem;font-weight:800}
@media(max-width:850px){.library-hero{align-items:stretch;flex-direction:column;min-height:auto}.library-summary{width:100%}.book-grid{grid-template-columns:1fr}.book-card:only-child{grid-column:auto;grid-template-columns:9.4rem minmax(0,1fr);min-height:15.5rem}}
@media(max-width:600px){.book-library{gap:.9rem;padding-bottom:2.5rem}.library-hero{padding:1.35rem}.library-hero::before{top:.1em}.library-intro h1{font-size:2.7rem}.library-intro>strong{font-size:.9rem}.library-summary div{padding:.75rem .45rem}.library-summary dt{font-size:1.15rem}.shelf-heading{align-items:start}.shelf-heading>span{max-width:9rem;text-align:right}.book-card,.book-card:only-child{grid-template-columns:6.4rem minmax(0,1fr);gap:.9rem;min-height:10.5rem;padding:.75rem}.book-copy{padding:.1rem 0}.book-copy h3{margin:.65rem 0 .2rem;font-size:1.3rem}.book-description{margin-top:.55rem;font-size:.68rem;line-height:1.55;-webkit-line-clamp:2}.book-copy footer{padding-top:.55rem}.book-copy footer em{font-size:0}.book-copy footer em span{margin:0;width:1.7rem;height:1.7rem;font-size:.7rem}.book-cover i{left:.4rem;bottom:.4rem;width:1.65rem;height:1.65rem}.book-empty{align-items:flex-start;flex-wrap:wrap;padding:1.3rem}.book-empty a{width:100%;margin-left:4.2rem}}
</style>