---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getBooks } from '../../lib/api'
import { resolveUploadUrl } from '../../lib/media'
const books=await getBooks()
---
<BaseLayout title="书库" subtitle="小说、分卷与长期阅读" showSidebar={false} showBanner={false} wide>
  <section class="book-library">
    <header class="book-library-head">
      <div><small>PERSONAL LIBRARY</small><h1>我的书库</h1><p>每本书拥有独立分卷、章节目录和跨设备阅读进度。</p></div>
      <span>{books.length} 本</span>
    </header>
    {books.length ? <div class="book-grid">
      {books.map((book)=> <a class="book-card" href={'/books/'+book.slug}>
        <div class="book-cover">{book.cover ? <img src={resolveUploadUrl(book.cover)} alt="" loading="lazy" /> : <span>{book.title.slice(0,1)}</span>}</div>
        <div><small>{book.reading_status==='finished'?'已读完':'阅读中'}</small><h2>{book.title}</h2><p>{book.author||'作者未填写'}</p><footer><span>{book.volume_count||0} 卷</span><span>{book.chapter_count||0} 章</span></footer></div>
      </a>)}
    </div> : <div class="book-empty"><strong>书架还是空的</strong><p>在后台“内容中心 → 书库”导入 EPUB 后会显示在这里。</p></div>}
  </section>
</BaseLayout>
<style>
.book-library{max-width:1180px;margin:0 auto;padding:2rem 1rem 5rem}.book-library-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid color-mix(in srgb,currentColor 14%,transparent);padding:1.5rem 0 2rem}.book-library-head small,.book-card small{font:700 .72rem/1 system-ui;letter-spacing:.15em;color:var(--brand)}.book-library-head h1{font:500 clamp(2.8rem,7vw,6rem)/.95 var(--theme-title-font);margin:.55rem 0}.book-library-head p{opacity:.6}.book-library-head>span{font:600 1rem system-ui}.book-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.2rem;margin-top:2rem}.book-card{display:grid;grid-template-columns:120px 1fr;gap:1.2rem;min-height:180px;padding:1rem;border:1px solid color-mix(in srgb,currentColor 12%,transparent);border-radius:var(--theme-card-radius);background:color-mix(in srgb,var(--banner-wave-bg) 82%,white);color:inherit;text-decoration:none;transition:.2s}.book-card:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(30,50,36,.12)}.book-cover{overflow:hidden;border-radius:12px;background:color-mix(in srgb,var(--brand) 12%,white);display:grid;place-items:center;font:600 3rem var(--theme-title-font)}.book-cover img{width:100%;height:100%;object-fit:cover}.book-card h2{font:600 1.55rem/1.2 var(--theme-title-font);margin:.5rem 0}.book-card p{opacity:.6}.book-card footer{display:flex;gap:1rem;margin-top:2.2rem;font-size:.78rem;opacity:.65}.book-empty{margin-top:2rem;padding:4rem;text-align:center;border:1px dashed color-mix(in srgb,currentColor 25%,transparent);border-radius:24px}@media(max-width:600px){.book-library-head{align-items:start}.book-library-head>span{display:none}.book-grid{grid-template-columns:1fr}.book-card{grid-template-columns:90px 1fr;min-height:150px}.book-card footer{margin-top:1.3rem}}
</style>