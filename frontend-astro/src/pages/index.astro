---
import BaseLayout from '@layouts/BaseLayout.astro'
import { formatDate, getActivePlugins, getArticles, getSeries } from '@/lib/api'

const [{ articles, pagination }, activePlugins, series] = await Promise.all([
  getArticles({ page: 1, pageSize: 10 }),
  getActivePlugins(),
  getSeries(),
])
const featuredSeries = series.filter((item) => item.is_featured).slice(0, 3)
const readingHistoryEnabled = activePlugins.some((plugin) => plugin.id === 'reading-history')
const articleBookmarkEnabled = activePlugins.some((plugin) => plugin.id === 'article-bookmark')
const featured = articles.find((post) => post.is_pinned || post.is_recommended) || articles[0]
const regularArticles = articles.filter((post) => post.id !== featured?.id)
const totalViews = articles.reduce((sum, post) => sum + Number(post.view_count || 0), 0)
const totalComments = articles.reduce((sum, post) => sum + Number(post.comment_count || 0), 0)
const categories = Array.from(
  new Map(
    articles
      .filter((post) => post.category_name)
      .map((post) => [
        post.category_slug || post.category_name,
        { name: post.category_name, slug: post.category_slug || post.category_name },
      ])
  ).values()
)
const tags = Array.from(new Set(articles.flatMap((post) => post.tags?.map((tag) => tag.name) || [])))
const covers = ['/image1.webp', '/image2.webp', '/image3.webp']
const readingTime = (text = '') => Math.max(1, Math.ceil(text.length / 320))
---

<BaseLayout
  title="个人博客"
  subtitle="记录技术、生活与灵感的个人空间"
  sidebarProps={{ totalPosts: pagination?.total || articles.length, totalViews, totalComments, categories, tags }}
>
  <section class="home-utility" aria-label="快捷入口">
    <div class="home-utility-copy">
      <span class="section-number">01</span>
      <p>今天想看点什么？</p>
    </div>
    <nav>
      <a href="/archive"><span>浏览归档</span><small>{pagination?.total || articles.length} 篇文章</small></a>
      <a href="/search"><span>搜索内容</span><small>Ctrl / ⌘ K</small></a>
      <a href="/nav"><span>网址导航</span><small>浏览器首页</small></a>
      <button id="random-article" type="button"><span>随机阅读</span><small>换一篇故事</small></button>
      <a href="/admin/write"><span>开始写作</span><small>新建草稿</small></a>
    </nav>
  </section>

  {featuredSeries.length > 0 && (
    <section class="home-series">
      <header class="section-heading">
        <div><span class="section-number">S</span><div><p>Ongoing series</p><h2>持续更新的专题</h2></div></div>
        <a href="/series">全部专题 <span>↗</span></a>
      </header>
      <div>
        {featuredSeries.map((item, index) => (
          <a href={`/series/${item.slug}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><small>{item.article_count || 0} 篇文章</small><h3>{item.title}</h3><p>{item.description || '持续记录中'}</p></div>
            <b>↗</b>
          </a>
        ))}
      </div>
    </section>
  )}

  {readingHistoryEnabled && (
    <section id="home-reading-history" class="home-reading-history" hidden aria-label="最近阅读">
      <header class="section-heading">
        <div><span class="section-number">↺</span><div><p>Continue reading</p><h2>最近阅读</h2></div></div>
        <button id="clear-reading-history" type="button">清除记录</button>
      </header>
      <div id="home-reading-history-list"></div>
    </section>
  )}

  {articleBookmarkEnabled && (
    <section id="home-bookmarks" class="home-bookmarks" hidden aria-label="我的收藏">
      <header class="section-heading">
        <div><span class="section-number">★</span><div><p>Saved stories</p><h2>我的收藏</h2></div></div>
        <button id="clear-bookmarks" type="button">清除收藏</button>
      </header>
      <div id="home-bookmark-list"></div>
    </section>
  )}

  {featured && (
    <article class="home-featured">
      <a href={`/article/${featured.slug}`} class="home-featured-media">
        <img src="/image1.webp" alt="" />
        <span>本期推荐</span>
      </a>
      <div class="home-featured-content">
        <p class="article-kicker">
          <span>{featured.category_name || '随笔'}</span>
          <time>{formatDate(featured.published_at || featured.created_at)}</time>
        </p>
        <h2><a href={`/article/${featured.slug}`}>{featured.title}</a></h2>
        {featured.excerpt && <p class="article-excerpt">{featured.excerpt}</p>}
        <div class="article-footer">
          <span>{readingTime(`${featured.title}${featured.excerpt || ''}`)} 分钟阅读</span>
          <span>{featured.view_count || 0} 次浏览</span>
          <a href={`/article/${featured.slug}`}>继续阅读 <b>↗</b></a>
        </div>
      </div>
    </article>
  )}

  <section id="latest" class="home-latest">
    <header class="section-heading">
      <div><span class="section-number">02</span><div><p>Latest notes</p><h2>最近更新</h2></div></div>
      <a href="/archive">查看全部 <span>↗</span></a>
    </header>

    <div class="home-post-grid">
      {regularArticles.map((post, index) => (
        <article class:list={['home-post', index === 0 && 'is-wide']}>
          <a href={`/article/${post.slug}`} class="home-post-cover">
            <img src={covers[(index + 1) % covers.length]} alt="" loading="lazy" decoding="async" />
            <span>{String(index + 1).padStart(2, '0')}</span>
          </a>
          <div class="home-post-body">
            <p class="article-kicker"><span>{post.category_name || '随笔'}</span><time>{formatDate(post.published_at || post.created_at)}</time></p>
            <h3><a href={`/article/${post.slug}`}>{post.title}</a></h3>
            {post.excerpt && <p class="article-excerpt">{post.excerpt}</p>}
            <div class="article-footer">
              <span>{readingTime(`${post.title}${post.excerpt || ''}`)} 分钟</span>
              <span>{post.view_count || 0} 浏览 · {post.comment_count || 0} 评论</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    {articles.length === 0 && (
      <div class="home-empty">
        <span>空白页</span>
        <h2>第一篇故事还在路上</h2>
        <p>从一个念头开始，把它写下来。</p>
        <a href="/admin/write">开始写作</a>
      </div>
    )}
  </section>

  <script>
    const HISTORY_KEY = 'boke-reading-history-v1'
    const BOOKMARK_KEY = 'boke-article-bookmarks-v1'
    const historySection = document.getElementById('home-reading-history')
    const historyList = document.getElementById('home-reading-history-list')
    const bookmarkSection = document.getElementById('home-bookmarks')
    const bookmarkList = document.getElementById('home-bookmark-list')
    const escapeHistoryHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[character] || character)

    function renderReadingHistory() {
      if (!historySection || !historyList) return
      let history: any[] = []
      try {
        const value = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]')
        history = Array.isArray(value) ? value.slice(0, 4) : []
      } catch {
        history = []
      }
      historySection.hidden = history.length === 0
      historyList.innerHTML = history.map((item) => {
        const progress = Math.max(0, Math.min(100, Math.round(Number(item.progress || 0) * 100)))
        const status = item.completed ? '已读完' : `${progress}%`
        return `<a href="/article/${encodeURIComponent(String(item.slug || ''))}">
          <span class="home-reading-index">${item.completed ? '✓' : String(progress).padStart(2, '0')}</span>
          <span class="home-reading-copy"><strong>${escapeHistoryHtml(item.title || '未命名文章')}</strong><small>${item.completed ? '再次阅读' : progress > 0 ? '继续上次的位置' : '开始阅读'}</small></span>
          <span class="home-reading-state"><b>${escapeHistoryHtml(status)}</b><i style="--reading-value:${progress}%"></i></span>
        </a>`
      }).join('')
    }

    function renderBookmarks() {
      if (!bookmarkSection || !bookmarkList) return
      let bookmarks: any[] = []
      try {
        const value = JSON.parse(localStorage.getItem(BOOKMARK_KEY) || '[]')
        bookmarks = Array.isArray(value) ? value.slice(0, 6) : []
      } catch {
        bookmarks = []
      }
      bookmarkSection.hidden = bookmarks.length === 0
      bookmarkList.innerHTML = bookmarks.map((item, index) => `
        <a href="/article/${encodeURIComponent(String(item.slug || ''))}">
          <span>${String(index + 1).padStart(2, '0')}</span>
          <strong>${escapeHistoryHtml(item.title || '未命名文章')}</strong>
          <small>打开收藏 ↗</small>
        </a>
      `).join('')
    }

    document.getElementById('clear-reading-history')?.addEventListener('click', () => {
      try { localStorage.removeItem(HISTORY_KEY) } catch {}
      renderReadingHistory()
    })
    document.getElementById('clear-bookmarks')?.addEventListener('click', () => {
      try { localStorage.removeItem(BOOKMARK_KEY) } catch {}
      renderBookmarks()
    })
    document.getElementById('random-article')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement
      if (button.disabled) return
      button.disabled = true
      const small = button.querySelector('small')
      const previous = small?.textContent || ''
      if (small) small.textContent = '正在寻找…'
      try {
        const response = await fetch('/api/articles/random', { cache: 'no-store' })
        const json = await response.json().catch(() => ({}))
        if (!response.ok || !json.data?.slug) throw new Error(json.message || '暂时没有文章')
        location.href = `/article/${encodeURIComponent(json.data.slug)}`
      } catch (error) {
        if (small) small.textContent = error instanceof Error ? error.message : '读取失败'
        window.setTimeout(() => { if (small) small.textContent = previous }, 1800)
        button.disabled = false
      }
    })
    renderReadingHistory()
    renderBookmarks()
  </script>
</BaseLayout>
