---
import BaseLayout from '@layouts/BaseLayout.astro'
import BaseCard from '@components/BaseCard.astro'
import { formatDate, getActivePlugins, getArticle, getPublicSettings } from '@/lib/api'
import { buildArticleFontCss, fontFamilyStyle, injectHeadingIds } from '@/lib/markdown'

const { slug } = Astro.params
const [article, publicSettings, activePlugins] = await Promise.all([
  slug ? getArticle(slug) : Promise.resolve(null),
  getPublicSettings(),
  getActivePlugins(),
])

if (!article) {
  return Astro.redirect('/404')
}

const renderedArticle = injectHeadingIds(article.content_html || article.excerpt || '')
const articleHtml = renderedArticle.html
const toc = renderedArticle.toc
const isEpubNovel = String(article.content || '').includes('<!-- boke:epub-novel -->')
const novelChapterCount = isEpubNovel ? toc.filter((item) => item.level === 2).length : 0
const fontFaces = buildArticleFontCss(article, Array.isArray(publicSettings.font_library) ? publicSettings.font_library : [])
const titleFontStyle = fontFamilyStyle(article.title_font_family, 'var(--font-title)')
const bodyFontStyle = fontFamilyStyle(article.body_font_family, 'var(--font-body)')
const commentsEnabled = publicSettings.enable_comments !== false
const pluginIds = new Set(activePlugins.map((plugin) => plugin.id))
const readingProgressEnabled = pluginIds.has('reading-progress')
const wordCountEnabled = pluginIds.has('word-count')
const backToTopEnabled = pluginIds.has('back-to-top')
const articleLikeEnabled = pluginIds.has('article-like')
const readingHistoryEnabled = pluginIds.has('reading-history')
const tableOfContentsEnabled = pluginIds.has('table-of-contents')
const showTableOfContents = toc.length > 0 && (isEpubNovel || tableOfContentsEnabled)
const articleBookmarkEnabled = pluginIds.has('article-bookmark')
const readingModeEnabled = pluginIds.has('reading-mode')
const codeCopyEnabled = pluginIds.has('code-copy')
const articleText = String(article.content || article.content_html || '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/&[a-z0-9#]+;/gi, ' ')
  .replace(/\s+/g, '')
const articleWordCount = articleText.length
const articleReadingMinutes = Math.max(1, Math.ceil(articleWordCount / 320))
const apiBase = import.meta.env.PUBLIC_API_BASE || '/api'
const articleUrl = new URL(Astro.url.pathname, Astro.url.origin).href
const articleImage = article.cover_image || (Array.isArray(publicSettings.banner_images) ? publicSettings.banner_images[0] : '/home.webp')
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.excerpt || '',
  image: new URL(articleImage || '/home.webp', Astro.url.origin).href,
  datePublished: article.published_at || article.created_at,
  dateModified: article.updated_at || article.published_at || article.created_at,
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Person', name: publicSettings.profile_name || publicSettings.site_title || '博主' },
}).replace(/</g, '\\u003c')
---

<BaseLayout
  title={article.title}
  subtitle={article.excerpt || ''}
  showSidebar={false}
  image={articleImage}
  pageType="article"
  publishedTime={article.published_at || article.created_at}
  wide={true}
>
  <script is:inline type="application/ld+json" set:html={structuredData}></script>
  {fontFaces && <style set:html={fontFaces} />}
  {readingProgressEnabled && (
    <div class="article-reading-progress" aria-hidden="true">
      <span id="article-reading-progress-bar"></span>
    </div>
  )}

  <div class:list={['article-reading-layout', isEpubNovel && 'is-epub-novel']}>
    <div class="article-reading-main">
      {readingHistoryEnabled && (
        <section id="reading-resume-card" class="reading-resume-card" hidden aria-live="polite">
          <div>
            <small>CONTINUE READING</small>
            <strong>继续上次的阅读位置？</strong>
            <span id="reading-resume-status"></span>
          </div>
          <div>
            <button id="reading-resume-dismiss" type="button">忽略</button>
            <button id="reading-resume-action" type="button">继续阅读</button>
          </div>
        </section>
      )}
      <BaseCard class={`article-content-card p-6 md:p-10${isEpubNovel ? ' epub-novel-card' : ''}`}>
        <header class="article-content-head mb-10 border-b border-base-content/10 pb-8 text-center">
          <div class="mb-4 flex flex-wrap justify-center gap-2">
            {article.category_name && <span class="badge badge-primary badge-outline">{article.category_name}</span>}
            {article.series_title && <a class="badge badge-secondary badge-outline" href={`/series/${article.series_slug}`}>{isEpubNovel ? '书籍' : '专题'} · {article.series_title}</a>}
            {isEpubNovel && <span class="badge badge-primary badge-outline">EPUB · {novelChapterCount} 章</span>}
            <span class="badge badge-ghost">{formatDate(article.published_at || article.created_at)}</span>
          </div>
          <h1 class="mx-auto max-w-3xl text-4xl font-black leading-tight md:text-5xl" style={titleFontStyle}>{article.title}</h1>
          <p class="mt-4 text-sm text-base-content/50">
            {article.view_count || 0} 阅读 · {article.comment_count || 0} 评论
            {articleLikeEnabled && <> · <span data-like-count>{article.like_count || 0}</span> 喜欢</>}
            {wordCountEnabled && <> · <span data-reading-stats>{articleWordCount} 字 · 约 {articleReadingMinutes} 分钟</span></>}
          </p>
        </header>

        {article.series_title && article.series_articles?.length ? (
          <aside class="article-series-progress">
            <div><small>{isEpubNovel ? 'BOOK VOLUMES' : 'ARTICLE SERIES'}</small><strong>{article.series_title}</strong><span>第 {article.series_position || 1} / {article.series_articles.length} {isEpubNovel ? '卷' : '篇'}</span></div>
            <ol>
              {article.series_articles.map((item, index) => (
                <li class:list={[item.id === article.id && 'is-current']}><a href={`/article/${item.slug}`}><span>{index + 1}</span>{item.title}</a></li>
              ))}
            </ol>
            <i style={`--series-progress:${Math.round(((article.series_position || 1) / article.series_articles.length) * 100)}%`}></i>
          </aside>
        ) : null}

        {article.music_track_id && (
          <button class="article-music-binding" type="button" data-article-music={article.music_track_id}>
            <span>♪</span><div><small>这篇文章的背景音乐</small><strong>{article.music_title || '播放关联音乐'} · {article.music_artist || '未知歌手'}</strong></div><b>播放</b>
          </button>
        )}

        <article class:list={['markdown-body prose prose-lg max-w-none', isEpubNovel && 'epub-novel-body']} style={bodyFontStyle} set:html={articleHtml} />
      </BaseCard>

      {(Boolean(article.previous) || Boolean(article.next) || (article.related?.length ?? 0) > 0) && (
        <section class="article-discovery" aria-label="继续阅读">
          {(article.previous || article.next) && (
            <div class="article-neighbors">
              {article.previous ? (
                <a href={`/article/${article.previous.slug}`}>
                  <span>← {isEpubNovel && article.series_title ? '上一卷' : '上一篇'}</span><strong>{article.previous.title}</strong>
                </a>
              ) : <div></div>}
              {article.next && (
                <a class="is-next" href={`/article/${article.next.slug}`}>
                  <span>{isEpubNovel && article.series_title ? '下一卷' : '下一篇'} →</span><strong>{article.next.title}</strong>
                </a>
              )}
            </div>
          )}
          {article.related?.length ? (
            <div class="article-related">
              <header><div><p>KEEP READING</p><h2>相关推荐</h2></div><span>{article.related.length} 篇</span></header>
              <div>
                {article.related.map((post, index) => (
                  <a href={`/article/${post.slug}`}>
                    <small>{String(index + 1).padStart(2, '0')}</small>
                    <strong>{post.title}</strong>
                    <span>{post.category_name || '文章'} · {post.view_count || 0} 阅读</span>
                  </a>
                ))}
              </div>
            </div>
          ) : null}
        </section>
      )}

    </div>

    <aside class:list={['article-reading-side', showTableOfContents && 'has-toc']} aria-label="文章侧栏">
      {showTableOfContents ? (
        <BaseCard class="article-toc-card p-5">
          <h2>{isEpubNovel ? `本卷目录 · ${novelChapterCount} 章` : '文章目录'}</h2>
          <nav aria-label="文章目录">
            {toc.map((item) => (
              <a class={`article-toc-link level-${item.level}`} href={`#${item.id}`}>{item.text}</a>
            ))}
          </nav>
        </BaseCard>
      ) : null}

      <div class="article-action-wrap">
        <div class="article-action-dock" aria-label="文章操作">
          <button id="comment-button" type="button" title="查看评论" aria-label={`查看评论，共 ${article.comment_count || 0} 条`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 9.2 9.2 0 0 1-3.3-.6L4 20l1.5-4A7.4 7.4 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z"></path><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"></path></svg>
            <span>评论</span><small data-comment-count>{article.comment_count || 0}</small>
          </button>
          {articleLikeEnabled && (
            <button id="like-button" type="button" title="喜欢这篇文章" aria-label={`点赞，共 ${article.like_count || 0} 次`} aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.8a5.5 5.5 0 0 0-7.8 0L12 5.9l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.4a5.5 5.5 0 0 0 0-7.8Z"></path></svg>
              <span>喜欢</span><small data-like-count>{article.like_count || 0}</small>
            </button>
          )}
          {articleBookmarkEnabled && (
            <button id="bookmark-button" type="button" title="收藏文章" aria-label="收藏文章" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.8A1.8 1.8 0 0 1 7.8 3h8.4A1.8 1.8 0 0 1 18 4.8V21l-6-3.6L6 21V4.8Z"></path></svg>
              <span>收藏</span>
            </button>
          )}
          <button id="share-button" type="button" title="分享文章" aria-label="分享文章">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path></svg>
            <span>分享</span>
          </button>
          {readingModeEnabled && (
            <button id="reading-settings-button" type="button" title="阅读设置" aria-label="打开阅读设置">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M9 18h6"></path><circle cx="8" cy="6" r="1.5"></circle><circle cx="15" cy="12" r="1.5"></circle><circle cx="12" cy="18" r="1.5"></circle></svg>
              <span>阅读</span>
            </button>
          )}
          {backToTopEnabled && (
            <button id="back-top-button" type="button" title="回到顶部" aria-label="回到顶部">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 10 6-6 6 6M12 4v16"></path></svg>
              <span>顶部</span>{readingProgressEnabled && <small id="reading-percent">0</small>}
            </button>
          )}
        </div>
      </div>
    </aside>
  </div>

  {readingModeEnabled && (
    <dialog id="reading-settings-dialog" class="reading-settings-dialog" aria-labelledby="reading-settings-title">
      <form method="dialog" class="reading-settings-panel">
        <header>
          <div><small>READING MODE</small><h2 id="reading-settings-title">阅读设置</h2></div>
          <button value="close" aria-label="关闭阅读设置" title="关闭">×</button>
        </header>
        <label class="reading-range-control">
          <span><b>正文字号</b><output id="reading-font-output">18px</output></span>
          <input id="reading-font-size" type="range" min="16" max="24" step="1" value="18" />
        </label>
        <fieldset>
          <legend>行间距</legend>
          <div class="reading-segmented" id="reading-line-height">
            <button type="button" data-value="1.65">紧凑</button>
            <button type="button" data-value="1.85">舒适</button>
            <button type="button" data-value="2.05">宽松</button>
          </div>
        </fieldset>
        <fieldset>
          <legend>正文宽度</legend>
          <div class="reading-segmented" id="reading-content-width">
            <button type="button" data-value="760">专注</button>
            <button type="button" data-value="900">标准</button>
            <button type="button" data-value="1040">宽屏</button>
          </div>
        </fieldset>
        <label class="reading-focus-toggle"><span><b>专注模式</b><small>隐藏横幅与页脚，只保留文章</small></span><input id="reading-focus-mode" type="checkbox" /></label>
        <footer><button id="reset-reading-settings" type="button">恢复默认</button><button value="close">完成</button></footer>
      </form>
    </dialog>
  )}

  <dialog id="comment-dialog" class="article-comment-dialog" aria-labelledby="comment-dialog-title">
    <div class="article-comment-panel">
      <header class="article-comment-head">
        <div>
          <p>DISCUSSION</p>
          <h2 id="comment-dialog-title">评论 <span data-comment-count>{article.comment_count || 0}</span></h2>
        </div>
        <div class="article-comment-head-actions">
          <button id="reload-comments" type="button" data-article-id={article.id} title="刷新评论" aria-label="刷新评论">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6v5h-5"></path><path d="M18.2 15.8A7 7 0 1 1 19 9l1 2"></path></svg>
          </button>
          <button id="close-comments" type="button" title="关闭评论" aria-label="关闭评论">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
          </button>
        </div>
      </header>

      <div class="article-comment-scroll">
        <div id="comments-list" class="article-comment-list"></div>
        {commentsEnabled ? (
          <form id="comment-form" class="article-comment-form" data-article-id={article.id}>
            <input name="parent_id" type="hidden" value="" />
            <div class="article-comment-form-title">
              <h3>留下你的想法</h3>
              <p>友善交流，认真表达。</p>
            </div>
            <div id="comment-reply-context" class="article-comment-reply-context" hidden>
              <p>正在回复 <strong id="comment-reply-name"></strong></p>
              <button id="cancel-comment-reply" type="button">取消回复</button>
            </div>
            <div class="article-comment-fields">
              <label><span>昵称 *</span><input name="author_name" maxlength="40" placeholder="怎么称呼你" required /></label>
              <label><span>邮箱</span><input name="author_email" type="email" maxlength="120" placeholder="不会公开，可选" /></label>
            </div>
            <label><span>个人网站</span><input name="author_url" maxlength="200" placeholder="https://，可选" /></label>
            <label><span>评论内容 *</span><textarea name="content" maxlength="2000" placeholder="写下你的评论…" required></textarea></label>
            <div class="article-comment-submit">
              <p id="comment-message" aria-live="polite"></p>
              <button type="submit">发布评论 <span>↗</span></button>
            </div>
          </form>
        ) : (
          <p class="article-comments-disabled">站点当前已关闭评论提交。</p>
        )}
      </div>
    </div>
  </dialog>

  <div id="interaction-message" class="article-interaction-toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <script is:inline define:vars={{
    apiBase,
    serverArticleId: article.id,
    serverArticleSlug: article.slug,
    serverArticleTitle: article.title,
    serverLikeCount: article.like_count || 0,
    readingProgressEnabled,
    readingHistoryEnabled,
    articleBookmarkEnabled,
    readingModeEnabled,
    codeCopyEnabled,
  }}>
    const articleId = Number(serverArticleId)
    const commentsList = document.getElementById('comments-list')
    const commentMessage = document.getElementById('comment-message')
    const interactionMessage = document.getElementById('interaction-message')
    const commentDialog = document.getElementById('comment-dialog')
    const commentButton = document.getElementById('comment-button')
    const commentForm = document.getElementById('comment-form')
    const replyContext = document.getElementById('comment-reply-context')
    const replyName = document.getElementById('comment-reply-name')
    const likeButton = document.getElementById('like-button')
    const bookmarkButton = document.getElementById('bookmark-button')
    const readingSettingsButton = document.getElementById('reading-settings-button')
    const readingSettingsDialog = document.getElementById('reading-settings-dialog')
    const progressRoot = document.querySelector('.article-reading-progress')
    const progressBar = document.getElementById('article-reading-progress-bar')
    const readingPercent = document.getElementById('reading-percent')
    const articleBody = document.querySelector('.markdown-body')
    const resumeCard = document.getElementById('reading-resume-card')
    const resumeStatus = document.getElementById('reading-resume-status')
    const HISTORY_KEY = 'boke-reading-history-v1'
    const LIKED_KEY = 'boke-liked-articles-v1'
    const BOOKMARK_KEY = 'boke-article-bookmarks-v1'
    const READING_PREFS_KEY = 'boke-reading-preferences-v1'
    let interactionTimer
    let readingSaveTimer
    let savedReadingEntry = null
    let commentsLoaded = false

    document.querySelector('[data-article-music]')?.addEventListener('click', (event) => {
      const trackId = Number(event.currentTarget?.dataset.articleMusic || 0)
      if (trackId) window.dispatchEvent(new CustomEvent('boke:play-track', { detail: { trackId } }))
    })

    // 脱离带 transform 动画的页面容器，确保 fixed 进度条以浏览器窗口为定位基准。
    if (progressRoot && progressRoot.parentElement !== document.body) document.body.append(progressRoot)
    if (interactionMessage && interactionMessage.parentElement !== document.body) document.body.append(interactionMessage)

    function escapeHtml(value) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }
      return String(value ?? '').replace(/[&<>"']/g, (char) => map[char] || char)
    }

    function showInteractionMessage(message, tone = 'success') {
      if (!interactionMessage) return
      interactionMessage.textContent = message || ''
      interactionMessage.dataset.tone = tone
      interactionMessage.classList.toggle('is-visible', Boolean(message))
      window.clearTimeout(interactionTimer)
      if (message) interactionTimer = window.setTimeout(() => {
        interactionMessage.classList.remove('is-visible')
        window.setTimeout(() => { interactionMessage.textContent = '' }, 180)
      }, 2600)
    }

    function readLocalJson(key, fallback) {
      try {
        const value = JSON.parse(localStorage.getItem(key) || '')
        return value ?? fallback
      } catch {
        return fallback
      }
    }

    function writeLocalJson(key, value) {
      try {
        localStorage.setItem(key, JSON.stringify(value))
      } catch {
        // 阅读与点赞仍可使用，只是不在当前浏览器持久化。
      }
    }

    async function copyText(value) {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value)
        return
      }
      const field = document.createElement('textarea')
      field.value = value
      field.setAttribute('readonly', '')
      field.style.position = 'fixed'
      field.style.opacity = '0'
      document.body.append(field)
      field.select()
      // 兼容非 HTTPS 环境；现代浏览器优先使用 Clipboard API。
      const copied = Reflect.get(document, 'execCommand').call(document, 'copy')
      field.remove()
      if (!copied) throw new Error('复制失败')
    }

    async function loadComments() {
      if (!articleId || !commentsList) return
      commentsList.innerHTML = '<div class="article-comment-loading"><span></span><p>正在载入评论…</p></div>'
      try {
        const res = await fetch(`${apiBase}/articles/${articleId}/comments?pageSize=100`, { cache: 'no-store' })
        const json = await res.json().catch(() => ({}))
        if (!res.ok || json.success === false) throw new Error(json.message || '评论读取失败')
        const comments = json.data || []
        const totalComments = Number(json.pagination?.total ?? comments.length)
        document.querySelectorAll('[data-comment-count]').forEach((element) => {
          element.textContent = String(totalComments)
        })
        commentButton?.setAttribute('aria-label', `查看评论，共 ${totalComments} 条`)
        const renderComment = (comment, depth = 0, index = 0) => `
          <article class="article-comment-item${depth ? ' is-reply' : ''}" style="--comment-depth:${Math.min(depth, 3)}">
            <div class="article-comment-avatar">${escapeHtml(String(comment.author_name || '?').slice(0, 1).toUpperCase())}</div>
            <div>
              <header>
                <strong>${escapeHtml(comment.author_name)}</strong>
                <span>${new Date(comment.created_at).toLocaleString('zh-CN')}</span>
              </header>
              <p>${escapeHtml(comment.content)}</p>
              <button class="article-comment-reply" type="button" data-reply-id="${Number(comment.id)}" data-reply-name="${escapeHtml(comment.author_name)}">回复</button>
            </div>
            <small>${String(index + 1).padStart(2, '0')}</small>
          </article>
          ${(comment.children || []).map((child, childIndex) => renderComment(child, depth + 1, childIndex)).join('')}
        `
        commentsList.innerHTML = comments.map((comment, index) => renderComment(comment, 0, index)).join('') || '<div class="article-comment-empty"><span>✦</span><strong>还没有评论</strong><p>来坐第一排，留下第一个想法。</p></div>'
        commentsLoaded = true
      } catch (error) {
        commentsList.innerHTML = `<p class="rounded-2xl bg-error/10 p-4 text-sm text-error">${escapeHtml(error instanceof Error ? error.message : '评论读取失败')}</p>`
      }
    }

    document.getElementById('comment-form')?.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!articleId) return
      const form = event.currentTarget
      const data = new FormData(form)
      const submitButton = form.querySelector('button[type="submit"]')
      const savedIdentity = {
        author_name: String(data.get('author_name') || ''),
        author_email: String(data.get('author_email') || ''),
        author_url: String(data.get('author_url') || ''),
      }
      if (commentMessage) commentMessage.textContent = '正在提交...'
      if (submitButton) { submitButton.disabled = true; submitButton.setAttribute('aria-busy', 'true') }
      try {
        const res = await fetch(`${apiBase}/articles/${articleId}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(data.entries())),
        })
        const responseText = await res.text()
        let json = {}
        try { json = responseText ? JSON.parse(responseText) : {} } catch { json = {} }
        if (!res.ok || json.success === false) {
          const message = json.message || `评论提交失败（HTTP ${res.status}）`
          if (commentMessage) commentMessage.textContent = message
          showInteractionMessage(message, 'error')
          return
        }
        const message = json.message || '评论已提交'
        if (commentMessage) commentMessage.textContent = message
        showInteractionMessage(message)
        if (json.success) {
          form.reset()
          Object.entries(savedIdentity).forEach(([name, value]) => { const field = form.elements.namedItem(name); if (field) field.value = value })
          clearReply()
          if (json.data?.status === 'approved') await loadComments()
        }
      } catch (error) {
        const message = error instanceof Error ? error.message : '网络异常，评论提交失败'
        if (commentMessage) commentMessage.textContent = message
        showInteractionMessage(message, 'error')
      } finally {
        if (submitButton) { submitButton.disabled = false; submitButton.removeAttribute('aria-busy') }
      }
    })

    function clearReply() {
      const parentField = commentForm?.elements?.namedItem('parent_id')
      if (parentField) parentField.value = ''
      if (replyContext) replyContext.hidden = true
      if (replyName) replyName.textContent = ''
    }

    commentsList?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-reply-id]')
      if (!button || !commentForm) return
      const parentField = commentForm.elements.namedItem('parent_id')
      if (parentField) parentField.value = button.dataset.replyId || ''
      if (replyName) replyName.textContent = button.dataset.replyName || ''
      if (replyContext) replyContext.hidden = false
      commentForm.scrollIntoView({ behavior: 'smooth', block: 'start' })
      commentForm.elements.namedItem('content')?.focus()
    })
    document.getElementById('cancel-comment-reply')?.addEventListener('click', clearReply)

    function getLikedArticles() {
      return new Set(readLocalJson(LIKED_KEY, []).map(String))
    }

    function setLikeState(liked, count = Number(serverLikeCount || 0)) {
      if (!likeButton) return
      likeButton.classList.toggle('is-liked', liked)
      likeButton.setAttribute('aria-pressed', String(liked))
      likeButton.setAttribute('aria-label', `${liked ? '已点赞' : '点赞'}，共 ${count} 次`)
      document.querySelectorAll('[data-like-count]').forEach((element) => {
        element.textContent = String(count)
      })
    }

    if (likeButton) {
      setLikeState(getLikedArticles().has(String(articleId)), Number(serverLikeCount || 0))
      likeButton.addEventListener('click', async () => {
        if (likeButton.disabled) return
        likeButton.disabled = true
        try {
          const res = await fetch(`${apiBase}/articles/${articleId}/like`, { method: 'POST' })
          const json = await res.json().catch(() => ({}))
          if (!res.ok || json.success === false) throw new Error(json.message || '点赞失败')
          const liked = getLikedArticles()
          liked.add(String(articleId))
          writeLocalJson(LIKED_KEY, [...liked])
          setLikeState(true, Number(json.data?.like_count ?? serverLikeCount ?? 0))
          showInteractionMessage(json.message || '谢谢你的喜欢')
        } catch (error) {
          showInteractionMessage(error instanceof Error ? error.message : '点赞失败', 'error')
        } finally {
          likeButton.disabled = false
        }
      })
    }

    function getBookmarks() {
      const bookmarks = readLocalJson(BOOKMARK_KEY, [])
      return Array.isArray(bookmarks) ? bookmarks : []
    }

    function setBookmarkState(bookmarked) {
      if (!bookmarkButton) return
      bookmarkButton.classList.toggle('is-bookmarked', bookmarked)
      bookmarkButton.setAttribute('aria-pressed', String(bookmarked))
      bookmarkButton.setAttribute('aria-label', bookmarked ? '取消收藏文章' : '收藏文章')
      const label = bookmarkButton.querySelector('span')
      if (label) label.textContent = bookmarked ? '已藏' : '收藏'
    }

    if (articleBookmarkEnabled && bookmarkButton) {
      setBookmarkState(getBookmarks().some((item) => String(item.id) === String(articleId)))
      bookmarkButton.addEventListener('click', () => {
        const bookmarks = getBookmarks()
        const index = bookmarks.findIndex((item) => String(item.id) === String(articleId))
        if (index >= 0) {
          bookmarks.splice(index, 1)
          setBookmarkState(false)
          showInteractionMessage('已取消收藏')
        } else {
          bookmarks.unshift({
            id: articleId,
            slug: String(serverArticleSlug),
            title: String(serverArticleTitle),
            savedAt: Date.now(),
          })
          setBookmarkState(true)
          showInteractionMessage('已加入收藏')
        }
        writeLocalJson(BOOKMARK_KEY, bookmarks.slice(0, 50))
      })
    }

    const defaultReadingPreferences = { fontSize: 18, lineHeight: 1.85, width: 900, focus: false }
    const readingFontInput = document.getElementById('reading-font-size')
    const readingFontOutput = document.getElementById('reading-font-output')
    const readingFocusInput = document.getElementById('reading-focus-mode')
    const articleCard = document.querySelector('.article-content-card')
    let readingPreferences = { ...defaultReadingPreferences, ...readLocalJson(READING_PREFS_KEY, {}) }

    function normalizeReadingPreferences(value) {
      const fontSize = Math.max(16, Math.min(24, Number(value.fontSize) || defaultReadingPreferences.fontSize))
      const lineHeight = [1.65, 1.85, 2.05].includes(Number(value.lineHeight)) ? Number(value.lineHeight) : defaultReadingPreferences.lineHeight
      const width = [760, 900, 1040].includes(Number(value.width)) ? Number(value.width) : defaultReadingPreferences.width
      return { fontSize, lineHeight, width, focus: Boolean(value.focus) }
    }

    function applyReadingPreferences(nextPreferences, persist = false) {
      readingPreferences = normalizeReadingPreferences(nextPreferences)
      if (articleBody) {
        articleBody.style.fontSize = `${readingPreferences.fontSize}px`
        articleBody.style.lineHeight = String(readingPreferences.lineHeight)
      }
      if (articleCard) {
        articleCard.style.maxWidth = `${readingPreferences.width}px`
        articleCard.style.marginInline = 'auto'
      }
      document.body.classList.toggle('article-focus-mode', readingPreferences.focus)
      if (readingFontInput) readingFontInput.value = String(readingPreferences.fontSize)
      if (readingFontOutput) readingFontOutput.textContent = `${readingPreferences.fontSize}px`
      if (readingFocusInput) readingFocusInput.checked = readingPreferences.focus
      document.querySelectorAll('#reading-line-height [data-value]').forEach((button) => {
        button.classList.toggle('is-active', Number(button.dataset.value) === readingPreferences.lineHeight)
      })
      document.querySelectorAll('#reading-content-width [data-value]').forEach((button) => {
        button.classList.toggle('is-active', Number(button.dataset.value) === readingPreferences.width)
      })
      if (persist) writeLocalJson(READING_PREFS_KEY, readingPreferences)
    }

    if (readingModeEnabled) {
      applyReadingPreferences(readingPreferences)
      readingSettingsButton?.addEventListener('click', () => readingSettingsDialog?.showModal())
      readingFontInput?.addEventListener('input', () => applyReadingPreferences({ ...readingPreferences, fontSize: Number(readingFontInput.value) }, true))
      document.querySelectorAll('#reading-line-height [data-value]').forEach((button) => {
        button.addEventListener('click', () => applyReadingPreferences({ ...readingPreferences, lineHeight: Number(button.dataset.value) }, true))
      })
      document.querySelectorAll('#reading-content-width [data-value]').forEach((button) => {
        button.addEventListener('click', () => applyReadingPreferences({ ...readingPreferences, width: Number(button.dataset.value) }, true))
      })
      readingFocusInput?.addEventListener('change', () => applyReadingPreferences({ ...readingPreferences, focus: readingFocusInput.checked }, true))
      document.getElementById('reset-reading-settings')?.addEventListener('click', () => applyReadingPreferences(defaultReadingPreferences, true))
    }

    function getArticleReadingProgress() {
      if (!articleBody) return 0
      const start = articleBody.getBoundingClientRect().top + window.scrollY - 120
      const distance = Math.max(1, articleBody.offsetHeight - window.innerHeight * 0.42)
      return Math.max(0, Math.min(1, (window.scrollY - start) / distance))
    }

    function updateReadingProgress() {
      const progress = getArticleReadingProgress()
      if (progressBar) progressBar.style.transform = `scaleX(${progress})`
      if (readingPercent) readingPercent.textContent = String(Math.round(progress * 100))
      return progress
    }

    function getReadingHistory() {
      const history = readLocalJson(HISTORY_KEY, [])
      return Array.isArray(history) ? history : []
    }

    function saveReadingHistory() {
      if (!readingHistoryEnabled || !articleBody) return
      const progress = updateReadingProgress()
      const history = getReadingHistory().filter((item) => String(item.id) !== String(articleId))
      const entry = {
        id: articleId,
        slug: String(serverArticleSlug),
        title: String(serverArticleTitle),
        progress: Math.round(progress * 1000) / 1000,
        completed: progress >= 0.92,
        updatedAt: Date.now(),
      }
      history.unshift(entry)
      writeLocalJson(HISTORY_KEY, history.slice(0, 20))
      savedReadingEntry = entry
    }

    function scheduleReadingSave() {
      updateReadingProgress()
      if (!readingHistoryEnabled) return
      window.clearTimeout(readingSaveTimer)
      readingSaveTimer = window.setTimeout(saveReadingHistory, 450)
    }

    if (readingHistoryEnabled) {
      savedReadingEntry = getReadingHistory().find((item) => String(item.id) === String(articleId)) || null
      if (savedReadingEntry && savedReadingEntry.progress >= 0.04 && savedReadingEntry.progress < 0.92 && resumeCard) {
        resumeCard.hidden = false
        if (resumeStatus) resumeStatus.textContent = `上次读到 ${Math.round(savedReadingEntry.progress * 100)}%`
      }
      document.getElementById('reading-resume-action')?.addEventListener('click', () => {
        if (!articleBody || !savedReadingEntry) return
        const start = articleBody.getBoundingClientRect().top + window.scrollY - 100
        const distance = Math.max(1, articleBody.offsetHeight - window.innerHeight * 0.42)
        window.scrollTo({ top: start + distance * savedReadingEntry.progress, behavior: 'smooth' })
        if (resumeCard) resumeCard.hidden = true
      })
      document.getElementById('reading-resume-dismiss')?.addEventListener('click', () => {
        if (resumeCard) resumeCard.hidden = true
      })
      window.addEventListener('pagehide', saveReadingHistory)
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') saveReadingHistory()
      })
    }

    commentButton?.addEventListener('click', () => {
      commentDialog?.showModal()
      document.body.classList.add('comment-dialog-open')
      if (!commentsLoaded) loadComments()
    })
    const closeCommentDialog = () => {
      commentDialog?.close()
      document.body.classList.remove('comment-dialog-open')
    }
    document.getElementById('close-comments')?.addEventListener('click', closeCommentDialog)
    commentDialog?.addEventListener('click', (event) => {
      if (event.target === commentDialog) closeCommentDialog()
    })
    commentDialog?.addEventListener('close', () => document.body.classList.remove('comment-dialog-open'))
    document.getElementById('reload-comments')?.addEventListener('click', loadComments)
    const tocLinks = Array.from(document.querySelectorAll('.article-toc-link'))
    const tocTargets = tocLinks
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1))
        return id ? { link, target: document.getElementById(id) } : null
      })
      .filter((item) => Boolean(item?.target))

    function setActiveToc() {
      if (!tocTargets.length) return
      let active = tocTargets[0]
      for (const item of tocTargets) {
        if (item.target.getBoundingClientRect().top <= 140) active = item
      }
      tocLinks.forEach((link) => link.classList.toggle('is-active', link === active.link))
    }

    document.getElementById('share-button')?.addEventListener('click', async () => {
      const shareData = { title: document.title, url: location.href }
      try {
        if (navigator.share) await navigator.share(shareData)
        else {
          await copyText(location.href)
          showInteractionMessage('链接已复制')
        }
      } catch (error) {
        showInteractionMessage(error instanceof Error && error.name === 'AbortError' ? '' : '分享失败', 'error')
      }
    })
    document.getElementById('back-top-button')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })
    window.addEventListener('scroll', () => {
      setActiveToc()
      scheduleReadingSave()
    }, { passive: true })
    setActiveToc()
    updateReadingProgress()
    if (readingHistoryEnabled && !savedReadingEntry) saveReadingHistory()

    if (codeCopyEnabled && articleBody) {
      articleBody.querySelectorAll('pre').forEach((block) => {
        if (block.dataset.copyReady) return
        block.dataset.copyReady = 'true'
        const code = block.querySelector('code')
        const languageClass = Array.from(code?.classList || []).find((name) => name.startsWith('language-'))
        const language = languageClass ? languageClass.slice(9) : 'code'
        const toolbar = document.createElement('div')
        toolbar.className = 'article-code-toolbar'
        toolbar.innerHTML = `<span>${escapeHtml(language)}</span><button type="button">复制</button>`
        toolbar.querySelector('button')?.addEventListener('click', async (event) => {
          const button = event.currentTarget
          try {
            await copyText(code?.textContent || block.textContent || '')
            button.textContent = '已复制'
            window.setTimeout(() => { button.textContent = '复制' }, 1600)
          } catch {
            button.textContent = '失败'
          }
        })
        block.prepend(toolbar)
      })
    }
  </script>
</BaseLayout>
