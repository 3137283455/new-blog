---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getNavigationLinks } from '../lib/api'
import { resolveUploadUrl, uploadBase } from '../lib/media'

const navigationLinks = await getNavigationLinks()
const links = navigationLinks.filter((item) => item.is_active !== 0 && item.is_active !== false)
const categories = Array.from(new Set(links.map((item) => item.category || '常用'))).filter(Boolean)
const apiBase = import.meta.env.PUBLIC_API_BASE || '/api'
const normalizeUrl = (url: string) => {
  const value = (url || '').trim()
  if (!value) return '#'
  if (/^(https?:|mailto:|tel:|#|\/)/i.test(value)) return value
  return `https://${value}`
}
const getHost = (url: string) => {
  try { return new URL(normalizeUrl(url)).hostname.replace(/^www\./, '') } catch { return url }
}
const getFavicon = (url: string) => {
  try {
    const target = new URL(normalizeUrl(url))
    return target.protocol.startsWith('http') ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(target.hostname)}&sz=64` : ''
  } catch { return '' }
}
---

<BaseLayout title="导航" subtitle="你的每日网络起点" showBanner={false} showSidebar={false} wide hideFooter>
  <section class="start-page" data-api-base={apiBase} data-upload-base={uploadBase}>
    <section id="recent-section" class="start-recent" hidden>
      <header><p><span></span>最近访问</p><button id="clear-recents" type="button">清除</button></header>
      <div id="recent-links" class="recent-links"></div>
    </section>

    <section class="bookmark-board">
      <header class="bookmark-toolbar">
        <div>
          <p class="bookmark-eyebrow">YOUR BOOKMARKS</p>
          <h2>常用站点 <span id="visible-count">{links.length}</span></h2>
        </div>
        <label class="bookmark-filter">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
          <input id="nav-filter" type="search" placeholder="筛选站点" autocomplete="off" />
          <kbd>/</kbd>
        </label>
        <div class="bookmark-actions">
          <label class="bookmark-sort"><span>布局</span><select id="nav-workspace"><option value="all">全部</option><option value="work">工作</option><option value="study">学习</option><option value="fun">娱乐</option></select></label>
          <label class="bookmark-sort"><span>排序</span><select id="nav-sort"><option value="original">后台顺序</option><option value="frequent">最常使用</option><option value="recent">最近访问</option></select></label>
          <button id="favorites-filter" type="button" aria-pressed="false"><span>☆</span> 收藏</button>
          <button id="density-toggle" type="button" aria-label="切换显示密度" title="切换显示密度">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect></svg>
          </button>
          <a href="/admin" title="管理导航">管理 <span>↗</span></a>
        </div>
      </header>

      <div id="nav-category-pills" class="bookmark-categories" aria-label="导航分类">
        <button class="is-active" type="button" data-nav-category="all">全部 <small>{links.length}</small></button>
        {categories.map((category) => (
          <button type="button" data-nav-category={category.toLowerCase()}>{category} <small>{links.filter((item) => (item.category || '常用') === category).length}</small></button>
        ))}
      </div>

      <div id="nav-grid" class="bookmark-grid">
        {links.map((item, index) => {
          const href = normalizeUrl(item.url)
          const avatar = resolveUploadUrl(item.avatar || '') || getFavicon(item.url)
          const category = item.category || '常用'
          const host = getHost(item.url)
          return (
            <article class="bookmark-card" data-id={String(item.id)} data-order={String(index)} data-workspace={item.workspace || 'general'} data-category={category.toLowerCase()} data-search={`${item.title} ${item.description || ''} ${category} ${host} ${item.url}`.toLowerCase()} style={`--delay:${Math.min(index, 12) * 28}ms`}>
              <a class="bookmark-card-link" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined} data-track-recent>
                <span class="bookmark-icon">
                  {avatar && <img src={avatar} alt="" loading="lazy" onerror="this.remove()" />}
                  <b>{item.icon || item.title.slice(0, 1)}</b>
                  {index < 9 && <kbd class="bookmark-hotkey" aria-label={`数字键 ${index + 1}`}>{index + 1}</kbd>}
                </span>
                <span class="bookmark-copy"><strong>{item.title}</strong><small>{item.description || host}</small></span>
                <span class="bookmark-arrow">↗</span>
              </a>
              <button class="bookmark-star" type="button" aria-label={`收藏 ${item.title}`} aria-pressed="false" title="收藏">☆</button>
              <span class="bookmark-category">{category}</span>
            </article>
          )
        })}
      </div>

      <div id="nav-empty" class="bookmark-empty" hidden>
        <span>⌕</span><strong>没有找到匹配的站点</strong><p>换个关键词或分类试试。</p>
      </div>
    </section>

    <footer class="start-footer">
      <span>按 <kbd>/</kbd> 筛选站点</span><span><kbd>Enter</kbd> 打开第一个结果</span><span>{links.length} 个站点 · 数据来自博客后台</span>
    </footer>
  </section>

  <script>
    type NavItem = { id?: number; title?: string; url?: string; description?: string; category?: string; icon?: string; avatar?: string; workspace?: string; is_active?: number | boolean }
    type RecentItem = { id: string; title: string; href: string; icon: string; visitedAt: number }
    type UsageItem = { count: number; lastVisited: number }
    const board = document.querySelector<HTMLElement>('.start-page')
    const grid = document.getElementById('nav-grid')
    const input = document.getElementById('nav-filter') as HTMLInputElement | null
    const pillsWrap = document.getElementById('nav-category-pills')
    const empty = document.getElementById('nav-empty')
    const count = document.getElementById('visible-count')
    const favoritesButton = document.getElementById('favorites-filter') as HTMLButtonElement | null
    const apiBase = board?.dataset.apiBase || '/api'
    const mediaBase = board?.dataset.uploadBase || ''
    const FAVORITES_KEY = 'boke-nav-favorites-v1'
    const RECENTS_KEY = 'boke-nav-recents-v1'
    const USAGE_KEY = 'boke-nav-usage-v1'
    const SORT_KEY = 'boke-nav-sort-v1'
    const WORKSPACE_KEY = 'boke-nav-workspace-v1'
    let activeCategory = 'all'
    let favoritesOnly = false

    const escapeHtml = (value?: string) => String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] || char))
    const normalizeUrl = (url?: string) => { const value = String(url || '').trim(); if (!value) return '#'; return /^(https?:|mailto:|tel:|#|\/)/i.test(value) ? value : `https://${value}` }
    const getHost = (url?: string) => { try { return new URL(normalizeUrl(url)).hostname.replace(/^www\./, '') } catch { return url || '' } }
    const resolveMedia = (src?: string) => src?.startsWith('/uploads/') ? `${mediaBase}${src}` : (src || '')
    const readStorage = <T,>(key: string, fallback: T): T => { try { return JSON.parse(localStorage.getItem(key) || '') as T } catch { return fallback } }
    const getFavorites = () => new Set(readStorage<string[]>(FAVORITES_KEY, []))

    function renderCard(item: NavItem, index: number) {
      const href = normalizeUrl(item.url); const host = getHost(item.url); const category = item.category || '常用'; const fallbackFavicon = href.startsWith('http') ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=64` : ''; const avatar = resolveMedia(item.avatar) || fallbackFavicon; const title = item.title || host || '未命名资源'
      const icon = `${avatar ? `<img src="${escapeHtml(avatar)}" alt="" loading="lazy" onerror="this.remove()" />` : ''}<b>${escapeHtml(item.icon || title.slice(0, 1))}</b>`
      const external = href.startsWith('http') ? ' target="_blank" rel="noopener noreferrer"' : ''
      const search = `${title} ${item.description || ''} ${category} ${host} ${item.url || ''}`.toLowerCase()
      const hotkey = index < 9 ? `<kbd class="bookmark-hotkey" aria-label="数字键 ${index + 1}">${index + 1}</kbd>` : ''
      return `<article class="bookmark-card" data-id="${escapeHtml(String(item.id || title))}" data-order="${index}" data-workspace="${escapeHtml(item.workspace || 'general')}" data-category="${escapeHtml(category.toLowerCase())}" data-search="${escapeHtml(search)}" style="--delay:${Math.min(index, 12) * 28}ms"><a class="bookmark-card-link" href="${escapeHtml(href)}"${external} data-track-recent><span class="bookmark-icon">${icon}${hotkey}</span><span class="bookmark-copy"><strong>${escapeHtml(title)}</strong><small>${escapeHtml(item.description || host)}</small></span><span class="bookmark-arrow">↗</span></a><button class="bookmark-star" type="button" aria-label="收藏 ${escapeHtml(title)}" aria-pressed="false" title="收藏">☆</button><span class="bookmark-category">${escapeHtml(category)}</span><span class="bookmark-usage" hidden></span></article>`
    }

    function getCards() { return Array.from(document.querySelectorAll<HTMLElement>('.bookmark-card')) }
    function updateFavoriteState() { const favorites = getFavorites(); getCards().forEach((card) => { const active = favorites.has(card.dataset.id || ''); const button = card.querySelector<HTMLButtonElement>('.bookmark-star'); card.classList.toggle('is-favorite', active); if (button) { button.textContent = active ? '★' : '☆'; button.setAttribute('aria-pressed', String(active)) } }) }
    function sortCards() {
      if (!grid) return
      const mode = (document.getElementById('nav-sort') as HTMLSelectElement | null)?.value || 'original'
      const usage = readStorage<Record<string, UsageItem>>(USAGE_KEY, {})
      const cards = getCards()
      cards.forEach((card) => {
        const data = usage[card.dataset.id || '']
        const badge = card.querySelector<HTMLElement>('.bookmark-usage')
        if (badge) { badge.hidden = !data?.count; badge.textContent = data?.count ? `${data.count} 次` : '' }
      })
      cards.sort((left, right) => {
        const leftUsage = usage[left.dataset.id || ''] || { count: 0, lastVisited: 0 }
        const rightUsage = usage[right.dataset.id || ''] || { count: 0, lastVisited: 0 }
        if (mode === 'frequent') return rightUsage.count - leftUsage.count || rightUsage.lastVisited - leftUsage.lastVisited || Number(left.dataset.order) - Number(right.dataset.order)
        if (mode === 'recent') return rightUsage.lastVisited - leftUsage.lastVisited || Number(left.dataset.order) - Number(right.dataset.order)
        return Number(left.dataset.order) - Number(right.dataset.order)
      }).forEach((card) => grid.append(card))
    }
    function applyFilter() {
      const keyword = input?.value.trim().toLowerCase() || ''; const favorites = getFavorites(); const workspace = (document.getElementById('nav-workspace') as HTMLSelectElement | null)?.value || 'all'; let visible = 0
      const hints: Record<string, string[]> = { work: ['work', '工作', '工具', '开发', '设计', '效率'], study: ['study', '学习', '文档', '教程', '阅读', '知识'], fun: ['fun', '娱乐', '游戏', '视频', '音乐', '社交'] }
      getCards().forEach((card) => { const explicit = card.dataset.workspace || 'general'; const inferred = hints[workspace]?.some((hint) => (card.dataset.search || '').includes(hint)); const workspaceMatch = workspace === 'all' || explicit === workspace || (explicit === 'general' && inferred); const show = workspaceMatch && (activeCategory === 'all' || card.dataset.category === activeCategory) && (!keyword || (card.dataset.search || '').includes(keyword)) && (!favoritesOnly || favorites.has(card.dataset.id || '')); card.hidden = !show; if (show) visible += 1 })
      if (count) count.textContent = String(visible)
      empty?.toggleAttribute('hidden', visible > 0)
    }
    function bindCards() {
      updateFavoriteState()
      getCards().forEach((card) => {
        if (card.dataset.bound === 'true') return
        card.dataset.bound = 'true'
        card.querySelector('.bookmark-star')?.addEventListener('click', () => { const favorites = getFavorites(); const id = card.dataset.id || ''; favorites.has(id) ? favorites.delete(id) : favorites.add(id); localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favorites])); updateFavoriteState(); applyFilter(); scheduleNavigationSync() })
        card.querySelector('[data-track-recent]')?.addEventListener('click', () => {
          const link = card.querySelector<HTMLAnchorElement>('.bookmark-card-link'); const title = card.querySelector('strong')?.textContent || ''; const icon = card.querySelector('.bookmark-icon')?.textContent?.trim() || title.slice(0, 1); const id = card.dataset.id || title; const now = Date.now()
          const recents = readStorage<RecentItem[]>(RECENTS_KEY, []).filter((item) => item.id !== id); recents.unshift({ id, title, href: link?.href || '#', icon, visitedAt: now }); localStorage.setItem(RECENTS_KEY, JSON.stringify(recents.slice(0, 6)))
          const usage = readStorage<Record<string, UsageItem>>(USAGE_KEY, {}); usage[id] = { count: (usage[id]?.count || 0) + 1, lastVisited: now }; localStorage.setItem(USAGE_KEY, JSON.stringify(usage)); renderRecents(); sortCards(); scheduleNavigationSync()
        })
      })
      sortCards()
    }
    function bindPills() { document.querySelectorAll<HTMLButtonElement>('[data-nav-category]').forEach((button) => button.addEventListener('click', () => { activeCategory = button.dataset.navCategory || 'all'; document.querySelectorAll('[data-nav-category]').forEach((item) => item.classList.toggle('is-active', item === button)); applyFilter() })) }
    function renderCategories(items: NavItem[]) { if (!pillsWrap) return; const cats = Array.from(new Set(items.map((item) => item.category || '常用'))); pillsWrap.innerHTML = `<button class="is-active" type="button" data-nav-category="all">全部 <small>${items.length}</small></button>${cats.map((category) => `<button type="button" data-nav-category="${escapeHtml(category.toLowerCase())}">${escapeHtml(category)} <small>${items.filter((item) => (item.category || '常用') === category).length}</small></button>`).join('')}`; activeCategory = 'all'; bindPills() }
    function renderRecents() { const section = document.getElementById('recent-section'); const wrap = document.getElementById('recent-links'); const recents = readStorage<RecentItem[]>(RECENTS_KEY, []); if (!section || !wrap) return; section.hidden = !recents.length; wrap.innerHTML = recents.map((item) => `<a href="${escapeHtml(item.href)}"><b>${escapeHtml(item.icon || item.title.slice(0, 1))}</b><span>${escapeHtml(item.title)}</span></a>`).join('') }

    async function refreshNavigation() {
      try { const response = await fetch(`${apiBase}/navigation`, { cache: 'no-store' }); if (!response.ok) throw new Error(); const json = await response.json(); const items = ((json.data || []) as NavItem[]).filter((item) => item?.title && item?.url && item.is_active !== 0 && item.is_active !== false); if (!grid) return; grid.innerHTML = items.map(renderCard).join(''); renderCategories(items); bindCards(); applyFilter() } catch { bindCards(); sortCards(); applyFilter() }
    }

    let syncRevision = 0
    let syncTimer = 0
    const privateDeviceToken = localStorage.getItem('boke_private_device_token') || ''
    const collectSyncState = () => ({
      favorites: readStorage<string[]>(FAVORITES_KEY, []),
      recents: readStorage<RecentItem[]>(RECENTS_KEY, []),
      usage: readStorage<Record<string, UsageItem>>(USAGE_KEY, {}),
      sort: localStorage.getItem(SORT_KEY) || 'original',
      workspace: localStorage.getItem(WORKSPACE_KEY) || 'all',
      compact: localStorage.getItem('boke-nav-compact') === 'true',
      searchMemory: readStorage<any[]>('boke-nav-search-memory-v1', []),
      searchEngine: localStorage.getItem('boke-search-engine') || 'site',
    })
    const applySyncState = (state: any) => {
      if (!state || typeof state !== 'object') return
      if (Array.isArray(state.favorites)) localStorage.setItem(FAVORITES_KEY, JSON.stringify(state.favorites))
      if (Array.isArray(state.recents)) localStorage.setItem(RECENTS_KEY, JSON.stringify(state.recents.slice(0, 6)))
      if (state.usage && typeof state.usage === 'object') localStorage.setItem(USAGE_KEY, JSON.stringify(state.usage))
      if (state.sort) localStorage.setItem(SORT_KEY, state.sort)
      if (state.workspace) localStorage.setItem(WORKSPACE_KEY, state.workspace)
      if (typeof state.compact === 'boolean') localStorage.setItem('boke-nav-compact', String(state.compact))
      if (Array.isArray(state.searchMemory)) localStorage.setItem('boke-nav-search-memory-v1', JSON.stringify(state.searchMemory.slice(0, 30)))
      if (state.searchEngine) localStorage.setItem('boke-search-engine', state.searchEngine)
    }
    const mergeSyncState = (local: any, remote: any) => {
      const recents = [...(local.recents || []), ...(remote.recents || [])].sort((a, b) => Number(b.visitedAt || 0) - Number(a.visitedAt || 0))
      const recentMap = new Map<string, any>(); recents.forEach((item) => { if (!recentMap.has(String(item.id))) recentMap.set(String(item.id), item) })
      const usage: Record<string, UsageItem> = { ...(remote.usage || {}) }
      Object.entries(local.usage || {}).forEach(([id, item]: any) => { const old = usage[id]; usage[id] = { count: Math.max(Number(old?.count || 0), Number(item?.count || 0)), lastVisited: Math.max(Number(old?.lastVisited || 0), Number(item?.lastVisited || 0)) } })
      const searches = [...(local.searchMemory || []), ...(remote.searchMemory || [])]
      const searchMap = new Map<string, any>(); searches.forEach((item) => { const key = String(item?.query || '').toLowerCase(); if (!key) return; const old = searchMap.get(key); searchMap.set(key, !old ? item : { query: item.query, count: Math.max(Number(old.count || 0), Number(item.count || 0)), lastUsed: Math.max(Number(old.lastUsed || 0), Number(item.lastUsed || 0)) }) })
      return { ...local, ...remote,
        favorites: Array.from(new Set([...(local.favorites || []), ...(remote.favorites || [])])),
        recents: Array.from(recentMap.values()).slice(0, 6), usage,
        searchMemory: Array.from(searchMap.values()).sort((a,b)=>Number(b.lastUsed||0)-Number(a.lastUsed||0)).slice(0,30),
      }
    }
    async function uploadNavigationState(force = false) {
      if (!privateDeviceToken) return
      const response = await fetch(apiBase + '/private/navigation', { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Device-Token': privateDeviceToken }, body: JSON.stringify({ state: collectSyncState(), revision: syncRevision, force }) })
      const json = await response.json().catch(() => ({}))
      if (response.status === 409 && json.data?.server) {
        const merged = mergeSyncState(collectSyncState(), json.data.server.state || {})
        applySyncState(merged); syncRevision = Number(json.data.server.revision || 0)
        return uploadNavigationState(true)
      }
      if (response.ok) syncRevision = Number(json.data?.revision || syncRevision)
    }
    function scheduleNavigationSync() {
      if (!privateDeviceToken) return
      window.clearTimeout(syncTimer)
      syncTimer = window.setTimeout(() => uploadNavigationState().catch(() => {}), 650)
    }
    async function hydrateNavigationState() {
      if (!privateDeviceToken) return
      try {
        const response = await fetch(apiBase + '/private/navigation', { headers: { 'X-Device-Token': privateDeviceToken } })
        if (!response.ok) return
        const json = await response.json(); syncRevision = Number(json.data?.revision || 0)
        const remote = json.data?.state || {}
        const merged = syncRevision ? mergeSyncState(collectSyncState(), remote) : collectSyncState()
        applySyncState(merged)
        if (syncRevision === 0) scheduleNavigationSync()
        if (navSort) navSort.value = localStorage.getItem(SORT_KEY) || 'original'
        if (navWorkspace) navWorkspace.value = localStorage.getItem(WORKSPACE_KEY) || 'all'
        grid?.classList.toggle('is-compact', localStorage.getItem('boke-nav-compact') === 'true')
        renderRecents(); updateFavoriteState(); sortCards(); applyFilter()
      } catch {}
    }
    const navSort = document.getElementById('nav-sort') as HTMLSelectElement | null
    const navWorkspace = document.getElementById('nav-workspace') as HTMLSelectElement | null
    if (navSort) navSort.value = localStorage.getItem(SORT_KEY) || 'original'
    if (navWorkspace) navWorkspace.value = localStorage.getItem(WORKSPACE_KEY) || 'all'
    renderRecents(); bindPills(); bindCards(); sortCards(); applyFilter(); refreshNavigation(); hydrateNavigationState()
    let syncFingerprint = JSON.stringify(collectSyncState())
    window.setInterval(() => { const next = JSON.stringify(collectSyncState()); if (next !== syncFingerprint) { syncFingerprint = next; scheduleNavigationSync() } }, 1800)
    window.addEventListener('pagehide', () => uploadNavigationState().catch(() => {}))
    input?.addEventListener('input', applyFilter)
    favoritesButton?.addEventListener('click', () => { favoritesOnly = !favoritesOnly; favoritesButton.classList.toggle('is-active', favoritesOnly); favoritesButton.setAttribute('aria-pressed', String(favoritesOnly)); applyFilter() })
    document.getElementById('density-toggle')?.addEventListener('click', () => { const compact = grid?.classList.toggle('is-compact') || false; localStorage.setItem('boke-nav-compact', String(compact)); scheduleNavigationSync() })
    if (localStorage.getItem('boke-nav-compact') === 'true') grid?.classList.add('is-compact')
    document.getElementById('clear-recents')?.addEventListener('click', () => { localStorage.removeItem(RECENTS_KEY); renderRecents(); scheduleNavigationSync() })
    navSort?.addEventListener('change', () => { localStorage.setItem(SORT_KEY, navSort.value); sortCards(); applyFilter(); scheduleNavigationSync() })
    navWorkspace?.addEventListener('change', () => { localStorage.setItem(WORKSPACE_KEY, navWorkspace.value); activeCategory = 'all'; document.querySelectorAll('[data-nav-category]').forEach((item, index) => item.classList.toggle('is-active', index === 0)); applyFilter(); scheduleNavigationSync() })
    document.addEventListener('keydown', (event) => { const active = document.activeElement as HTMLElement | null; const editing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(active?.tagName || ''); if (event.key === 'Escape' && editing) active?.blur(); if (event.key === '/' && !editing) { event.preventDefault(); input?.focus() } if (event.key === 'Enter' && active === input) document.querySelector<HTMLAnchorElement>('.bookmark-card:not([hidden]) .bookmark-card-link')?.click(); if (!editing && /^[1-9]$/.test(event.key)) { const card = getCards().filter((item) => !item.hidden)[Number(event.key) - 1]; card?.querySelector<HTMLAnchorElement>('.bookmark-card-link')?.click() } })
  </script>
</BaseLayout>
