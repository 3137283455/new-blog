---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getContentSourceChapter, type ContentSourceKind } from '../../../../../lib/api'

const kind = Astro.params.kind as ContentSourceKind
const source = Astro.params.source || ''
const chapterId = Astro.params.chapter || ''
const workId = Astro.url.searchParams.get('id') || ''
if (!['book', 'manga', 'bangumi'].includes(kind) || !workId) return Astro.redirect('/404')
const data = await getContentSourceChapter(kind, source, workId, chapterId)
if (!data?.reader) return Astro.redirect('/404')
const reader = data.reader
const backUrl = `/source/${encodeURIComponent(kind)}/${encodeURIComponent(source)}/${encodeURIComponent(workId)}`
const mediaUrl = (url: string) => `/api/content-sources/media?source=${encodeURIComponent(source)}&kind=${encodeURIComponent(kind)}&url=${encodeURIComponent(url)}`
---

<BaseLayout title={reader.title} subtitle={`${data.source?.label || source} · 源阅读`} showSidebar={false} showBanner={false} hideFooter wide>
  <main class:list={['source-reader-page', kind === 'manga' && 'source-reader-manga']}>
    <header class="source-reader-topbar"><a href={backUrl}>‹</a><div><small>{data.source?.label || source}</small><strong>{reader.title}</strong></div><span>{kind === 'manga' ? `${reader.pages?.length || 0} 页` : '源阅读'}</span></header>
    {kind === 'manga' && reader.pages?.length ? <section class="source-reader-pages">{reader.pages.map((url: string, index: number) => <figure><img src={mediaUrl(url)} alt={`${reader.title} 第 ${index + 1} 页`} loading={index > 1 ? 'lazy' : undefined} /><figcaption>第 {index + 1} 页</figcaption></figure>)}</section> : <article class="source-reader-content" set:html={reader.content_html || `<p>${reader.content || '源站没有返回可读内容。'}</p>`}></article>}
  </main>
</BaseLayout>

<style>
  .source-reader-page{width:min(920px,100%);min-height:calc(100vh - 6rem);margin:auto;padding:1rem 1rem 5rem;color:var(--ink)}.source-reader-topbar{position:sticky;z-index:5;top:0;display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.7rem;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface-solid) 90%,transparent);padding:.7rem .2rem;backdrop-filter:blur(16px)}.source-reader-topbar>a{color:inherit;font-size:1.8rem;text-decoration:none}.source-reader-topbar div{min-width:0}.source-reader-topbar small,.source-reader-topbar strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-reader-topbar small{color:var(--muted-ink);font-size:.55rem}.source-reader-topbar strong{font-size:.78rem}.source-reader-topbar>span{color:var(--muted-ink);font-size:.6rem}.source-reader-content{max-width:760px;margin:0 auto;padding:3rem 1rem;font-family:var(--theme-body-font),sans-serif;font-size:1.15rem;line-height:2;overflow-wrap:anywhere}.source-reader-content :global(p){margin:0 0 1.35em;text-indent:2em}.source-reader-content :global(img){display:block;max-width:100%;height:auto;margin:2rem auto}.source-reader-content :global(h1),.source-reader-content :global(h2),.source-reader-content :global(h3){margin:2em 0 1em;font-family:var(--theme-title-font);line-height:1.35}.source-reader-content :global(a){color:var(--brand)}.source-reader-pages{padding:2rem 0}.source-reader-pages figure{margin:0 auto 1rem;background:#fff;box-shadow:0 5px 20px #0002}.source-reader-pages img{display:block;width:100%;height:auto}.source-reader-pages figcaption{padding:.35rem;background:#171917;color:#fff8;text-align:center;font-size:.58rem}.source-reader-manga{width:min(1100px,100%);background:#171917;color:#edf0eb}.source-reader-manga .source-reader-topbar{background:#171917;border-color:#fff2}.source-reader-manga .source-reader-pages{max-width:980px;margin:auto}.source-reader-manga .source-reader-pages figure{margin-bottom:1rem}
  @media(max-width:600px){.source-reader-page{padding:0 0 4rem}.source-reader-topbar{padding:.65rem .75rem}.source-reader-content{padding:2rem 1rem;font-size:1rem}.source-reader-pages{padding:1rem 0}.source-reader-pages figure{box-shadow:none}}
</style>
