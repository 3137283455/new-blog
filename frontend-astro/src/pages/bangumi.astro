---
import BaseLayout from '@layouts/BaseLayout.astro'
import {
  bangumiStatusLabels,
  getBangumiDetailUrl,
  getDefaultPlaySource,
  normalizeExternalUrl,
  parseBangumiPlaySources,
} from '../lib/bangumi'
import { getBangumiItems } from '../lib/api'
import { resolveUploadUrl, uploadBase } from '../lib/media'

const items = (await getBangumiItems()).filter((item) => item.is_active !== 0 && item.is_active !== false)
const apiBase = import.meta.env.PUBLIC_API_BASE || '/api'
const watching = items.filter((item) => item.status === 'watching').length
const done = items.filter((item) => item.status === 'done').length
const scoredItems = items.filter((item) => Number(item.rating || 0) > 0)
const averageRating = scoredItems.length
  ? scoredItems.reduce((sum, item) => sum + Number(item.rating || 0), 0) / scoredItems.length
  : 0
const uniqueStatuses = Object.entries(bangumiStatusLabels)
  .filter(([status], index, rows) => rows.findIndex(([, label]) => label === bangumiStatusLabels[status]) === index)
  .map(([status, label]) => ({
    label,
    value: items.filter((item) => (item.status || 'watching') === status).length,
  }))
  .filter((item) => item.value > 0)
const seasons = Array.from(new Set(items.map((item) => item.season).filter(Boolean)))
  .slice(0, 10)
  .map((season) => ({
    label: String(season),
    value: items.filter((item) => item.season === season).length,
  }))
---

<BaseLayout
  title="追番"
  subtitle="记录正在看的番剧和喜欢的作品"
  showBanner={false}
  showSidebar={true}
  sidebarProps={{
    statItems: [
      { label: '总追番', value: items.length },
      { label: '追番中', value: watching },
      { label: '已看完', value: done },
    ],
    sidebarSections: [
      { title: '追番状态', marker: '#', tone: 'primary', items: uniqueStatuses },
      { title: '季度', marker: '◇', tone: 'secondary', items: seasons },
    ],
  }}
>
  <section class="bangumi-compact-head">
    <div>
      <p>Bangumi Collection</p>
      <h1>追番列表</h1>
    </div>
    <div class="bangumi-compact-stats">
      <span><strong>{items.length}</strong> 部作品</span>
      <span><strong>{averageRating.toFixed(1)}</strong> 平均评分</span>
    </div>
  </section>

  <section class="feature-toolbar bangumi-filterbar ryu-card" data-api-base={apiBase} data-upload-base={uploadBase}>
    <input id="bangumi-filter" class="input input-bordered rounded-xl" type="search" placeholder="搜索番剧、简介或季度..." />
    <select id="bangumi-status" class="select select-bordered rounded-xl">
      <option value="">全部状态</option>
      <option value="watching">追番中</option>
      <option value="done">已看完</option>
      <option value="plan">想看</option>
      <option value="paused">搁置</option>
      <option value="dropped">弃番</option>
    </select>
  </section>

  <section id="bangumi-grid" class="bangumi-grid bangumi-grid-compact">
    {items.map((item) => {
      const sources = parseBangumiPlaySources(item)
      const defaultSource = getDefaultPlaySource(item)
      const defaultUrl = normalizeExternalUrl(defaultSource?.url)
      const detailUrl = getBangumiDetailUrl(item)
      const encodedSources = encodeURIComponent(JSON.stringify(sources))
      return (
        <article
          class="bangumi-card bangumi-card-compact"
          data-search={`${item.title} ${item.original_title || ''} ${item.summary || ''} ${item.season || ''}`.toLowerCase()}
          data-status={item.status || 'watching'}
        >
          {defaultUrl ? (
            <a class="bangumi-card-main" href={defaultUrl} target="_blank" rel="noopener noreferrer" title={`使用默认播放源：${defaultSource?.name || '播放源'}`}>
              <div class="bangumi-cover">
                {item.cover ? <img src={resolveUploadUrl(item.cover)} alt={item.title} loading="lazy" decoding="async" /> : <span>暂无封面</span>}
                <b>{bangumiStatusLabels[item.status || 'watching'] || item.status}</b>
                {Number(item.rating || 0) > 0 && <em>★ {Number(item.rating).toFixed(1)}</em>}
                <i>▶</i>
              </div>
              <div class="bangumi-info">
                <h2 title={item.title}>{item.title}</h2>
                <p class="line-clamp-1">{item.original_title || item.season || '未标注季度'}</p>
              </div>
            </a>
          ) : (
            <div class="bangumi-card-main">
              <div class="bangumi-cover">
                {item.cover ? <img src={resolveUploadUrl(item.cover)} alt={item.title} loading="lazy" decoding="async" /> : <span>暂无封面</span>}
                <b>{bangumiStatusLabels[item.status || 'watching'] || item.status}</b>
                {Number(item.rating || 0) > 0 && <em>★ {Number(item.rating).toFixed(1)}</em>}
              </div>
              <div class="bangumi-info">
                <h2 title={item.title}>{item.title}</h2>
                <p class="line-clamp-1">{item.original_title || item.season || '未标注季度'}</p>
              </div>
            </div>
          )}
          <div class="bangumi-card-footer">
            <span><small>集数</small><strong>{Number(item.total_episodes || 0) || '未知'}</strong></span>
            {detailUrl
              ? <a href={detailUrl} target="_blank" rel="noopener noreferrer"><small>详情</small><strong>查看</strong></a>
              : <span><small>详情</small><strong>未知</strong></span>}
            {sources.length
              ? <button type="button" data-open-bangumi-sources data-title={item.title} data-sources={encodedSources}><small>播放源</small><strong>选择</strong></button>
              : <span><small>播放源</small><strong>未知</strong></span>}
          </div>
        </article>
      )
    })}
  </section>

  <div id="bangumi-empty" class={`feature-empty ${items.length ? 'hidden' : ''}`}>
    <strong>暂无追番数据</strong>
    <span>请先在后台内容中心添加并启用番剧。</span>
  </div>

  <dialog id="bangumi-play-dialog" class="bangumi-play-dialog">
    <div class="bangumi-play-dialog-panel">
      <header>
        <div>
          <p>播放源</p>
          <h2 id="bangumi-play-dialog-title">选择播放地址</h2>
        </div>
        <button id="bangumi-play-dialog-close" class="admin-dialog-close" type="button" aria-label="关闭" title="关闭">&times;</button>
      </header>
      <div id="bangumi-play-dialog-list" class="bangumi-play-dialog-list"></div>
    </div>
  </dialog>

  <script>
    import {
      bangumiStatusLabels,
      getBangumiDetailUrl,
      getDefaultPlaySource,
      normalizeExternalUrl,
      parseBangumiPlaySources,
    } from '../lib/bangumi'
    import type { BangumiItem, BangumiPlaySource } from '../lib/api'

    const toolbar = document.querySelector<HTMLElement>('.bangumi-filterbar')
    const input = document.getElementById('bangumi-filter') as HTMLInputElement | null
    const select = document.getElementById('bangumi-status') as HTMLSelectElement | null
    const grid = document.getElementById('bangumi-grid')
    const empty = document.getElementById('bangumi-empty')
    const dialog = document.getElementById('bangumi-play-dialog') as HTMLDialogElement | null
    const dialogTitle = document.getElementById('bangumi-play-dialog-title')
    const dialogList = document.getElementById('bangumi-play-dialog-list')
    const apiBase = toolbar?.dataset.apiBase || '/api'
    const clientUploadBase = toolbar?.dataset.uploadBase || ''

    function escapeHtml(value?: unknown) {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }
      return String(value ?? '').replace(/[&<>"']/g, (char) => map[char] || char)
    }

    function mediaUrl(src?: string) {
      if (!src) return ''
      return src.startsWith('/uploads/') ? `${clientUploadBase}${src}` : src
    }

    function sourcePayload(sources: BangumiPlaySource[]) {
      return encodeURIComponent(JSON.stringify(sources))
    }

    function renderCard(item: BangumiItem) {
      const sources = parseBangumiPlaySources(item)
      const defaultSource = getDefaultPlaySource(item)
      const defaultUrl = normalizeExternalUrl(defaultSource?.url)
      const detailUrl = getBangumiDetailUrl(item)
      const status = item.status || 'watching'
      const title = item.title || '未命名作品'
      const rating = Number(item.rating || 0)
      const cover = item.cover
        ? `<img src="${escapeHtml(mediaUrl(item.cover))}" alt="${escapeHtml(title)}" loading="lazy" decoding="async" />`
        : '<span>暂无封面</span>'
      const coverMarkup = `
        <div class="bangumi-cover">
          ${cover}
          <b>${escapeHtml(bangumiStatusLabels[status] || status)}</b>
          ${rating > 0 ? `<em>★ ${rating.toFixed(1)}</em>` : ''}
          ${defaultUrl ? '<i>▶</i>' : ''}
        </div>
        <div class="bangumi-info">
          <h2 title="${escapeHtml(title)}">${escapeHtml(title)}</h2>
          <p class="line-clamp-1">${escapeHtml(item.original_title || item.season || '未标注季度')}</p>
        </div>`
      const main = defaultUrl
        ? `<a class="bangumi-card-main" href="${escapeHtml(defaultUrl)}" target="_blank" rel="noopener noreferrer" title="使用默认播放源：${escapeHtml(defaultSource?.name || '播放源')}">${coverMarkup}</a>`
        : `<div class="bangumi-card-main">${coverMarkup}</div>`
      const detail = detailUrl
        ? `<a href="${escapeHtml(detailUrl)}" target="_blank" rel="noopener noreferrer"><small>详情</small><strong>查看</strong></a>`
        : '<span><small>详情</small><strong>未知</strong></span>'
      const play = sources.length
        ? `<button type="button" data-open-bangumi-sources data-title="${escapeHtml(title)}" data-sources="${escapeHtml(sourcePayload(sources))}"><small>播放源</small><strong>选择</strong></button>`
        : '<span><small>播放源</small><strong>未知</strong></span>'
      const search = `${title} ${item.original_title || ''} ${item.summary || ''} ${item.season || ''}`.toLowerCase()
      return `
        <article class="bangumi-card bangumi-card-compact" data-search="${escapeHtml(search)}" data-status="${escapeHtml(status)}">
          ${main}
          <div class="bangumi-card-footer">
            <span><small>集数</small><strong>${Number(item.total_episodes || 0) || '未知'}</strong></span>
            ${detail}
            ${play}
          </div>
        </article>`
    }

    function cards() {
      return Array.from(document.querySelectorAll<HTMLElement>('.bangumi-card'))
    }

    function filterCards() {
      const keyword = input?.value.trim().toLowerCase() || ''
      const status = select?.value || ''
      let visible = 0
      cards().forEach((card) => {
        const matched = (!keyword || (card.dataset.search || '').includes(keyword))
          && (!status || card.dataset.status === status)
        card.style.display = matched ? '' : 'none'
        if (matched) visible += 1
      })
      if (!empty) return
      empty.classList.toggle('hidden', visible > 0)
      if (!visible) {
        empty.innerHTML = cards().length
          ? '<strong>没有匹配的番剧</strong><span>换个关键词或状态再试。</span>'
          : '<strong>暂无追番数据</strong><span>请先在后台内容中心添加并启用番剧。</span>'
      }
    }

    function openSources(button: HTMLElement) {
      if (!dialog || !dialogList) return
      let sources: BangumiPlaySource[] = []
      try {
        sources = JSON.parse(decodeURIComponent(button.dataset.sources || '[]'))
      } catch {
        sources = []
      }
      dialogTitle && (dialogTitle.textContent = button.dataset.title || '选择播放地址')
      dialogList.innerHTML = sources.map((source) => {
        const url = normalizeExternalUrl(source.url)
        return `
          <a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">
            <span>
              <strong>${escapeHtml(source.name || '播放源')}</strong>
              ${source.is_default ? '<b>默认</b>' : ''}
              ${source.remark ? `<small>${escapeHtml(source.remark)}</small>` : ''}
            </span>
            <code>${escapeHtml(url)}</code>
            <i>↗</i>
          </a>`
      }).join('')
      dialog.showModal()
    }

    async function refresh() {
      try {
        const response = await fetch(`${apiBase}/bangumi`, { cache: 'no-store' })
        if (!response.ok) throw new Error()
        const json = await response.json()
        const fresh = ((json.data || []) as BangumiItem[])
          .filter((item) => item?.title && item.is_active !== 0 && item.is_active !== false)
        if (grid) grid.innerHTML = fresh.map(renderCard).join('')
      } catch {
        if (!cards().length && empty) {
          empty.innerHTML = '<strong>追番数据读取失败</strong><span>请确认后端 API 已启动。</span>'
          empty.classList.remove('hidden')
        }
      }
      filterCards()
    }

    input?.addEventListener('input', filterCards)
    select?.addEventListener('change', filterCards)
    document.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-open-bangumi-sources]')
      if (button) openSources(button)
    })
    document.getElementById('bangumi-play-dialog-close')?.addEventListener('click', () => dialog?.close())
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
    refresh()
  </script>
</BaseLayout>
