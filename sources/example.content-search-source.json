{
  "schema": "boke-content-search-source",
  "version": 1,
  "source": {
    "id": "example-reader-source",
    "label": "示例阅读源（请修改）",
    "enabled": false,
    "kinds": ["book", "manga"],
    "api_base": "https://api.example.com",
    "page_base": "https://www.example.com",
    "page_path": "/work/{id}",
    "timeout_ms": 10000,
    "headers": {},
    "search": {
      "method": "GET",
      "path": "/search?q={query}&type={type}&limit={limit}",
      "result_path": "data.items",
      "body_type": "json"
    },
    "explore": {
      "method": "GET",
      "path": "/discover?type={type}&page={page}&limit={limit}",
      "result_path": "data.items",
      "body_type": "json"
    },
    "detail": {
      "method": "GET",
      "path": "/works/{id}",
      "result_path": "data",
      "body_type": "json"
    },
    "chapters": {
      "method": "GET",
      "path": "/works/{id}/chapters",
      "result_path": "data",
      "body_type": "json"
    },
    "reader": {
      "method": "GET",
      "path": "/chapters/{chapter_id}",
      "result_path": "data",
      "body_type": "json"
    },
    "mapping": {
      "id": "id",
      "title": ["title", "name"],
      "original_title": "original_title",
      "author": "author",
      "cover": "cover",
      "description": "description",
      "rating": "rating",
      "publication": "date",
      "type": "type",
      "total": "chapter_count"
    },
    "chapter_mapping": {
      "id": "id",
      "title": "title",
      "volume": "volume",
      "number": "number",
      "url": "url"
    },
    "reader_mapping": {
      "title": "title",
      "content_html": "content_html",
      "pages": "pages",
      "page_url": "url"
    },
    "read_mode": "auto",
    "type_values": {
      "book": "book",
      "manga": "manga"
    }
  }
}
